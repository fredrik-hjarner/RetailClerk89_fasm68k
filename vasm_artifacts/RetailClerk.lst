Source: "data_VDPInit.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; VDP initialization data
                            	     3: ; some values used are from http://www.hacking-cult.org/?r/18/30
                            	     4: ; some other values used are from http://md.squee.co/VDP
                            	     5: ; inline documentation from http://devster.monkeeh.com/sega/yavdp.html
                            	     6: ;-------------------------------------------------------------------------------
                            	     7: VDPInitDataStart:
                            	     8: 	;---------------------------------------------------------------------------
                            	     9: 	; Register 0: Mode Set Register 1 - [move.w #$80xx,($C00004)]
                            	    10: 	; bit 0 = Display Disable (0: Disabled, 1: Enabled)  
                            	    11: 	; bit 1 = HV Counter Latch Enabled (0: Disabled, 1: Enabled)
                            	    12: 	; bit 2 = Palette Select (0: 3-bit palette, 1: 9-bit palette)
                            	    13: 	; bit 3 = Not used?
                            	    14: 	; bit 4 = Horizontal Interrupt Enable (0: Disabled, 1: Enabled)
                            	    15: 	; bit 5 = Not used
                            	    16: 	; bit 6 = Not used
                            	    17: 	; bit 7 = Not used
                            	    18: 	;---------------------------------------------------------------------------
00:0000B39A 8004            	    19: 	dc.w	$8004	; 04=00000100 -> 9-bit palette, everything else disabled
                            	    20: 	
                            	    21: 	;---------------------------------------------------------------------------
                            	    22: 	; Register 1: Mode Set Register 2 - [move.w #$81xx,($C00004)]
                            	    23: 	; bit 0 = Not used
                            	    24: 	; bit 1 = Not used
                            	    25: 	; bit 2 = SMS Mode (0: Do nothing, 1: SMS/Genesis display modes)
                            	    26: 	; bit 3 = PAL/NTSC (0: NTSC, 1: PAL)
                            	    27: 	; bit 4 = DMA Enable (0: Disabled, 1: Enabled)
                            	    28: 	; bit 5 = Vertical Interrupt Enable (0: Disabled, 1: Enabled)
                            	    29: 	; bit 6 = Display Enable (0: Disable display+draw backdrop only, 1: Enabled)
                            	    30: 	; bit 7 = TMS9918 Mode (0: Genesis mode, 1: SMS mode)
                            	    31: 	;---------------------------------------------------------------------------
00:0000B39C 8174            	    32: 	dc.w	$8174	; 74=01110100 -> Genesis display mode, DMA & V-int enabled
                            	    33: 	             
                            	    34: 	;---------------------------------------------------------------------------
                            	    35: 	; Register 2: VRAM Address for Scroll A - [move.w #$82xx,($C00004)]
                            	    36: 	; bit 0 = Not used
                            	    37: 	; bit 1 = Not used
                            	    38: 	; bit 2 = Not used
                            	    39: 	; bits 3-5 = bits 15-13 in the address of the pattern name table
                            	    40: 	; bit 6 = Not used
                            	    41: 	; bit 7 = Not used
                            	    42: 	;---------------------------------------------------------------------------
00:0000B39E 8230            	    43: 	dc.w	$8230	; 30=00110000 -> 1100000000000000 -> $C000
                            	    44: 					; 01000000000000000000000000000011 -> 40000003
                            	    45: 	
                            	    46: 	;---------------------------------------------------------------------------
                            	    47: 	; Register 3: VRAM Address for Window - [move.w #$83xx,($C00004)]
                            	    48: 	; bit 0 = Not used
                            	    49: 	; bits 1-5 = bits 15-11 in the address of the pattern name table
                            	    50: 	; bit 6 = Not used
                            	    51: 	; bit 7 = Not used
                            	    52: 	;---------------------------------------------------------------------------
00:0000B3A0 8328            	    53: 	dc.w	$8328	; 3E=00101000 -> 1010000000000000 -> $A000
                            	    54: 					; 01100000000000000000000000000010 -> 60000002
                            	    55: 
                            	    56: 	;---------------------------------------------------------------------------
                            	    57: 	; Register 4: VRAM Address for Scroll B - [move.w #$84xx,($C00004)]
                            	    58: 	; bits 0-2 = bits 15-13 in the address of the pattern name table
                            	    59: 	; bit 3 = Not used
                            	    60: 	; bit 4 = Not used
                            	    61: 	; bit 5 = Not used
                            	    62: 	; bit 6 = Not used
                            	    63: 	; bit 7 = Not used
                            	    64: 	;---------------------------------------------------------------------------
00:0000B3A2 8407            	    65: 	dc.w	$8407	; 07=00000111 -> 1110000000000000 -> $E000
                            	    66: 					; 01100000000000000000000000000011 -> 60000003
                            	    67: 	
                            	    68: 	;---------------------------------------------------------------------------
                            	    69: 	; Register 5: VRAM Address for Sprite Attributes - [move.w #$85xx,($C00004)]
                            	    70: 	; bits 0-6 = bits 15-9 in the address of the pattern name table
                            	    71: 	; bit 7 = Not used
                            	    72: 	;---------------------------------------------------------------------------
00:0000B3A4 855C            	    73: 	dc.w	$855C	; 5C=01011100 -> 1011100000000000 -> $B800
                            	    74: 					; 01111000000000000000000000000010 -> 78000002
                            	    75: 
                            	    76: 	;---------------------------------------------------------------------------
                            	    77: 	; Register 6: Not used (used by Master System?)
                            	    78: 	;---------------------------------------------------------------------------
00:0000B3A6 8600            	    79: 	dc.w	$8600	; unused
                            	    80: 
                            	    81: 	;---------------------------------------------------------------------------
                            	    82: 	; Register 7: Backdrop Color - [move.w #$87xx,($C00004)]
                            	    83: 	; bits 0-3 = Which palette to use (0-3)
                            	    84: 	; bits 5-4 = Which color to use in the selected palette (0-15)
                            	    85: 	; bit 6 = Not used
                            	    86: 	; bit 7 = Not used
                            	    87: 	;---------------------------------------------------------------------------
00:0000B3A8 8700            	    88: 	dc.w	$8700	; background color, last two digits are palette#+color#
                            	    89: 
                            	    90: 	;---------------------------------------------------------------------------
                            	    91: 	; Register 8: Not used (used by Master System?)
                            	    92: 	;---------------------------------------------------------------------------
00:0000B3AA 8800            	    93: 	dc.w	$8800	; unused
                            	    94: 
                            	    95: 	;---------------------------------------------------------------------------
                            	    96: 	; Register 9: Not used (used by Master System?)
                            	    97: 	;---------------------------------------------------------------------------
00:0000B3AC 8900            	    98: 	dc.w	$8900	; unused
                            	    99: 
                            	   100: 	;---------------------------------------------------------------------------
                            	   101: 	; Register 10: Horizontal Interrupt Register - [move.w #$8Axx,($C00004)]
                            	   102: 	; bits 0-7 = The number of lines it takes to generate a h-int
                            	   103: 	;---------------------------------------------------------------------------
00:0000B3AE 8A00            	   104: 	dc.w	$8A00	; HInterrupt register 0 = h-int generated every line
                            	   105: 
                            	   106: 	;---------------------------------------------------------------------------
                            	   107: 	; Register 11: Mode Set Register No. 3 - [move.w #$8Bxx,($C00004)]
                            	   108: 	; bits 0-1 = Horizontal Scroll Mode
                            	   109: 	; 	00=full screen scrolling, 01||11=line scrolling, 11=cell scrolling
                            	   110: 	; bit 2 = Vertical Scroll Mode
                            	   111: 	; 	0=full screen scrolling, 1=two-cell column based vertical scrolling
                            	   112: 	; bit 3 = External Interrupt Enabled (0: Disabled, 1: Enabled)
                            	   113: 	; bit 4 = Not used
                            	   114: 	; bit 5 = Not used
                            	   115: 	; bit 6 = Not used
                            	   116: 	; bit 7 = Not used
                            	   117: 	;---------------------------------------------------------------------------
00:0000B3B0 8B00            	   118: 	dc.w	$8B00	; full screen scroll, no external interrupts
                            	   119: 	
                            	   120: 	;---------------------------------------------------------------------------
                            	   121: 	; Register 12: Mode Set Register No. 4 - [move.w #$8Cxx,($C00004)]
                            	   122: 	; bits 0+7 = cell mode 
                            	   123: 	; 	0,0=32=cells display, 1,1=40 cells display, 0,1 & 1,0 are invalid
                            	   124: 	; bits 1-2 = Interlace Mode
                            	   125: 	;	00,10=No interlace, 01=Interlace (normal), 11=Interlace (double)
                            	   126: 	; bit 3 = Shadow/Highlighting Mode Enabled  (0: Disabled, 1: Enabled)
                            	   127: 	; bit 4 = Not used
                            	   128: 	; bit 5 = Not used
                            	   129: 	; bit 6 = Not used
                            	   130: 	;---------------------------------------------------------------------------
00:0000B3B2 8C81            	   131: 	dc.w	$8C81	; 81 = 10000001 -> 40 cell display, no interlace
                            	   132: 
                            	   133: 	;---------------------------------------------------------------------------
                            	   134: 	; Register 13: Horizontal Scroll VRAM Address - [move.w #$8Dxx,($C00004)]
                            	   135: 	; bits 0-5 = bits 15-10 in the address of the pattern name table
                            	   136: 	; bit 6 = Not used
                            	   137: 	; bit 7 = Not used
                            	   138: 	;---------------------------------------------------------------------------
00:0000B3B4 8D2F            	   139: 	dc.w	$8D2F	; 2F=00101111 -> 1011110000000000 -> $BC00
                            	   140: 					; 01111100000000000000000000000010 -> 7C000002
                            	   141: 
                            	   142: 	;---------------------------------------------------------------------------
                            	   143: 	; Register 14: Not used
                            	   144: 	;---------------------------------------------------------------------------
00:0000B3B6 8E00            	   145: 	dc.w	$8E00	; unused
                            	   146: 
                            	   147: 	;---------------------------------------------------------------------------
                            	   148: 	; Register 15: Auto Increment Data - [move.w #$8Fxx,($C00004)]
                            	   149: 	; bits 0-7 = value added to the VDP's address register after every r/w
                            	   150: 	;---------------------------------------------------------------------------
00:0000B3B8 8F02            	   151: 	dc.w	$8F02	; VDP auto increment
                            	   152: 
                            	   153: 	;---------------------------------------------------------------------------
                            	   154: 	; Register 16: Scroll Size - [move.w #$90xx,($C00004)]
                            	   155: 	; bits 0-1 = Horizontal Scroll Size 
                            	   156: 	; 	00 = 32-cells, 01 = 64-cells, 10 = invalid, 11 = 128-cells
                            	   157: 	; bit 2 = Not used
                            	   158: 	; bit 3 = Not used
                            	   159: 	; bits 4-5 = Vertical Scroll Size
                            	   160: 	; 	00 = 32-cells, 01 = 64-cells, 10 = invalid, 11 = 128-cells
                            	   161: 	; bit 6 = Not used
                            	   162: 	; bit 7 = Not used
                            	   163: 	;---------------------------------------------------------------------------
00:0000B3BA 9001            	   164: 	dc.w	$9001	; 01 = 00000001 -> 64 cells hscroll, 32 cells vscroll 
                            	   165: 
                            	   166: 	;---------------------------------------------------------------------------
                            	   167: 	; Register 17: Window Horizontal Position - [move.w #$91xx,($C00004)]
                            	   168: 	; bits 0-4 = how many cells to move the window plane horizontally
                            	   169: 	; bit 5 = Not used
                            	   170: 	; bit 6 = Not used
                            	   171: 	; bit 7 = Direction to move the window plane horizontally (0=left, 1=right)
                            	   172: 	;---------------------------------------------------------------------------
00:0000B3BC 9100            	   173: 	dc.w	$9100	; window H position
                            	   174: 
                            	   175: 	;---------------------------------------------------------------------------
                            	   176: 	; Register 18: Window Vertical Position - [move.w #$92xx,($C00004)]
                            	   177: 	; bits 0-4 = how many cells to move the window plane vertically
                            	   178: 	; bit 5 = Not used
                            	   179: 	; bit 6 = Not used
                            	   180: 	; bit 7 = Direction to move the window plane vertically (0=up, 1=down)	
                            	   181: 	;---------------------------------------------------------------------------
00:0000B3BE 9200            	   182: 	dc.w	$9200	; window V position
                            	   183: 
                            	   184: 	;---------------------------------------------------------------------------
                            	   185: 	; Register 19: DMA length low word - [move.w #$93xx,($C00004)]
                            	   186: 	; bits 0-7 = low bytes of DMA length
                            	   187: 	;---------------------------------------------------------------------------
00:0000B3C0 93FF            	   188: 	dc.w	$93FF	; DMA length low
                            	   189: 	
                            	   190: 	;---------------------------------------------------------------------------
                            	   191: 	; Register 20: DMA length high word - [move.w #$94xx,($C00004)]
                            	   192: 	; bits 0-7 = high bytes of DMA length
                            	   193: 	;---------------------------------------------------------------------------
00:0000B3C2 94FF            	   194: 	dc.w	$94FF	; DMA length high
                            	   195: 
                            	   196: 	;---------------------------------------------------------------------------
                            	   197: 	; Register 21: DMA source address low word - [move.w #$95xx,($C00004)]
                            	   198: 	; bits 0-7 = low bytes of DMA source address
                            	   199: 	;---------------------------------------------------------------------------
00:0000B3C4 9500            	   200: 	dc.w	$9500	; DMA source address low
                            	   201: 
                            	   202: 	;---------------------------------------------------------------------------
                            	   203: 	; Register 22: DMA source address high word - [move.w #$96xx,($C00004)]
                            	   204: 	; bits 0-7 = high bytes of DMA source address
                            	   205: 	;---------------------------------------------------------------------------
00:0000B3C6 9600            	   206: 	dc.w	$9600	; DMA source address high
                            	   207: 
                            	   208: 	;---------------------------------------------------------------------------
                            	   209: 	; Register 23: DMA Type - [move.w #$97xx,($C00004)]
                            	   210: 	; If bit 7 is 0:
                            	   211: 	;	DMA type is Memory to VRAM
                            	   212: 	;	bits 0-6 = bits 22-16 of DMA source address
                            	   213: 	; If bit 7 is 1:
                            	   214: 	;	DMA type is VRAM fill (if bit 6 = 0) or VRAM to VRAM copy (if bit 6 = 1)
                            	   215: 	;	bits 0-5 are ignored
                            	   216: 	;---------------------------------------------------------------------------
00:0000B3C8 9780            	   217: 	dc.w	$9780	; DMA Type
