00:00009906 08860013        	   113: 	bclr.l	#DIALOG_FLAG_STYLE_TITLED,d6	; clear the titled flag
00:0000990A 23C6FFFF0226    	   114: 	move.l	d6,(MEM_DIALOG_FLAGS)	; save it back
00:00009910 4DF900110058    	   115: 	lea	RadioMenu,a6	; load text
00:00009916 23CEFFFF022E    	   116: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:0000991C 4E75            	   117: 	rts
