                            	   112: Day00Scene00Action02:	; ACTION_TAKE_GIVE
00:00003D60 3C39FFFF002E    	   113: 	move.w	(MEM_ACTION_TARGET_OBJID),d6	; copy action target to d6
00:00003D66 02461000        	   114: 	andi.w	#OBJ_SCENE_BASE,d6	; and against base scene ID
00:00003D6A 6700004E        	   115: 	beq.w	Day00Scene00Action02GiveNPC	; not scenery
00:00003D6E 2E39FFFF00A2    	   116: 	move.l	(MEM_DAY_EVENT_FLAGS),d7	; copy event flags for the day to d7
00:00003D74 08070008        	   117: 	btst.l	#EVENT_FLAG_DAY00_EVENT00_COMPLETE,d7	; test if 1st event ran
00:00003D78 6638            	   118: 	bne.s	Day00Scene00Action02DefaultTake	; flag is set, branch
00:00003D7A 08070007        	   119: 	btst.l	#EVENT_FLAG_DAY00_NPC01_GIVE02,d7	; test if last give flag is set
00:00003D7E 6732            	   120: 	beq.s	Day00Scene00Action02DefaultTake	; flag is not set, branch
00:00003D80 3C39FFFF002E    	   121: 	move.w	(MEM_ACTION_TARGET_OBJID),d6	; copy action target to d6
00:00003D86 0C461001        	   122: 	cmpi.w	#OBJ_SCENE_VB_8BIT,d6	;  8-bit games?
00:00003D8A 670C            	   123: 	beq.s	Day00Scene00Action02LaunchScriptedEvent	; if so, launch event
00:00003D8C 0C461003        	   124: 	cmpi.w	#OBJ_SCENE_VB_16BIT,d6	; 16-bit games?
00:00003D90 6706            	   125: 	beq.s	Day00Scene00Action02LaunchScriptedEvent	; if so, launch event
00:00003D92 0C461036        	   126: 	cmpi.w	#OBJ_SCENE_VB_HANDHELD,d6	; handheld games?
00:00003D96 661A            	   127: 	bne.s	Day00Scene00Action02DefaultTake	; if not branch
                            	   128: Day00Scene00Action02LaunchScriptedEvent:
                            	   129: 	; set flag to indicate the scripted event ran
