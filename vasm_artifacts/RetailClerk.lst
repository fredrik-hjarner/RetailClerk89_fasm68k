00:00003C32 3C39FFFF002E    	    17: 	move.w	(MEM_ACTION_TARGET_OBJID),d6
00:00003C38 0C461006        	    18: 	cmpi.w	#OBJ_SCENE_REGISTER,d6	; test target
00:00003C3C 670000BC        	    19: 	beq.w	Day00Scene00Register	; branch if this is the register
00:00003C40 0C462001        	    20: 	cmpi.w	#OBJ_NPC_DANI,d6	; test target
00:00003C44 6638            	    21: 	bne.s	Day00Scene00Action01NPCMaleShopper	; branch to next NPC
                            	    22: Day00Scene00Action01NPCDani:
                            	    23: 	;---------------------------------------------------------------------------
                            	    24: 	; handle dialog with NPC Dani		
                            	    25: 	;---------------------------------------------------------------------------
