                            	   230: ;****************************************************************************
                            	   231: ; Echo_PlayDirect
                            	   232: ; Injects events into the BGM stream for the next tick.
                            	   233: ;
                            	   234: ; input a0.l ... Pointer to stream data
                            	   235: ;****************************************************************************
                            	   236: 
                            	   237: Echo_PlayDirect:
                            	   238:     Echo_Z80Request                 ; We need the Z80 bus
00:00009C6A 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000091:
00:00009C72 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009C7A 66F6            	     4M     bne.s   @Echo_WaitZ80_000091         ; Keep waiting
00:00009C7C 48E7C0C0        	   239:     movem.l d0-d1/a0-a1, -(sp)      ; Save registers
                            	   240: 
00:00009C80 43F900A01F00    	   241:     lea     ($A01F00), a1           ; Skip any pending events
00:00009C86 72FF            	   242:     moveq   #-1, d1
                            	   243: @Skip:
00:00009C88 B211            	   244:     cmp.b   (a1), d1
00:00009C8A 6704            	   245:     beq.s   @Load
00:00009C8C 5249            	   246:     addq.w  #1, a1
00:00009C8E 60F8            	   247:     bra.s   @Skip
                            	   248: 
                            	   249: @Load:                              ; Copy stream into the direct buffer
00:00009C90 1018            	   250:     move.b  (a0)+, d0
00:00009C92 12C0            	   251:     move.b  d0, (a1)+
00:00009C94 B001            	   252:     cmp.b   d1, d0
00:00009C96 66F8            	   253:     bne.s   @Load
                            	   254: 
00:00009C98 4CDF0303        	   255:     movem.l (sp)+, d0-d1/a0-a1      ; Restore registers
                            	   256:     Echo_Z80Release                 ; We're done with the Z80 bus
00:00009C9C 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
00:00009CA4 4E75            	   257:     rts                             ; End of subroutine
