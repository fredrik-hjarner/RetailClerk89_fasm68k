                            	    81: ;*******************************************************************************
                            	    82: ; default event processing routines
                            	    83: ;*******************************************************************************
                            	    84: 
                            	    85: ;-------------------------------------------------------------------------------
                            	    86: ; builds the give menu or displays message if the player has no items
                            	    87: ;-------------------------------------------------------------------------------
                            	    88: DefaultActionGive:
00:000098B6 0C790000FFFF00AC	    89: 	cmpi.w	#$0000,(MEM_PLAYER_ITEM_COUNT)	; is item count 0?
00:000098BE 672E            	    90: 	beq.s	DefaultActionGiveNoItems	; branch if 0
00:000098C0 4DF90010FFFC    	    91: 	lea	ItemMenu,a6	; load dialog text
00:000098C6 23CEFFFF022E    	    92: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:000098CC 4DF9FFFF00AE    	    93: 	lea	MEM_PLAYER_ITEMS,a6	; load item list
00:000098D2 23CEFFFF0236    	    94: 	move.l	a6,MEM_DIALOG_ITEM_LIST	; copy address to MEM_DIALOG_ITEM_LIST
00:000098D8 2E39FFFF0226    	    95: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy dialog flags to d7
00:000098DE 08C70016        	    96: 	bset.l	#DIALOG_FLAG_STYLE_TEXT_4CHOICE,d7	; set text choice flag
00:000098E2 08C70014        	    97: 	bset.l	#DIALOG_FLAG_STYLE_ITEM_MENU,d7	; set item menu flag
00:000098E6 23C7FFFF0226    	    98: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save updated dialog flags
00:000098EC 600C            	    99: 	bra.s	ExitDefaultActionGive	; exit
                            	   100: DefaultActionGiveNoItems:
00:000098EE 4DF900100471    	   101: 	lea	DialogTextNoItems,a6	; load dialog text
00:000098F4 23CEFFFF022E    	   102: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
                            	   103: ExitDefaultActionGive:
00:000098FA 4E75            	   104: 	rts
