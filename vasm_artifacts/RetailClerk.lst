00:000008EC 08390000FFFF0028	    80: 	btst	#STATE_FLAG_VBLANK,(MEM_GAME_STATE)	; test vblank flag
00:000008F4 67F6            	    81: 	beq.s	WaitVBlank	; loop until flag changes
00:000008F6 08B90000FFFF0028	    82: 	bclr	#STATE_FLAG_VBLANK,(MEM_GAME_STATE)	; clear vblank flag
00:000008FE 4E75            	    83: 	rts	; exit
                            	    84: ; unused - seems buggy on clone hardware, included just for reference
                            	    85: ;WaitVBlankStart:
                            	    86: ;	move.w	VDP_CONTROL,d0	; copy VDP status to d0
                            	    87: ;   andi.w	#VDP_STATUS_VBLANK,d0	; check if the vblank status flag is set
                            	    88: ;	beq.s	WaitVBlankStart	; wait for vblank to start
                            	    89: ;	rts	; exit
