                            	    29: ;****************************************************************************
                            	    30: ; Echo_Z80Request
                            	    31: ; Requests the Z80 bus
                            	    32: ;****************************************************************************
                            	    33: 
                            	    34: Echo_Z80Request macro
                            	    35:     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	    36: @Echo_WaitZ80\@:
                            	    37:     btst.b  #0, ($A11100)           ; Did we get it yet?
                            	    38:     bne.s   @Echo_WaitZ80\@         ; Keep waiting
                            	    39:     endm                            ; End of macro
                            	    40: 
                            	    41: ;****************************************************************************
                            	    42: ; Echo_Z80Release
                            	    43: ; Releases the Z80 bus
                            	    44: ;****************************************************************************
                            	    45: 
                            	    46: Echo_Z80Release macro
                            	    47:     move.w  #$000, ($A11100)        ; Release Z80 bus
                            	    48:     endm                            ; End of macro
                            	    49: 
                            	    50: ;****************************************************************************
                            	    51: ; Echo_Z80Reset
                            	    52: ; Resets the Z80 and YM2612
                            	    53: ;****************************************************************************
                            	    54: 
                            	    55: Echo_Z80Reset macro
                            	    56:     move.w  #$000, ($A11200)        ; Assert reset line
                            	    57:     rept    $10                     ; Wait until hardware resets
                            	    58:     nop                               ; ...
                            	    59:     endr                              ; ...
                            	    60:     move.w  #$100, ($A11200)        ; Release reset line
                            	    61:     endm                            ; End of macro
                            	    62: 
                            	    63: ;****************************************************************************
                            	    64: ; Echo_SendCommand
                            	    65: ; Sends an Echo command (no address parameter)
                            	    66: ;
                            	    67: ; input d0.b ... Echo command
                            	    68: ;****************************************************************************
                            	    69: 
                            	    70: Echo_SendCommand:
00:00009AF8 3F01            	    71:     move.w  d1, -(sp)               ; Save register
                            	    72: 
                            	    73:     Echo_Z80Request                 ; We need the Z80 bus
00:00009AFA 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000079:
00:00009B02 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009B0A 66F6            	     4M     bne.s   @Echo_WaitZ80_000079         ; Keep waiting
                            	    74: 
                            	    75: @TrySendCommand:
00:00009B0C 4A3900A01FFF    	    76:     tst.b   ($A01FFF)               ; Check if Echo is ready
00:00009B12 6724            	    77:     beq.s   @ReadySendCommand                  ; Too busy?
                            	    78:     Echo_Z80Release                   ; Let Echo continue
00:00009B14 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
00:00009B1C 323C00FF        	    79:     move.w  #$FF, d1                  ; Give it some time
00:00009B20 51C9FFFE        	    80:     dbf     d1, *                       ; ...
                            	    81:     Echo_Z80Request                   ; Get Z80 bus back
00:00009B24 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000081:
00:00009B2C 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009B34 66F6            	     4M     bne.s   @Echo_WaitZ80_000081         ; Keep waiting
00:00009B36 60D4            	    82:     bra.s   @TrySendCommand                      ; Try again
                            	    83: 
                            	    84: @ReadySendCommand:
00:00009B38 13C000A01FFF    	    85:     move.b  d0, ($A01FFF)           ; Write command ID
                            	    86:     Echo_Z80Release                 ; We're done with the Z80 bus
00:00009B3E 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
                            	    87: 
00:00009B46 321F            	    88:     move.w  (sp)+, d1               ; Restore register
00:00009B48 4E75            	    89:     rts                             ; End of subroutine
                            	    90: 
                            	    91: ;****************************************************************************
                            	    92: ; Echo_SendCommandAddr
                            	    93: ; Sends an Echo command (with address parameter)
                            	    94: ;
                            	    95: ; input d0.b ... Echo command
                            	    96: ; input a0.l ... Address parameter
                            	    97: ;****************************************************************************
                            	    98: 
                            	    99: Echo_SendCommandAddr:
                            	   100: Echo_SendCommandEx:
00:00009B4A 48E7C000        	   101:     movem.l d0-d1, -(sp)            ; Save register
                            	   102: 
                            	   103:     Echo_Z80Request                 ; We need the Z80 bus
00:00009B4E 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000083:
00:00009B56 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009B5E 66F6            	     4M     bne.s   @Echo_WaitZ80_000083         ; Keep waiting
                            	   104: 
                            	   105: @TrySendCommandAddr:
00:00009B60 4A3900A01FFF    	   106:     tst.b   ($A01FFF)               ; Check if Echo is ready
00:00009B66 6724            	   107:     beq.s   @ReadySendCommandAddr                  ; Too busy?
                            	   108:     Echo_Z80Release                   ; Let Echo continue
00:00009B68 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
00:00009B70 323C00FF        	   109:     move.w  #$FF, d1                  ; Give it some time
00:00009B74 51C9FFFE        	   110:     dbf     d1, *                       ; ...
                            	   111:     Echo_Z80Request                   ; Get Z80 bus back
00:00009B78 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000085:
00:00009B80 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009B88 66F6            	     4M     bne.s   @Echo_WaitZ80_000085         ; Keep waiting
00:00009B8A 60D4            	   112:     bra.s   @TrySendCommandAddr                      ; Try again
                            	   113: 
                            	   114: @ReadySendCommandAddr:
00:00009B8C 13C000A01FFF    	   115:     move.b  d0, ($A01FFF)           ; Write command ID
                            	   116: 
00:00009B92 2008            	   117:     move.l  a0, d0                  ; Easier to manipulate here
00:00009B94 13C000A01FFD    	   118:     move.b  d0, ($A01FFD)           ; Store low address byte
00:00009B9A EE88            	   119:     lsr.l   #7, d0                  ; Get high address byte
00:00009B9C E208            	   120:     lsr.b   #1, d0                    ; We skip one bit
00:00009B9E 08C00007        	   121:     bset.l  #7, d0                    ; Point into bank window
00:00009BA2 13C000A01FFE    	   122:     move.b  d0, ($A01FFE)           ; Store high address byte
                            	   123: 
00:00009BA8 E048            	   124:     lsr.w   #8, d0                  ; Get bank byte
00:00009BAA 3200            	   125:     move.w  d0, d1                    ; Parse 32X bit separately
00:00009BAC E249            	   126:     lsr.w   #1, d1                    ; Put 32X bit in place
00:00009BAE C03C007F        	   127:     and.b   #$7F, d0                  ; Filter out unused bit from addresses
00:00009BB2 C23C0080        	   128:     and.b   #$80, d1                  ; Filter out all but 32X bit
00:00009BB6 8001            	   129:     or.b    d1, d0                    ; Put everything together
00:00009BB8 13C000A01FFC    	   130:     move.b  d0, ($A01FFC)           ; Store bank byte
                            	   131: 
                            	   132:     Echo_Z80Release                 ; We're done with the Z80 bus
00:00009BBE 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
                            	   133: 
00:00009BC6 4CDF0003        	   134:     movem.l (sp)+, d0-d1            ; Restore register
00:00009BCA 4E75            	   135:     rts                             ; End of subroutine
                            	   136: 
                            	   137: ;****************************************************************************
                            	   138: ; Echo_SendCommandByte
                            	   139: ; Sends an Echo command (with a byte parameter)
                            	   140: ;
                            	   141: ; input d0.b ... Echo command
                            	   142: ; input d1.b ... Byte parameter
                            	   143: ;****************************************************************************
                            	   144: 
                            	   145: Echo_SendCommandByte:
                            	   146:     Echo_Z80Request                 ; We need the Z80 bus
00:00009BCC 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000087:
00:00009BD4 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009BDC 66F6            	     4M     bne.s   @Echo_WaitZ80_000087         ; Keep waiting
                            	   147: 
00:00009BDE 3F01            	   148:     move.w  d1, -(sp)               ; Save register
                            	   149: @TrySendCommandByte:
00:00009BE0 4A3900A01FFF    	   150:     tst.b   ($A01FFF)               ; Check if Echo is ready
00:00009BE6 6724            	   151:     beq.s   @ReadySendCommandByte                  ; Too busy?
                            	   152:     Echo_Z80Release                   ; Let Echo continue
00:00009BE8 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
00:00009BF0 323C00FF        	   153:     move.w  #$FF, d1                  ; Give it some time
00:00009BF4 51C9FFFE        	   154:     dbf     d1, *                       ; ...
                            	   155:     Echo_Z80Request                   ; Get Z80 bus back
00:00009BF8 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000089:
00:00009C00 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009C08 66F6            	     4M     bne.s   @Echo_WaitZ80_000089         ; Keep waiting
00:00009C0A 60D4            	   156:     bra.s   @TrySendCommandByte                      ; Try again
                            	   157: 
                            	   158: @ReadySendCommandByte:
00:00009C0C 321F            	   159:     move.w  (sp)+, d1               ; Restore register
00:00009C0E 13C000A01FFF    	   160:     move.b  d0, ($A01FFF)           ; Write command ID
00:00009C14 13C100A01FFC    	   161:     move.b  d1, ($A01FFC)           ; Write parameter
                            	   162:     Echo_Z80Release                 ; We're done with the Z80 bus
00:00009C1A 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
                            	   163: 
00:00009C22 4E75            	   164:     rts                             ; End of subroutine
