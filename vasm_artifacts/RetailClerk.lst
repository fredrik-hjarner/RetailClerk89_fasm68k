                            	    96: Day00Scene00Action01NPCGreenberg:
                            	    97: 	;---------------------------------------------------------------------------
                            	    98: 	; handle dialog with Greenberg		
                            	    99: 	;---------------------------------------------------------------------------
00:00003D3C 0C792003FFFF002E	   100: 	cmpi.w	#OBJ_NPC_GREENBERG,(MEM_ACTION_TARGET_OBJID)	; test target
00:00003D44 6600000C        	   101: 	bne.w	Day00Scene00Action01Default	; branch to display default text
00:00003D48 4DF9001009D0    	   102: 	lea	DialogTextGreenbergScene00Day00Talk,a6	; load dialog text
00:00003D4E 60000008        	   103: 	bra.w	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	   104: Day00Scene00Action01Default:
                            	   105: 	; default
00:00003D52 4DF900100499    	   106: 	lea	DialogTextNothingHappens,a6	; load default text
                            	   107: Day00Scene00Action01CopyDialogText:
