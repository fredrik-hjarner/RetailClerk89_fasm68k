                            	   588: Day06Scene11Action01NPC:
                            	   589: 	;---------------------------------------------------------------------------
                            	   590: 	; Possible flows here..
                            	   591: 	; 1) EVENT_FLAG_DAY06_SUB00_COMPLETE = 1 -> text about working
                            	   592: 	; 2) EVENT_FLAG_DAY06_EVENT_PLAN = 0 -> Default NPC text
                            	   593: 	; 3) EVENT_FLAG_DAY06_EVENT_PLAN = 1 and
                            	   594: 	;    EVENT_FLAG_DAY06_SUB00_STARTED = 0 -> scripted event to start sub 
                            	   595: 	; 4) EVENT_FLAG_DAY06_SUB00_STARTED = 1 and
                            	   596: 	;    MISSION_FLAG_DAY06_SUB00_GETITEM = 0 -> message about needing item
                            	   597: 	; 5) EVENT_FLAG_DAY06_SUB00_STARTED = 1 and
                            	   598: 	;    MISSION_FLAG_DAY06_SUB00_GETITEM = 1 -> dialog and set complete flag
                            	   599: 	;---------------------------------------------------------------------------
00:00008AC6 2E39FFFF00A2    	   600: 	move.l	(MEM_DAY_EVENT_FLAGS),d7	; copy event flags to d7
00:00008ACC 08070002        	   601: 	btst.l	#EVENT_FLAG_DAY06_SUB00_COMPLETE,d7	; test if sub complete
00:00008AD0 665E            	   602: 	bne.s	Day06Scene11Action01NPCSubComplete	; flag is set, branch
00:00008AD2 08070000        	   603: 	btst.l	#EVENT_FLAG_DAY06_EVENT_PLAN,d7	; test if planning scene has run
00:00008AD6 6700009E        	   604: 	beq.w	Day06Scene11Action01NPCDefault	; flag not set, branch
                            	   605: 	; at this point EVENT_FLAG_DAY06_EVENT_PLAN must be set
00:00008ADA 08070001        	   606: 	btst.l	#EVENT_FLAG_DAY06_SUB00_STARTED,d7	; test if sub started
00:00008ADE 675E            	   607: 	beq.s	Day06Scene11Action01NPCStartSub	; flag not set, branch
                            	   608: 	; test mission flags
00:00008AE0 2C39FFFF00A6    	   609: 	move.l	(MEM_MISSION_EVENT_FLAGS),d6	; copy mission flags to d6
00:00008AE6 08060000        	   610: 	btst.l	#MISSION_FLAG_DAY06_SUB00_GETITEM,d6	; test if sub complete
