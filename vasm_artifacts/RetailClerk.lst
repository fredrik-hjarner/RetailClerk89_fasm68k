                            	    12: Day01Scene00Action01NPCGreenberg:
00:0000427C 0C790001FFFF009C	    13: 	cmpi.w	#PLAYER_SPRITE_DANI,(MEM_PLAYER_SPRITE)	; test main character
00:00004284 675A            	    14: 	beq.s	Day01Scene00Action01NPCGreenbergDani	; branch to text for Dani
                            	    15: 	; otherwise playing as D.B.
00:00004286 2E39FFFF00A6    	    16: 	move.l	(MEM_MISSION_EVENT_FLAGS),d7	; copy mission flags to d7
00:0000428C 08070000        	    17: 	btst.l	#MISSION_FLAG_DAY01_SUB02_STARTED,d7	; test if flag is set
00:00004290 66000040        	    18: 	bne.w	Day01Scene00Action01NPCGreenbergDefault	; flag is set, branch
                            	    19: 	;---------------------------------------------------------------------------
                            	    20: 	; start the last mission of day 01
                            	    21: 	;---------------------------------------------------------------------------
00:00004294 08C70000        	    22: 	bset.l	#MISSION_FLAG_DAY01_SUB02_STARTED,d7	; set flag
00:00004298 23C7FFFF00A6    	    23: 	move.l	d7,(MEM_MISSION_EVENT_FLAGS)	; save mission flags
00:0000429E 33FC0002FFFF0026	    24: 	move.w	#OBJECTIVE_D1_O1,(MEM_OBJECTIVE)	; increment objective
                            	    25: 	; prevent bug if player fills inventory before talking to Greenberg	
00:000042A6 0C790004FFFF00AC	    26: 	cmpi.w	#MAX_ITEMS,(MEM_PLAYER_ITEM_COUNT)	; check if inventory is full
00:000042AE 6D0C            	    27: 	blt.s	.1	; branch if there is an open inventory slot
                            	    28: 	; overwrite first item in inventory
00:000042B0 4DF9FFFF00AE    	    29: 	lea MEM_PLAYER_ITEMS,a6	; point to start of item list
00:000042B6 3CBC3011        	    30: 	move.w	#OBJ_ITEM_MYSTERY_PACKAGE,(a6)	; overwrite the first item
00:000042BA 6008            	    31: 	bra.s	Day01Scene00Action01NPCGreenbergSub02Start
                            	    32: .1
00:000042BC 3E3C3011        	    33: 	move.w	#OBJ_ITEM_MYSTERY_PACKAGE,d7	; add package to inventory
00:000042C0 6100EB6C        	    34: 	bsr.w	AddItem	; add item to inventory
