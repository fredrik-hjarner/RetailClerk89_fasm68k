00:00000614 6100136E        	   200: 	bsr.w	StopSprite ; stop the sprite
00:00000618 6012            	   201: 	bra.s	MainGameLoopUpdateNPCSpritesLoopEnd ; done updating this sprite
                            	   202: .3	; move the NPC sprite
