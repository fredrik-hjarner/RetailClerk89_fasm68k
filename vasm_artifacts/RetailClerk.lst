                            	    58: 	include	'sub_SetSpriteLink.X68'

Source: "sub_SetSpriteLink.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; SetSpriteLink
                            	     3: ; sets the sprite link field for a sprite 
                            	     4: ; Parameters
                            	     5: ; d2 = ID of sprite to change
                            	     6: ; d3 = ID of sprite to link to
                            	     7: ; d5 is modified in this routine
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: SetSpriteLink:
00:00002896 2A3C78000002    	    10: 	move.l	#VDP_VRAM_WRITE_SPRITE,d5	; start at base sprite vram address
00:0000289C 0C420000        	    11: 	cmpi.w	#$0000,d2	; is this sprite zero?
00:000028A0 6608            	    12: 	bne.s	.1	; branch if not sprite zero
                            	    13: 	; sprite 0 is 8x8 so leave d3 as #$0000 - we can also skip the mulu step
00:000028A2 DABC00020000    	    14: 	add.l	#$00020000,d5	; move to index 2
00:000028A8 6018            	    15: 	bra.s	.2	; branch to end of routine
                            	    16: .1
                            	    17: 	; workaround for lack of mulu.l on 68000
00:000028AA C4FC0008        	    18: 	mulu.w	#$0008,d2	; move to address of sprite to modify	
00:000028AE 4842            	    19: 	swap	d2	; move result to high word
00:000028B0 C4BCFFFF0000    	    20: 	and.l	#$FFFF0000,d2	; clear low word
00:000028B6 DA82            	    21: 	add.l	d2,d5	; add address of sprite to modify
00:000028B8 DABC00020000    	    22: 	add.l	#$00020000,d5	; move to index 2
00:000028BE D67C0700        	    23: 	add.w	#SPRITE_DEF_WORD2_BASE,d3	; add base value to link field in d3
                            	    24: .2
00:000028C2 23C500C00004    	    25: 	move.l	d5,(VDP_CONTROL)	; set write location in VDP
00:000028C8 33C300C00000    	    26: 	move.w	d3,(VDP_DATA)	; store new sprite link field
00:000028CE 4E75            	    27: 	rts
                            	    28: 

Source: "inc_Subroutines.X68"
                            	    59: 
                            	    60: 	include	'sub_SetSpriteLinks.X68'

Source: "sub_SetSpriteLinks.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; not to be confused with SetSpriteLink..
                            	     3: ; this loops through the sprite sort table & calls SetSpriteLink for each entry
                            	     4: ; it also addresses the case where the player is the only sprite
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: SetSpriteLinks:
                            	     7: 	; clearing d2 & d3 prevents a bug that only occurred on the Firecore
00:000028D0 4282            	     8: 	clr.l	d2
00:000028D2 4283            	     9: 	clr.l	d3
                            	    10: 	; sprite zero points to the first record in the table
00:000028D4 7400            	    11: 	moveq	#$0000,d2
00:000028D6 3639FFFF0006    	    12: 	move.w	(MEM_SPRITE_SORT_TABLE_ID0),d3
00:000028DC 6100FFB8        	    13: 	bsr.w	SetSpriteLink
                            	    14: 	; loop through the others
00:000028E0 3839FFFF0148    	    15: 	move.w	(MEM_ACTIVE_NPC_COUNT),d4	; NPC_COUNT-1 is size of loop
00:000028E6 660E            	    16: 	bne.s	.1	; exit if there aren't any NPCs
                            	    17: 	; no NPC sprites - set last link and exit
00:000028E8 3439FFFF0006    	    18: 	move.w	(MEM_SPRITE_SORT_TABLE_ID0),d2
00:000028EE 7600            	    19: 	moveq	#$0000,d3
00:000028F0 6100FFA4        	    20: 	bsr.w	SetSpriteLink
00:000028F4 602C            	    21: 	bra.s	ExitSetSpriteLinks	; exit
                            	    22: .1
00:000028F6 5344            	    23: 	subq	#$1,d4	; NPC_COUNT-1 is size of loop
00:000028F8 49F9FFFF0006    	    24: 	lea	MEM_SPRITE_SORT_TABLE_ID0,a4	; point a4 to the second of sort table
                            	    25: SetSpriteLinksLoop:
00:000028FE 3414            	    26: 	move.w	(a4),d2	; copy sprite ID to d2
00:00002900 362C0004        	    27: 	move.w	(4,a4),d3	; copy next sprite ID to d3
00:00002904 6100FF90        	    28: 	bsr.w	SetSpriteLink	; save the link
00:00002908 D9FC00000004    	    29: 	adda.l	#$0004,a4	; move to next entry
00:0000290E 51CCFFEE        	    30: 	dbra	d4,SetSpriteLinksLoop	; decrement d4 and loop
                            	    31: 	; save the link for the last sprite
                            	    32: 	; this is done so any sprites past NPC_COUNT-1 don't accidentally display
00:00002912 3414            	    33: 	move.w	(a4),d2	; copy sprite ID to d2
00:00002914 7600            	    34: 	moveq	#$0000,d3	; points to sprite 0
00:00002916 6100FF7E        	    35: 	bsr.w	SetSpriteLink	; save the link
00:0000291A 33FC0000FFFF00BA	    36: 	move.w	#$0000,(MEM_SPRITE_Y_ORDER_CHANGED)	; clear Y order changed
                            	    37: ExitSetSpriteLinks:	
00:00002922 4E75            	    38: 	rts
                            	    39: 

Source: "inc_Subroutines.X68"
                            	    61: 
                            	    62: 	include	'sub_OrderSprites.X68'

Source: "sub_OrderSprites.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; this is all working as expected, which is a huge improvement over
                            	     3: ; previous attempts to implement this
                            	     4: ;
                            	     5: ; it's still very hard-coded and inefficient - the next iteration might
                            	     6: ; make these two problems better, or possibly worse
                            	     7: ;-------------------------------------------------------------------------------
                            	     8: OrderSprites:
00:00002924 46FC2700        	     9: 	move.w	#$2700,sr		; disable interrupts
                            	    10: 	; clear MEM_SPRITE_Y_ORDER_CHANGED to reuse it in this routine
00:00002928 33FC0000FFFF00BA	    11: 	move.w	#$0000,(MEM_SPRITE_Y_ORDER_CHANGED)	; clear Y order changed
                            	    12: ;-------------------------------------------------------------------------------
                            	    13: ; yes, this is a bubble sort, no it's not an awesome algorithm 
                            	    14: ; for a small number of entries it's OK
                            	    15: ;-------------------------------------------------------------------------------
00:00002930 4A79FFFF0148    	    16: 	tst.w	(MEM_ACTIVE_NPC_COUNT)	; test if there are 0 NPCs
00:00002936 6614            	    17: 	bne.s	SpriteYSortLoopOuter	; there are not 0 NPCs, branch
                            	    18: 	;---------------------------------------------------------------------------
                            	    19: 	; handle case where there are 0 NPCs
                            	    20: 	;---------------------------------------------------------------------------
                            	    21: 	; have sprite zero point to the player sprite
00:00002938 7400            	    22: 	moveq	#$0000,d2	; sprite zero is the sprite to edit
00:0000293A 7601            	    23: 	moveq	#$0001,d3	; player sprite is the sprite to link to
00:0000293C 6100FF58        	    24: 	bsr.w	SetSpriteLink	; set the sprite link
                            	    25: 	; have player sprite point to sprite zero
00:00002940 7401            	    26: 	moveq	#$0001,d2	; player sprite is the sprite to edit
00:00002942 7600            	    27: 	moveq	#$0000,d3	; sprite zero is the sprite to link to
00:00002944 6100FF50        	    28: 	bsr.w	SetSpriteLink	; set the sprite link
00:00002948 6000006A        	    29: 	bra.w	ExitOrderSprites	; exit
                            	    30: SpriteYSortLoopOuter:
00:0000294C 33FC0000FFFF0004	    31: 	move.w	#$0000,(MEM_SPRITE_SORT_TABLE_SORTED)	; start with table sorted
00:00002954 49F9FFFF0006    	    32: 	lea	MEM_SPRITE_SORT_TABLE_ID0,a4	; point a4 to the start of sort table
00:0000295A 3839FFFF0148    	    33: 	move.w	(MEM_ACTIVE_NPC_COUNT),d4	; NPC_COUNT-1 is number of times to loop
00:00002960 5344            	    34: 	subq	#$1,d4
                            	    35: SpriteYSortLoopInner:
00:00002962 342C0002        	    36: 	move.w	(2,a4),d2	; copy first Y-value to d2
00:00002966 B46C0006        	    37: 	cmp.w	(6,a4),d2	; compare it to the next Y-value
00:0000296A 6C28            	    38: 	bge.s	SpriteYSortLoopInnerDbra	; loop if they are in the right order
00:0000296C 33FCFFFFFFFF0004	    39: 	move.w	#$FFFF,(MEM_SPRITE_SORT_TABLE_SORTED)	; update to sort again
00:00002974 33FCFFFFFFFF00BA	    40: 	move.w	#$FFFF,(MEM_SPRITE_Y_ORDER_CHANGED)	; flag Y order changed
                            	    41: 	; swap IDs, using d3 as the swap variable	
00:0000297C 3614            	    42: 	move.w	(a4),d3
00:0000297E 38AC0004        	    43: 	move.w	(4,a4),(a4)
00:00002982 39430004        	    44: 	move.w	d3,(4,a4)
                            	    45: 	; swap Y-values, using d3 as the swap variable	
00:00002986 362C0002        	    46: 	move.w	(2,a4),d3
00:0000298A 396C00060002    	    47: 	move.w	(6,a4),(2,a4)
00:00002990 39430006        	    48: 	move.w	d3,(6,a4)
                            	    49: SpriteYSortLoopInnerDbra:
00:00002994 D9FC00000004    	    50: 	adda.l	#$0004,a4	; move to next entry
00:0000299A 51CCFFC6        	    51: 	dbra	d4,SpriteYSortLoopInner	; decrement d4 and loop
00:0000299E 4A79FFFF0004    	    52: 	tst.w	(MEM_SPRITE_SORT_TABLE_SORTED)	; test if the table changed
00:000029A4 66A6            	    53: 	bne.s	SpriteYSortLoopOuter	; if so then run another pass through
                            	    54: ;-------------------------------------------------------------------------------
                            	    55: ; write the new sprite links to the sprite table 
                            	    56: ;-------------------------------------------------------------------------------
                            	    57: 	; don't update VPD is the order hasn't changed
00:000029A6 4A79FFFF00BA    	    58: 	tst.w	(MEM_SPRITE_Y_ORDER_CHANGED)	; test MEM_SPRITE_Y_ORDER_CHANGED
00:000029AC 67000006        	    59: 	beq.w	ExitOrderSprites	; MEM_SPRITE_Y_ORDER_CHANGED = 0, exit
00:000029B0 6100FF1E        	    60: 	bsr.w	SetSpriteLinks	; loops through the table and sets links
                            	    61: 
                            	    62: ExitOrderSprites:
00:000029B4 46FC2000        	    63: 	move.w	#$2000,sr		; re-enable interrupts
00:000029B8 4E75            	    64: 	rts
                            	    65: 
                            	    66: 

Source: "inc_Subroutines.X68"
                            	    63: 
                            	    64: 	include	'sub_UpdateSpriteSortTable.X68'

Source: "sub_UpdateSpriteSortTable.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; d2 = ID to update 
                            	     3: ; d3 = new value
                            	     4: ;-------------------------------------------------------------------------------
                            	     5: UpdateSpriteSortTable:
00:000029BA 3839FFFF0148    	     6: 	move.w	(MEM_ACTIVE_NPC_COUNT),d4	; NPC_COUNT is max size of loop
00:000029C0 49F9FFFF0006    	     7: 	lea	MEM_SPRITE_SORT_TABLE_ID0,a4	; point a4 to the start of sort table
                            	     8: UpdateSpriteSortTableLoop:
00:000029C6 B454            	     9: 	cmp.w	(a4),d2	; compare ID to d2
00:000029C8 6606            	    10: 	bne.s	UpdateSpriteSortTableLoopDbra	; not equal, loop
00:000029CA 39430002        	    11: 	move.w	d3,(2,a4)	; copy new Y-value over
00:000029CE 600A            	    12: 	bra.s	UpdateSpriteSortTableExit	; exit
                            	    13: UpdateSpriteSortTableLoopDbra:
00:000029D0 D9FC00000004    	    14: 	adda.l	#$0004,a4	; move to next entry
00:000029D6 51CCFFEE        	    15: 	dbra	d4,UpdateSpriteSortTableLoop	; decrement d4 and loop
                            	    16: UpdateSpriteSortTableExit:
00:000029DA 4E75            	    17: 	rts
                            	    18: 
                            	    19: 
                            	    20: 

Source: "inc_Subroutines.X68"
                            	    65: 
                            	    66: 	include	'sub_SetDefaultSpriteOrder.X68'

Source: "sub_SetDefaultSpriteOrder.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; loads sprites in reverse order because scene definitions typically
                            	     3: ; have NPCs pre-sorted by Y value in ascending order
                            	     4: ;-------------------------------------------------------------------------------
                            	     5: SetDefaultSpriteOrder:
                            	     6: 	; clear the sprite order table - paranoid step really
00:000029DC 23FC00000000FFFF	     7: 	move.l	#$00000000,(MEM_SPRITE_SORT_TABLE_ID0)
00:000029E4 0006
00:000029E6 23FC00000000FFFF	     8: 	move.l	#$00000000,(MEM_SPRITE_SORT_TABLE_ID1)
00:000029EE 000A
00:000029F0 23FC00000000FFFF	     9: 	move.l	#$00000000,(MEM_SPRITE_SORT_TABLE_ID2)
00:000029F8 000E
00:000029FA 23FC00000000FFFF	    10: 	move.l	#$00000000,(MEM_SPRITE_SORT_TABLE_ID3)
00:00002A02 0012
00:00002A04 3839FFFF0148    	    11: 	move.w	(MEM_ACTIVE_NPC_COUNT),d4	; NPC_COUNT is max size of loop
00:00002A0A 4243            	    12: 	clr	d3	; use d3 to store offset
00:00002A0C 3604            	    13: 	move.w	d4,d3	; use d3 to store offset
00:00002A0E C6FC001A        	    14: 	mulu.w	#NPC_RECORD_SIZE,d3	; multiply by NPC record size to get offset
00:00002A12 4BF9FFFF00BC    	    15: 	lea	MEM_PLAYER_SPRITE_ID,a5	; point to first sprite
00:00002A18 DBC3            	    16: 	adda.l	d3,a5	; move to last NPC
00:00002A1A 49F9FFFF0006    	    17: 	lea	MEM_SPRITE_SORT_TABLE_ID0,a4	; point a4 to the start of sort table
                            	    18: SetDefaultSpriteOrderLoop:
00:00002A20 38AD0000        	    19: 	move.w	(STRUCT_SPRITE_ID,a5),(a4)	; copy sprite ID
00:00002A24 396D00040002    	    20: 	move.w	(STRUCT_SPRITE_Y,a5),(2,a4)	; copy Y-value
00:00002A2A 9BFC0000001A    	    21: 	suba.l	#NPC_RECORD_SIZE,a5	; move to previous sprite
00:00002A30 D9FC00000004    	    22: 	adda.l	#LWORD_SIZE,a4	; move to next sort table entry
00:00002A36 51CCFFE8        	    23: 	dbra	d4,SetDefaultSpriteOrderLoop	; decrement d4 and loop
00:00002A3A 4E75            	    24: 	rts
                            	    25: 

