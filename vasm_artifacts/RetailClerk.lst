00:00003B28 670C            	   952: 	beq.s	ExitScene17Day01CantExit	; flag not set = can't exit
00:00003B2A 08070001        	   953: 	btst.l	#EVENT_FLAG_DAY01_SUB01_COMPLETE,d7	; test flag blocking the exits
00:00003B2E 6706            	   954: 	beq.s	ExitScene17Day01CantExit	; flag not set = can't exit
00:00003B30 61000074        	   955: 	bsr.w	ExitSceneDay01SwitchPC	; switch to DB for the 2nd half of the day
00:00003B34 4E75            	   956: 	rts
