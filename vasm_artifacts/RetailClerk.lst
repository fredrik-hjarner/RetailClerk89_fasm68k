Source: "sub_ClearPlayerInventory.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; clear player inventory
                            	     3: ;-------------------------------------------------------------------------------
                            	     4: ClearPlayerInventory:
00:00002EE0 33FC0000FFFF00AC	     5: 	move.w	#$0000,(MEM_PLAYER_ITEM_COUNT)	; reset item count
00:00002EE8 43F9FFFF00AE    	     6: 	lea MEM_PLAYER_ITEMS,a1	; point to start of item list
00:00002EEE 3E3C0004        	     7: 	move.w	#MAX_ITEMS,d7	; copy max items to d7
00:00002EF2 5347            	     8: 	subq	#$1,d7	; decrement for zero-based list
                            	     9: ClearPlayerInventoryLoop:
00:00002EF4 32FC0000        	    10: 	move.w	#$0000,(a1)+
00:00002EF8 51CFFFFA        	    11: 	dbra	d7,ClearPlayerInventoryLoop	; loop to the end of the list
00:00002EFC 4E75            	    12: 	rts
                            	    13: 

Source: "inc_Subroutines.X68"
                            	    91: 
                            	    92: 	include	'sub_QueueScriptedEvent.X68'

Source: "sub_QueueScriptedEvent.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; Sets up a scripted event to run on the next main loop pass
                            	     3: ; a6 = address of event to queue
                            	     4: ; a5 and d7 are modified
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: QueueScriptedEvent:
                            	     7: 	;---------------------------------------------------------------------------
                            	     8: 	; set state flag
                            	     9: 	;---------------------------------------------------------------------------
00:00002EFE 2E39FFFF0028    	    10: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:00002F04 08C70005        	    11: 	bset.l	#STATE_FLAG_SCRIPTED_EVENT,d7	; set the scripted event flag
00:00002F08 23C7FFFF0028    	    12: 	move.l	d7,(MEM_GAME_STATE)	; save it back
                            	    13: 	;---------------------------------------------------------------------------
                            	    14: 	; determine which sprite this applies to
                            	    15: 	;---------------------------------------------------------------------------
00:00002F0E 3E1E            	    16: 	move.w	(a6)+,d7	; copy to d7 for next operations
00:00002F10 0C470000        	    17: 	cmpi.w	#$0000,d7	; is this the player sprite?
00:00002F14 6608            	    18: 	bne.s	.1	; branch if not player
00:00002F16 4BF9FFFF00BC    	    19: 	lea	MEM_PLAYER_SPRITE_ID,a5	; point a5 to player 
00:00002F1C 600E            	    20: 	bra.s	.2	; branch
                            	    21: .1
00:00002F1E 5547            	    22: 	subq	#$0002,d7	; decrement to account for 0 indexing & sprite zero
00:00002F20 4BF9FFFF00D6    	    23: 	lea	MEM_NPC0_SPRITE_ID,a5	; point a5 to first NPC 
00:00002F26 CEFC001A        	    24: 	mulu.w	#NPC_RECORD_SIZE,d7	; multiply to get offset
00:00002F2A DAC7            	    25: 	adda.w	d7,a5	; move to NPC being modified
                            	    26: .2
00:00002F2C 23CDFFFF0244    	    27: 	move.l	a5,(MEM_SCRIPTED_SPRITE_ADDR)	; save address
                            	    28: 	;---------------------------------------------------------------------------
                            	    29: 	; setup scripted event
                            	    30: 	;---------------------------------------------------------------------------
00:00002F32 33DEFFFF0240    	    31: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save first action
00:00002F38 23CEFFFF023C    	    32: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of first step
                            	    33: 	; set steps to 0 to trigger next action start in main loop
00:00002F3E 33FC0000FFFF0242	    34: 	move.w	#$0000,(MEM_SCRIPTED_EVENT_STEPS)
                            	    35: ExitQueueScriptedEvent:
00:00002F46 4E75            	    36: 	rts
                            	    37: 
                            	    38: 

