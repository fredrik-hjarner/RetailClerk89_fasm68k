00:00004268 6712            	     6: 	beq.s	Day01Scene00Action01NPCGreenberg	; branch to text for the NPC
00:0000426A 0C792016FFFF002E	     7: 	cmpi.w	#OBJ_NPC_DB,(MEM_ACTION_TARGET_OBJID)	; test target
