00:00002A6E 2E39FFFF0226    	     3: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy current dialog state to d7
00:00002A74 08C7001A        	     4: 	bset.l	#DIALOG_FLAG_TEXT_OPENING,d7	; change state to opening
00:00002A78 23C7FFFF0226    	     5: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save changes made to the game state
00:00002A7E 2E39FFFF0028    	     6: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
