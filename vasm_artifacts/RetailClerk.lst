                            	     1: ;*******************************************************************************
                            	     2: ; Main code file for RetailClerk89, a personal exercise to learn MD programming.
                            	     3: ; This might even turn into a real game demo one day.
                            	     4: ;
                            	     5: ; Build this using: 
                            	     6: ;	vasmm68k_mot -o RetailClerk89.bin -Fbin RetailClerk89.X68
                            	     7: ;
                            	     8: ; Visit http://HuguesJohnson.com/ for random articles about this project.
                            	     9: ; 
                            	    10: ; General program notes:
                            	    11: ; 	-there are some constants defined that are not used
                            	    12: ; 	-there are a lot of opportunities to optimize this code
                            	    13: ;*******************************************************************************
                            	    14: 
                            	    15: 	org	$000000
                            	    16: 
                            	    17: ;*******************************************************************************
                            	    18: ; constants
                            	    19: ;*******************************************************************************
                            	    20: 
                            	    21: ;-------------------------------------------------------------------------------
                            	    22: ; common constants
                            	    23: ;-------------------------------------------------------------------------------
                            	    24: 	include 'const_MegaDrive.X68'

