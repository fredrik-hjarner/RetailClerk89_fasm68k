                            	    34: MEM_CONTROL_HELD=$FFFF0022	; store value of a held button
                            	    35: MEM_CONTROL_PRESSED=$FFFF0024	; store value of a pressed button
                            	    36: ;-------------------------------------------------------------------------------
                            	    37: ; game state
                            	    38: ;-------------------------------------------------------------------------------
                            	    39: ; MEM_OBJECTIVE is first because it's used for save game title 
                            	    40: MEM_OBJECTIVE=$FFFF0026	; which text to show on objectives
                            	    41: MEM_GAME_STATE=$FFFF0028	; used to control the main loop flow
                            	    42: MEM_ACTION_ID=$FFFF002C	; current action selected by player
                            	    43: MEM_ACTION_TARGET_OBJID=$FFFF002E	; action target object id
                            	    44: MEM_ACTION_TARGET_NPCID=$FFFF0030	; NPC id if action target is an NPC
                            	    45: MEM_ACTION_TARGET_NPC_DIRECTION=$FFFF0032	; put NPC back in right direction
                            	    46: MEM_ACTION_TABLE_OFFSET=$FFFF0034	; relative address of action table entry
                            	    47: MEM_ACTIVE_ITEM=$FFFF0036	; item that is currently being used
                            	    48: MEM_NPC_LOCATIONS=$FFFF0038	; table to track where NPCs are located
                            	    49: MEM_INTRO_SCENE_COUNTER=$FFFF0098	; counter for displaying the intro screen
                            	    50: MEM_DAY=$FFFF009A	; what day is it in the story
                            	    51: MEM_PLAYER_SPRITE=$FFFF009C	; which sprite to use for the player
                            	    52: MEM_GLOBAL_EVENT_FLAGS=$FFFF009E	; track events across days
                            	    53: MEM_DAY_EVENT_FLAGS=$FFFF00A2	; track events in the current day
                            	    54: MEM_MISSION_EVENT_FLAGS=$FFFF00A6	; track events in the current mission
                            	    55: MEM_CUSTOMER_FEEDBACK_SCORE=$FFFF00AA	; used for some missions
                            	    56: ;-------------------------------------------------------------------------------
                            	    57: ; player inventory
                            	    58: ;-------------------------------------------------------------------------------
                            	    59: MEM_PLAYER_ITEM_COUNT=$FFFF00AC	; how many items the player is holding
                            	    60: MEM_PLAYER_ITEMS=$FFFF00AE	; four items
                            	    61: MEM_PLAYER_STORE_KEYS=$FFFF00B6	; track which store keys the player has
