                            	    19: MEM_SPRITE_SORT_TABLE_ID4=$FFFF0016	; sort table ID 4
                            	    20: MEM_SPRITE_SORT_TABLE_VALUE4=$FFFF0018	; sort table value 4
                            	    21: ;-------------------------------------------------------------------------------
                            	    22: ; counters
                            	    23: ;-------------------------------------------------------------------------------
                            	    24: MEM_VBLANK_COUNTER=$FFFF001A	; incremented at vblank - used for debug & RNG
                            	    25: MEM_MAINLOOP_COUNTER=$FFFF001C	; used for debug & RNG
                            	    26: MEM_FRAME_COUNTER=$FFFF001E	; current frame
                            	    27: ;-------------------------------------------------------------------------------
