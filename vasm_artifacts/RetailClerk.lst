Source: "const_RomMap.X68"
                            	     1: ; ------------------------------------------------------------------------------
                            	     2: ; ROM addresses
                            	     3: ; -This reserves ~512kb for the progam and ~1.5mb for resources
                            	     4: ; -The resource section could be expaded until the ROM hits ~4.2mb (3FFFFF)
                            	     5: ; -Expanding beyond $200000 means re-testing the save/load routine,
                            	     6: ;  in theory it should be fine but I didn't feel like messing with it for now
                            	     7: ; ------------------------------------------------------------------------------
                            	     8: ROM_ADDR_RESOURCES=$100000
                            	     9: ROM_ADDR_INSTRUMENTS=ROM_ADDR_END-SEG_SIZE_INSTRUMENTS
                            	    10: ROM_ADDR_END=$200000
                            	    11: ; ------------------------------------------------------------------------------
                            	    12: ; segment sizes
                            	    13: ; ------------------------------------------------------------------------------
                            	    14: SEG_SIZE_INSTRUMENTS=$186D
                            	    15: 

