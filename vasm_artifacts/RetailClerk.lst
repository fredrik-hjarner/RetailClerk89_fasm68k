                            	    34: 	include 'const_GameSettings.X68'

Source: "const_GameSettings.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; constants that effect how the looks and behaves
                            	     3: ;*******************************************************************************
                            	     4: 
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: ; these are effectively conditional compilation directives
                            	     7: ;-------------------------------------------------------------------------------
                            	     8: _DEBUG_=$0	; enable/disable debug mode
                            	     9: _EMULATOR_DIAGNOSTICS_=$0	; enable/disable emulator diagnostic mode
                            	    10: _SPRITE_TILE_DEBUG_=$0	; enable/disable debug sprite tiles
                            	    11: _SPRITE_COLLISION_=$0	; enable/disable collision between sprites
                            	    12: _ATGAMES_HACKS=$0	; enable/disable hacks for AtGames devices
                            	    13: 
                            	    14: ;-------------------------------------------------------------------------------
                            	    15: ; settings that effect the game speed that are changed often for debugging
                            	    16: ;-------------------------------------------------------------------------------
                            	    17: 	if	_DEBUG_
                            	    18: DIALOG_UPDATE_FREQUENCY=$0000	; how often to update dialog animation
                            	    19: SPRITE_MOVE_FREQUENCY=$0001 ; how many frames to wait between sprite moves
                            	    20: INTRO_SCREEN_COUNTER_START=$0001	; how long to display intro screens
                            	    21: FADE_FRAME_DELAY=$0001	; how many frames to wait between fade in/out
                            	    22: EVENT_FRAME_DELAY=$0008	; delay used for scripted event scene changes
                            	    23: LEGAL_SCREEN_LOOP=$0001	; how long to display the legal screen
                            	    24: CREDITS_SCREEN_LOOP=$0168	; how long to display the credits screen
                            	    25: 	else
                            	    26: DIALOG_UPDATE_FREQUENCY=$0002	; how often to update dialog animation
                            	    27: SPRITE_MOVE_FREQUENCY=$0001 ; how many frames to wait between sprite moves
                            	    28: INTRO_SCREEN_COUNTER_START=$001E	; how long to display intro screens
                            	    29: FADE_FRAME_DELAY=$0003	; how many frames to wait between fade in/out
                            	    30: EVENT_FRAME_DELAY=$0009	; delay used for scripted event scene changes
                            	    31: LEGAL_SCREEN_LOOP=$0100	; how long to display the legal screen
                            	    32: CREDITS_SCREEN_LOOP=$0258	; how long to display the credits screen
                            	    33: 	endif
                            	    34: 
                            	    35: ;-------------------------------------------------------------------------------
                            	    36: ; VDP/VRAM addresses
                            	    37: ;-------------------------------------------------------------------------------
                            	    38: ; these are based on registers 2,3,4,5,13 in data_VDPInit.X68
                            	    39: VDP_VRAM_WRITE_A=$40000003	; register 2
                            	    40: VDP_VRAM_WRITE_HSCROLL=$7C000002	; register 13
                            	    41: VDP_VRAM_WRITE_SPRITE=$78000002	; register 5
                            	    42: VDP_VRAM_WRITE_B=$60000003	; register 4
                            	    43: VDP_VRAM_WRITE_WINDOW=$60000002	; register 3
                            	    44: VDP_VRAM_WRITE_VSCROLL=$40000010	; vscroll write
                            	    45: ; relative VPD memory locations
                            	    46: SCENE_VDP=$0000	; write location for scene tiles
                            	    47: FONT_VDP=$1200	; write location for font tiles
                            	    48: SPRITE_VDP=$2200	; write location for sprite tiles
                            	    49: PLAYER_SPRITE_VDP=SPRITE_VDP+$0020	; write location for player sprite tiles
                            	    50: PLAYER_SPRITE_VDP_X=$780E0002	; player sprite x vdp
                            	    51: PLAYER_SPRITE_VDP_Y=$78080002	; player sprite y vdp
                            	    52: NPC0_SPRITE_VDP_X=PLAYER_SPRITE_VDP_X+$00080000	; npc0 sprite x vdp
                            	    53: NPC0_SPRITE_VDP_Y=PLAYER_SPRITE_VDP_Y+$00080000	; npc0 sprite y vdp
                            	    54: NPC1_SPRITE_VDP_X=NPC0_SPRITE_VDP_X+$00080000	; npc1 sprite x vdp
                            	    55: NPC1_SPRITE_VDP_Y=NPC0_SPRITE_VDP_Y+$00080000	; npc1 sprite y vdp
                            	    56: NPC2_SPRITE_VDP_X=NPC1_SPRITE_VDP_X+$00080000	; npc2 sprite x vdp
                            	    57: NPC2_SPRITE_VDP_Y=NPC1_SPRITE_VDP_Y+$00080000	; npc2 sprite y vdp
                            	    58: NPC3_SPRITE_VDP_X=NPC2_SPRITE_VDP_X+$00080000	; npc3 sprite x vdp
                            	    59: NPC3_SPRITE_VDP_Y=NPC2_SPRITE_VDP_Y+$00080000	; npc3 sprite y vdp
                            	    60: 
                            	    61: ;-------------------------------------------------------------------------------
                            	    62: ; SRAM addresses and save game settings
                            	    63: ;-------------------------------------------------------------------------------
                            	    64: SRAM_START=$200001	; SRAM start address
                            	    65: SRAM_END=$20FFFF	; SRAM end address
                            	    66: SRAM_LOCK=$A130F1	; address of lock bit
                            	    67: SAVE_SIZE=$2000	; max size of a save game slot
                            	    68: SAVE_GAME_START=MEM_OBJECTIVE	; start location of save game data
                            	    69: SAVE_GAME_END=MEM_ACTIVE_SCENE_EXIT_S	; end location of save game data
                            	    70: SAVE_DATA_LENGTH=SAVE_GAME_END-SAVE_GAME_START
                            	    71: 
                            	    72: ;-------------------------------------------------------------------------------
                            	    73: ; directions
                            	    74: ;-------------------------------------------------------------------------------
                            	    75: DIRECTION_DOWN=%0000	; 0
                            	    76: DIRECTION_UP=%0001		; 1
                            	    77: DIRECTION_LEFT=%0010	; 2
                            	    78: DIRECTION_RIGHT=%0011	; 3
                            	    79: DIRECTION_NULL=%1111	; used for movement patterns
                            	    80: 
                            	    81: ;-------------------------------------------------------------------------------
                            	    82: ; sprite settings
                            	    83: ;-------------------------------------------------------------------------------
                            	    84: SPRITE_BASE_PATTERN=$6110	; base pattern of sprites
                            	    85: SPRITE_TILESET_SIZE=$60	; the size of the tileset used for sprites
                            	    86: SPRITE_TILESET_LWORDS=SPRITE_TILESET_SIZE*LWORDS_PER_TILE	; lwords in tileset
                            	    87: DEFAULT_SPRITE_HEIGHT=$0020	; how many pixels tall a sprite is by default
                            	    88: DEFAULT_SPRITE_WIDTH=$0010	; how many pixels wide a sprite is by default
                            	    89: SPRITE_FRAME_COUNT=$0003	; how many animation frames there are for sprites
                            	    90: SPRITE_ANIMATION_STEPS=$0008	; how many steps between animation frame changes
                            	    91: SPRITE_STEP_PIXELS=$0001	; how many pixels to move on each sprite step
                            	    92: SPRITE_PLAYER_PATTERN=SPRITE_BASE_PATTERN+$1	; base pattern for player sprite
                            	    93: SPRITE_PLAYER_HEIGHT=DEFAULT_SPRITE_HEIGHT	; player sprite height
                            	    94: SPRITE_PLAYER_WIDTH=DEFAULT_SPRITE_WIDTH	; player sprite 
                            	    95: SPRITE_PLAYER_INIT_X=$0100	; starting x location of player sprite
                            	    96: SPRITE_PLAYER_INIT_Y=$0100	; starting y location of player sprite
                            	    97: SPRITE_DEF_WORD2_BASE=$0700	; width=16,height=32 - low byte has link field
                            	    98: ; used for sprite collision tests - top edge of bottom 1/2 of sprite
                            	    99: SPRITE_COLLISION_Y=(DEFAULT_SPRITE_HEIGHT-(DEFAULT_SPRITE_HEIGHT/2))
                            	   100: SPRITE_COLLISION_UP=SPRITE_STEP_PIXELS
                            	   101: SPRITE_COLLISION_DOWN=(DEFAULT_SPRITE_HEIGHT/2)+SPRITE_STEP_PIXELS
                            	   102: SPRITE_COLLISION_RIGHT=DEFAULT_SPRITE_WIDTH+SPRITE_STEP_PIXELS
                            	   103: SPRITE_COLLISION_LEFT=SPRITE_STEP_PIXELS
                            	   104: ; screen & plane sizes
                            	   105: SPRITE_PLANE_PIXELS_X=$0200	; width of sprite virtual plane
                            	   106: SPRITE_PLANE_PIXELS_Y=$0200	; height of sprite virtual plane
                            	   107: SPRITE_PLANE_OFFSET_TOP=$0080	; sprite plane top to display top edge
                            	   108: SPRITE_PLANE_OFFSET_LEFT=$0080	; sprite plane left to display left edge
                            	   109: SPRITE_PLANE_OFFSET_BOTTOM=$00A0	; sprite plane bottom to display bottom edge
                            	   110: SPRITE_PLANE_OFFSET_RIGHT=$0040	; sprite plane right to display right edge
                            	   111: ; other sprite/NPC settings
                            	   112: NPC_RECORD_SIZE=MEM_NPC1_SPRITE_ID-MEM_NPC0_SPRITE_ID
                            	   113: NPC_SPRITE_MOVE_STEPS=$0009; how many steps NPC sprites take when they move
                            	   114: PLAYER_BASE_TILE=%0110000100000001 ; pri=0,pal=2,vf=0,hf=0,pattern=101
                            	   115: NPC0_BASE_TILE=%0110000101110001 ;pri=0,pal=2,vf=0,hf=0,pattern=171
                            	   116: NPC_BASE_TILE_INC=$0060	; how many tiles to increment between NPCs
                            	   117: CHARACTER_DEFINITION_SIZE=CharacterDefinitionPlayerEnd-CharacterDefinitionPlayer
                            	   118: 
                            	   119: ;-------------------------------------------------------------------------------
                            	   120: ; dialog settings
                            	   121: ;-------------------------------------------------------------------------------
                            	   122: DIALOG_PATTERN_SIZE=$0124	; size of dialog pattern (#tiles*2+4 for loop ctrl)
                            	   123: DIALOG_BASE_TILE=$8090	; base tile for dialogs
                            	   124: DIALOG_BASE_TILE_LOW=$0090	; base tile for dialogs (low)
                            	   125: DIALOG_ROWCOL=$09100000	; row 18 column 16=(128*18)+16=2320=910
                            	   126: DIALOG_TEXT_AREA_ROWCOL=$0A900000	; DIALOG_ROWCOL + 3 rows
                            	   127: DIALOG_TEXT_ROWCOL=$0A920000	; DIALOG_ROWCOL + 3 rows + 1 column
                            	   128: DIALOG_TITLE_ROWCOL=$09940000	; DIALOG_ROWCOL + 1 row + 2 columns
                            	   129: DIALOG_FRAME_COUNT=$000B	; number of animation frames for dialogs
                            	   130: DIALOG_MENU_INIT_SELECTION_X=$C8	; x coordinate of initial menu selection
                            	   131: DIALOG_MENU_INIT_SELECTION_Y=$128	; y coordinate of initial menu selection
                            	   132: DIALOG_NO_RESPONSE=$FFFF	; no response or dialog cancelled 
                            	   133: 
                            	   134: ;-------------------------------------------------------------------------------
                            	   135: ; map settings
                            	   136: ;-------------------------------------------------------------------------------
                            	   137: MAP_MID_X=$100	; mid-point of map - used for collision detection
                            	   138: ; scene exit points
                            	   139: SCENE_EXIT_TOP=$0000+SPRITE_PLANE_OFFSET_TOP
                            	   140: SCENE_EXIT_BOTTOM=$00D0+SPRITE_PLANE_OFFSET_TOP
                            	   141: SCENE_EXIT_LEFT=$0000+SPRITE_PLANE_OFFSET_LEFT
                            	   142: SCENE_EXIT_RIGHT=$013A+SPRITE_PLANE_OFFSET_LEFT
                            	   143: ; position where the player enters a scene
                            	   144: SCENE_ENTER_TOP=SPRITE_PLANE_OFFSET_TOP+$0008
                            	   145: SCENE_ENTER_BOTTOM=SPRITE_PLANE_OFFSET_TOP+DISPLAY_PIXELS_Y-$0010
                            	   146: SCENE_ENTER_LEFT=SPRITE_PLANE_OFFSET_LEFT+$0008
                            	   147: SCENE_ENTER_RIGHT=SPRITE_PLANE_OFFSET_LEFT+DISPLAY_PIXELS_X-$0008
                            	   148: DEFAULT_COLLISION_DATA_SIZE=$7F	; 128 longs of collision data by default 
                            	   149: 
                            	   150: ;-------------------------------------------------------------------------------
                            	   151: ; object/NPC list settings
                            	   152: ;-------------------------------------------------------------------------------
                            	   153: OBJ_LIST_LENGTH=$000A	; max items in the object list
                            	   154: NPC_LIST_LENGTH=$0004	; max items in the NPC list
                            	   155: NPC_LIST_LOOP_CTRL=$0001	; (NPC_LIST_LENGTH/2)-1
                            	   156: OBJ_LIST_LOOP_CTRL=OBJ_LIST_LENGTH+NPC_LIST_LENGTH-1
                            	   157: OBJ_LIST_STRUCT_SIZE=$0006	; size of the data structure for object list entries
