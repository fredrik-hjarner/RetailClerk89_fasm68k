                            	    29: ;-------------------------------------------------------------------------------
                            	    30: MEM_NPC_LOOP_COUNTER=$FFFF0020	; used for loop control in main
                            	    31: ;-------------------------------------------------------------------------------
                            	    32: ; controller input
