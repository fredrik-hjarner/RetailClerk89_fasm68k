Source: "sub_BuildActionTableOffset.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; compute offset for action table lookups 
                            	     3: ;-------------------------------------------------------------------------------
                            	     4: BuildActionTableOffset:
00:00002A3C 3E39FFFF009A    	     5: 	move.w	MEM_DAY,d7
00:00002A42 CEFC0180        	     6: 	mulu.w	#SCENE_COUNT_X_ACTION_COUNT_X4,d7
00:00002A46 33C7FFFF0034    	     7: 	move.w	d7,(MEM_ACTION_TABLE_OFFSET)
00:00002A4C 3E39FFFF013E    	     8: 	move.w	MEM_ACTIVE_SCENE_ID,d7
00:00002A52 CEFC0010        	     9: 	mulu.w	#ACTION_COUNT_X4,d7
00:00002A56 DF79FFFF0034    	    10: 	add.w	d7,(MEM_ACTION_TABLE_OFFSET)
00:00002A5C 3E39FFFF002C    	    11: 	move.w	MEM_ACTION_ID,d7
00:00002A62 CEFC0004        	    12: 	mulu.w	#LWORD_SIZE,d7
00:00002A66 DF79FFFF0034    	    13: 	add.w	d7,(MEM_ACTION_TABLE_OFFSET)
00:00002A6C 4E75            	    14: 	rts
