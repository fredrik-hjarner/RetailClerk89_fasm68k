Source: "sub_InitNPCLocations.X68"
                            	     1: InitNPCLocations:
00:00002C1E 41F9FFFF0038    	     2: 	lea MEM_NPC_LOCATIONS,a0
00:00002C24 20FC03010200    	     3: 	move.l	#$03010200,(a0)+	; location 00 (VB) - NPCs 03,01,02
00:00002C2A 20FC00000000    	     4: 	move.l	#$00000000,(a0)+	; location 01 (WWHALL)
00:00002C30 20FC00000000    	     5: 	move.l	#$00000000,(a0)+	; location 02 (WEHALL)
00:00002C36 20FC041D0000    	     6: 	move.l	#$041D0000,(a0)+	; location 03 (CENTER)
00:00002C3C 20FC00000000    	     7: 	move.l	#$00000000,(a0)+	; location 04 (SHALL)
00:00002C42 20FC00000000    	     8: 	move.l	#$00000000,(a0)+	; location 05 (PARKINGLOT)
00:00002C48 20FC00000000    	     9: 	move.l	#$00000000,(a0)+	; location 06 (EWHALL)
00:00002C4E 20FC18000000    	    10: 	move.l	#$18000000,(a0)+	; location 07 (EEHALL)
00:00002C54 20FC05000000    	    11: 	move.l	#$05000000,(a0)+	; location 08 (DENIMCOUNTRY)
00:00002C5A 20FC06000000    	    12: 	move.l	#$06000000,(a0)+	; location 09 (CHECKERS)
00:00002C60 20FC07000000    	    13: 	move.l	#$07000000,(a0)+	; location 0A (TLODGE)
00:00002C66 20FC08000000    	    14: 	move.l	#$08000000,(a0)+	; location 0B (CAVERN)
00:00002C6C 20FC09000000    	    15: 	move.l	#$09000000,(a0)+	; location 0C (SVIDEO)
00:00002C72 20FC14150000    	    16: 	move.l	#$14150000,(a0)+	; location 0D (WORKSHOP)
00:00002C78 20FC0A000000    	    17: 	move.l	#$0A000000,(a0)+	; location 0E (NSHACK)
00:00002C7E 20FC0B000000    	    18: 	move.l	#$0B000000,(a0)+	; location 0F (POGODAWG)
00:00002C84 20FC0C000000    	    19: 	move.l	#$0C000000,(a0)+	; location 10 (CPLANET)
