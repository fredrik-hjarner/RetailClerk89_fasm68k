                            	    12: MEM_SPRITE_SORT_TABLE_VALUE0=$FFFF0008	; sort table value 0
                            	    13: MEM_SPRITE_SORT_TABLE_ID1=$FFFF000A	; sort table ID 1
                            	    14: MEM_SPRITE_SORT_TABLE_VALUE1=$FFFF000C	; sort table value 1
                            	    15: MEM_SPRITE_SORT_TABLE_ID2=$FFFF000E	; sort table ID 2
