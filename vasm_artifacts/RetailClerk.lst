Source: "sub_LoadPalettes.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; This sub-routine was based off examples noted in the CREDITS file.
                            	     3: ; The modifications I made were:
                            	     4: ; 	(1) Support for loading 1-4 palettes at a time
                            	     5: ;	(2) Making the write address a parameter
                            	     6: ;-------------------------------------------------------------------------------
                            	     7: 
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: ; LoadPalettes
                            	    10: ; loads 1-4 palettes into the VDP
                            	    11: ; a0 = address of first palette to load
                            	    12: ; d0 = number of palettes to load (1-4)
                            	    13: ; d1 = VDP write address
                            	    14: ;-------------------------------------------------------------------------------
                            	    15: LoadPalettes:
00:00000942 23C100C00004    	    16: 	move.l	d1,(VDP_CONTROL) ; set up VDP write to CRAM
00:00000948 C0FC0010        	    17: 	mulu	#$10,d0	; multiply number of palettes by 16
00:0000094C 5340            	    18: 	subq	#$01,d0	; subtract 1 since the loop counts to 0
                            	    19: LoadPalettesLoop:
00:0000094E 33D800C00000    	    20: 	move.w	(a0)+,(VDP_DATA)	; write the palette data
00:00000954 51C8FFF8        	    21: 	dbf	d0,LoadPalettesLoop		; decrement value of d0 and loop if not 0
00:00000958 4E75            	    22: 	rts
                            	    23: 

Source: "inc_Subroutines.X68"
                            	     3: 
                            	     4: 	include	'sub_ReadJoypads.X68'

Source: "sub_ReadJoypads.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; These sub-routines are not entirely my original code.
                            	     3: ; This are based off various samples available online (see credits file).
                            	     4: ; I made some modifications but probably not enough to qualify as original work.
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: ReadJoypads:
00:0000095A 46FC2700        	     7: 	move.w	#$2700,sr		; disable interrupts
00:0000095E 41F900A10003    	     8: 	lea	CTRL_1_DATA,a0		; load address to read controller 1 data
00:00000964 6106            	     9: 	bsr.s	ReadJoypad		; read first joypad
                            	    10: 	; code to read second joypad, not used for this demo
                            	    11: 	; addq.w	#2,a0		; switch to second joypad data
                            	    12: 	; bsr.s	ReadJoypad		; read second joypad
00:00000966 46FC2000        	    13: 	move.w	#$2000,sr		; re-enable interrupts
00:0000096A 4E75            	    14: 	rts
                            	    15: 	
                            	    16: ReadJoypad:
00:0000096C 10BC0000        	    17: 	move.b	#0,(a0)		; read joypad data port
00:00000970 4E71            	    18: 	nop					; bus synchronization
00:00000972 4E71            	    19: 	nop					; bus synchronization
00:00000974 1210            	    20: 	move.b	(a0),d1		; get joypad data - Start/A
00:00000976 E549            	    21: 	lsl.w	#2,d1		; shift them so they are at the 2 highest bits
00:00000978 10BC0040        	    22: 	move.b	#$40,(a0)	; read joypad data port again
00:0000097C 4E71            	    23: 	nop					; bus synchronization
00:0000097E 4E71            	    24: 	nop					; bus synchronization
00:00000980 1010            	    25: 	move.b	(a0),d0		; get joypad data - C/B/Dpad
00:00000982 0200003F        	    26: 	andi.b	#$3F,d0		; C/B/Dpad in low 6 bits
00:00000986 020100C0        	    27: 	andi.b	#$C0,d1		; Start/A in high 2 bits
00:0000098A 8001            	    28: 	or.b	d1,d0		; merge values from both registers
00:0000098C 4600            	    29: 	not.b	d0			; flip bits so 0 means not pressed, and 1 means pressed
00:0000098E 1200            	    30: 	move.b	d0,d1		; copy current buttons to d1
00:00000990 1439FFFF0022    	    31: 	move.b	(MEM_CONTROL_HELD),d2		; copy the last previously read buttons
00:00000996 B500            	    32: 	eor.b	d2,d0		; flip buttons being pressed now
00:00000998 13C1FFFF0022    	    33: 	move.b	d1,(MEM_CONTROL_HELD)	; store held buttons
00:0000099E C001            	    34: 	and.b	d1,d0		; AND with current buttons
00:000009A0 13C0FFFF0024    	    35: 	move.b	d0,(MEM_CONTROL_PRESSED)	; store pressed buttons
00:000009A6 4E75            	    36: 	rts
                            	    37: 

Source: "inc_Subroutines.X68"
                            	     5: 
                            	     6: 	include	'sub_LoadTiles.X68'

Source: "sub_LoadTiles.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; This sub-routine was based off examples noted in the CREDITS file.
                            	     3: ; The main modification I made was making the VDP write address a parameter.
                            	     4: ;-------------------------------------------------------------------------------
                            	     5: 
                            	     6: ;-------------------------------------------------------------------------------
                            	     7: ; LoadTiles
                            	     8: ; loads tiles into the VDP
                            	     9: ; a0 = address of first tile to load
                            	    10: ; d0 = number of tiles to load
                            	    11: ; d1 = VDP write address
                            	    12: ;-------------------------------------------------------------------------------
                            	    13: LoadTiles:
00:000009A8 5340            	    14: 	subq	#$01,d0	; iterate over ((number of tiles to load) - 1)
00:000009AA 23C100C00004    	    15: 	move.l	d1,(VDP_CONTROL)	; set address for VDP write
                            	    16: LoadTilesLoop:
00:000009B0 23D800C00000    	    17: 	move.l (a0)+,(VDP_DATA)	; move data to VDP & increment address
00:000009B6 51C8FFF8        	    18: 	dbra d0,LoadTilesLoop	; loop until all data is loaded
00:000009BA 4E75            	    19: 	rts
                            	    20: 

Source: "inc_Subroutines.X68"
                            	     7: 
                            	     8: 	include	'sub_DrawTileset.X68'

Source: "sub_DrawTileset.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; This sub-routine was based off examples noted in the CREDITS file.
                            	     3: ; The modifications include:
                            	     4: ;	-Converting example code into a parameterized function
                            	     5: ;	-Support for patterns and repeating patterns
                            	     6: ;-------------------------------------------------------------------------------
                            	     7: 
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: ; DrawTileset
                            	    10: ; draws a set of tiles 
                            	    11: ; Parameters
                            	    12: ; a0 = starting address of tileset
                            	    13: ; a1 = initial VRAM write address
                            	    14: ; d0 = base pattern (ID+palette+high/low) of first tile in the tileset
                            	    15: ; d1 = number of times to repeat the pattern
                            	    16: ; other registers used
                            	    17: ; a2 = used to reference current VRAM write address
                            	    18: ; d2 = number of rows in the tileset
                            	    19: ; d3 = number of columns in the tileset 
                            	    20: ; d4 = used to store the VDP pattern 
                            	    21: ; d5 = loop counter
                            	    22: ; d6 = loop counter
                            	    23: ;-------------------------------------------------------------------------------
                            	    24: DrawTileset:
00:000009BC 3418            	    25: 	move.w	(a0)+,d2	; store the number of rows
00:000009BE 3618            	    26: 	move.w	(a0)+,d3	; store the number of columns
                            	    27: DrawTilesetOuterLoop:
00:000009C0 2448            	    28: 	movea.l	a0,a2	; reset a2 to starting address
00:000009C2 3A02            	    29: 	move.w	d2,d5	; reset d5 to store the number of rows to loop over
                            	    30: DrawTilesetRowLoop:
00:000009C4 3C03            	    31: 	move.w	d3,d6	; reset d6 to store the number of columns to loop over
00:000009C6 23C900C00004    	    32: 	move.l	a1,(VDP_CONTROL)	; set VDP address
                            	    33: DrawTilesetColumnLoop:
00:000009CC 381A            	    34: 	move.w	(a2)+,d4	; store the next tile index in d4
00:000009CE D840            	    35: 	add.w	d0,d4	; add base tile ID to tile index
                            	    36: 	; draw the tile
00:000009D0 33C400C00000    	    37: 	move.w  d4,(VDP_DATA)	; copy the pattern to VPD
00:000009D6 51CEFFF4        	    38: 	dbf	d6,DrawTilesetColumnLoop	; decrement value of d6 (column) and loop 
00:000009DA D3FC00800000    	    39: 	adda.l	#ROW_HEIGHT,a1	; move to the next row
00:000009E0 51CDFFE2        	    40: 	dbf	d5,DrawTilesetRowLoop	; decrement value of d5 (row) and loop
00:000009E4 51C9FFDA        	    41: 	dbf	d1,DrawTilesetOuterLoop	; decrement value of d1 (repeat) and loop
00:000009E8 4E75            	    42: 	rts
                            	    43: 

Source: "inc_Subroutines.X68"
                            	     9: 
                            	    10: 	include	'sub_ClearVRAM.X68'

Source: "sub_ClearVRAM.X68"
                            	     1: ClearVRAM:
00:000009EA 23FC4000000000C0	     2: 	move.l	#VDP_VRAM_WRITE,(VDP_CONTROL) 
00:000009F2 0004
00:000009F4 323C7FFF        	     3: 	move.w	#$7FFF,d1
                            	     4: ClearVRAMLoop:
00:000009F8 33FC000000C00000	     5: 	move.w	#$0000,(VDP_DATA)
00:00000A00 51C9FFF6        	     6: 	dbra	d1,ClearVRAMLoop
00:00000A04 4E75            	     7: 	rts
                            	     8: 

Source: "inc_Subroutines.X68"
                            	    11: 
                            	    12: 	include 'sub_SaveLoad.X68'

Source: "sub_SaveLoad.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; Basic code to write to SRAM from: https://plutiedev.com/saving-sram
                            	     3: ;*******************************************************************************
                            	     4: 
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: ; Saves the current game state
                            	     7: ; -location is based on MEM_MENU_SELECTION
                            	     8: ; -in the save screen the index for save is 0-3
                            	     9: ; -save everything from MEM_GAME_STATE to MEM_ACTIVE_SCENE_ID
                            	    10: ; -~8kb is the current size limit for save games in this demo
                            	    11: ; a4, a5, d7 are all modified by this routine
                            	    12: ;-------------------------------------------------------------------------------
                            	    13: SaveGame:
                            	    14: 	; compute which save slot to use
00:00000A06 4287            	    15: 	clr.l	d7	; just being paranoid
00:00000A08 3E39FFFF0222    	    16: 	move.w	(MEM_MENU_SELECTION),d7	; copy menu selection to d7
00:00000A0E CEFC2000        	    17: 	mulu.w	#SAVE_SIZE,d7	; copy by save size
00:00000A12 4BF900200001    	    18: 	lea	(SRAM_START),a5	; point a5 to the start of SRAM
00:00000A18 DAC7            	    19: 	adda.w	d7,a5	; move to offset location
00:00000A1A 13FC000100A130F1	    20: 	move.b	#1,(SRAM_LOCK)	; unlock SRAM
00:00000A22 49F9FFFF0026    	    21: 	lea	(SAVE_GAME_START),a4	; point to start of game state
00:00000A28 3E3C011A        	    22: 	move.w	#SAVE_DATA_LENGTH,d7	; size of data to read
                            	    23: SaveLoop:
00:00000A2C 1A94            	    24: 	move.b	(a4),(a5)	; write byte to SRAM
00:00000A2E 528C            	    25: 	addq.l  #1,a4	; advance read byte
00:00000A30 548D            	    26: 	addq.l  #2,a5	; advance write byte
00:00000A32 51CFFFF8        	    27: 	dbf	d7,SaveLoop	; loop
                            	    28: SaveLoopEnd:
00:00000A36 13FC000000A130F1	    29: 	move.b	#0,(SRAM_LOCK)	; lock SRAM
00:00000A3E 4E75            	    30: 	rts
                            	    31: 
                            	    32: ;-------------------------------------------------------------------------------
                            	    33: ; Loads a saved game
                            	    34: ; -location is based on MEM_MENU_SELECTION
                            	    35: ; -in the load screen the index for save is 0-3
                            	    36: ; a4, a5, d7 are all modified by this routine
                            	    37: ;-------------------------------------------------------------------------------
                            	    38: LoadGame:
                            	    39: 	; compute which save slot to use
00:00000A40 4287            	    40: 	clr.l	d7	; just being paranoid
00:00000A42 3E39FFFF0222    	    41: 	move.w	(MEM_MENU_SELECTION),d7	; copy menu selection to d7
00:00000A48 CEFC2000        	    42: 	mulu.w	#SAVE_SIZE,d7	; copy by save size
00:00000A4C 4BF900200001    	    43: 	lea	(SRAM_START),a5	; point a5 to the start of SRAM
00:00000A52 DAC7            	    44: 	adda.w	d7,a5	; move to offset location
00:00000A54 13FC000100A130F1	    45: 	move.b	#1,(SRAM_LOCK)	; unlock SRAM
00:00000A5C 49F9FFFF0026    	    46: 	lea	(SAVE_GAME_START),a4	; point to start of game state
00:00000A62 3E3C011A        	    47: 	move.w	#SAVE_DATA_LENGTH,d7	; size of data to read
                            	    48: LoadLoop:
00:00000A66 1895            	    49: 	move.b	(a5),(a4)	; read byte from SRAM
00:00000A68 528C            	    50: 	addq.l  #1,a4	; advance write byte
00:00000A6A 548D            	    51: 	addq.l  #2,a5	; advance read byte
00:00000A6C 51CFFFF8        	    52: 	dbf	d7,LoadLoop	; loop
                            	    53: LoadLoopEnd:
00:00000A70 13FC000000A130F1	    54: 	move.b	#0,(SRAM_LOCK)	; lock SRAM
                            	    55: 	; the game is saved from the status screen, need to clear that
00:00000A78 2E39FFFF0028    	    56: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:00000A7E 0887000A        	    57: 	bclr.l	#STATE_FLAG_STATUS_SCREEN,d7	; update game state
00:00000A82 23C7FFFF0028    	    58: 	move.l	d7,(MEM_GAME_STATE)	; save updated game state
00:00000A88 4E75            	    59: 	rts
                            	    60: 
                            	    61: ;-------------------------------------------------------------------------------
                            	    62: ; checks if SRAM has been initialized, initializes it if not
                            	    63: ; a5, d6, d7 are all modified by this routine
                            	    64: ;-------------------------------------------------------------------------------
                            	    65: InitSRAM:
00:00000A8A 46FC2700        	    66: 	move.w	#$2700,sr		; disable interrupts
00:00000A8E 13FC000100A130F1	    67: 	move.b	#1,(SRAM_LOCK)	; unlock SRAM
00:00000A96 49F9FFFF0248    	    68:     lea	(MEM_TEMP_SPACE),a4	; point a4 to temp space
00:00000A9C 4246            	    69: 	clr	d6	; just being paranoid
00:00000A9E 3C3C0004        	    70: 	move.w	#$0004,d6	; 4 save slots, init check is after the last
00:00000AA2 CCFC2000        	    71: 	mulu.w	#SAVE_SIZE,d6	; copy by save size
00:00000AA6 4BF900200001    	    72: 	lea	(SRAM_START),a5	; point a5 to the start of SRAM
00:00000AAC DBC6            	    73: 	adda.l	d6,a5	; move to offset location
00:00000AAE 1895            	    74:     move.b	(a5),(a4)	; write byte to temp space
00:00000AB0 528C            	    75:     addq.l	#1,a4	; advance write byte
00:00000AB2 548D            	    76:     addq.l	#2,a5	; advance read byte
00:00000AB4 1895            	    77:     move.b	(a5),(a4)	; write next byte to temp space
00:00000AB6 2E39FFFF0248    	    78: 	move.l	(MEM_TEMP_SPACE),d7	; copy temp value to d7
00:00000ABC 4847            	    79: 	swap	d7	; swap d7
00:00000ABE 0C478989        	    80: 	cmpi.w	#$8989,d7	; test if it matches the expected init value
00:00000AC2 6734            	    81: 	beq.s	ExitInitSRAM	; branch if it does
                            	    82: 	; write init data
00:00000AC4 4BF900200001    	    83: 	lea	(SRAM_START),a5	; point a5 to the start of SRAM
00:00000ACA DBC6            	    84: 	adda.l	d6,a5	; move to offset location
00:00000ACC 1ABC0089        	    85: 	move.b	#$89,(a5)	; first half of word
00:00000AD0 548D            	    86: 	addq.l  #2,a5	; advance write byte
00:00000AD2 1ABC0089        	    87: 	move.b	#$89,(a5)	; second half of word
                            	    88: 	; initialize the four save slots
00:00000AD6 3E3C0003        	    89: 	move.w	#$0003,d7	; four save slots to loop through
00:00000ADA 4286            	    90: 	clr.l	d6	; just being paranoid again
                            	    91: InitSRAMLoop:
00:00000ADC 3C07            	    92: 	move.w	d7,d6	; copy d7 to d6
00:00000ADE CCFC2000        	    93: 	mulu.w	#SAVE_SIZE,d6	; copy by save size
00:00000AE2 4BF900200001    	    94: 	lea	(SRAM_START),a5	; point a5 to the start of SRAM
00:00000AE8 DBC6            	    95: 	adda.l	d6,a5	; move to offset location
00:00000AEA 1ABC007F        	    96: 	move.b	#$7F,(a5)	; first half of word
00:00000AEE 548D            	    97: 	addq.l  #2,a5	; advance write byte
00:00000AF0 1ABC00FF        	    98: 	move.b	#$FF,(a5)	; second half of word
00:00000AF4 51CFFFE6        	    99: 	dbf	d7,InitSRAMLoop	; loop
                            	   100: ExitInitSRAM:
00:00000AF8 13FC000000A130F1	   101: 	move.b	#0,(SRAM_LOCK)	; lock SRAM
00:00000B00 46FC2000        	   102: 	move.w	#$2000,sr		; re-enable interrupts
00:00000B04 4E75            	   103: 	rts
                            	   104: 
                            	   105: ;-------------------------------------------------------------------------------
                            	   106: ; returns the first word in a save slot
                            	   107: ; d7 = save slot index
                            	   108: ; d6 will return the value of the first word at the specified save slto
                            	   109: ; a5 is modified by this subroutine
                            	   110: ;-------------------------------------------------------------------------------
                            	   111: SaveGameLookup:
00:00000B06 46FC2700        	   112: 	move.w	#$2700,sr	; disable interrupts
00:00000B0A 13FC000100A130F1	   113:     move.b  #1,(SRAM_LOCK)	; unlock SRAM
00:00000B12 49F9FFFF0248    	   114: 	lea	(MEM_TEMP_SPACE),a4	; point a4 to temp space
00:00000B18 CEFC2000        	   115: 	mulu.w	#SAVE_SIZE,d7	; d7 should have the save slot number
00:00000B1C 4BF900200001    	   116:     lea	(SRAM_START),a5	; point a5 to start of SRAM
00:00000B22 DBC7            	   117: 	adda.l	d7,a5	; move to offset location
00:00000B24 1895            	   118:     move.b	(a5),(a4)	; write byte to temp space
00:00000B26 528C            	   119:     addq.l	#1,a4	; advance write byte
00:00000B28 548D            	   120:     addq.l	#2,a5	; advance read byte
00:00000B2A 1895            	   121:     move.b	(a5),(a4)	; write next byte to temp space
00:00000B2C 13FC000000A130F1	   122:     move.b  #0,(SRAM_LOCK)   ; lock SRAM
00:00000B34 2C39FFFF0248    	   123: 	move.l	(MEM_TEMP_SPACE),d6	; copy temp value to d6
00:00000B3A 4846            	   124: 	swap	d6	; swap to low word
00:00000B3C 46FC2000        	   125: 	move.w	#$2000,sr		; re-enable interrupts
00:00000B40 4E75            	   126: 	rts
                            	   127: 
                            	   128: 

Source: "inc_Subroutines.X68"
                            	    13: 
                            	    14: 	include	'sub_ProcessLoadScreen.X68'

Source: "sub_ProcessLoadScreen.X68"
                            	     1: ProcessLoadScreen:
                            	     2: 	; process b press
00:00000B42 1C39FFFF0024    	     3: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:00000B48 02060010        	     4: 	andi.b	#BUTTON_B_PRESSED,d6	; test if the start button was pressed
00:00000B4C 670C            	     5: 	beq.s	ProcessLoadScreenTestStart	; b not pressed, branch
00:00000B4E 33FC0000FFFF0222	     6: 	move.w	#$0000,(MEM_MENU_SELECTION)	; prevents a bug on the title screen
00:00000B56 6000F726        	     7: 	bra.w	NewGame	; kick-off new game out of laziness
                            	     8: ProcessLoadScreenTestStart:
                            	     9: 	; process start press
00:00000B5A 1C39FFFF0024    	    10: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:00000B60 02060080        	    11: 	andi.b	#BUTTON_START_PRESSED,d6	; test if the start button was pressed
00:00000B64 67000020        	    12: 	beq.w	ProcessLoadScreenTestDpad	; start not pressed, branch
                            	    13: 	; make sure this is a valid save game
00:00000B68 3E39FFFF0222    	    14: 	move.w	(MEM_MENU_SELECTION),d7	; lookup if this is a valid save slot
00:00000B6E 6100FF96        	    15: 	bsr.w	SaveGameLookup	; get save title into d6
00:00000B72 0C460017        	    16: 	cmpi.w	#MAX_OBJECTIVE,d6	; is this > MAX_OBJECTIVE?
00:00000B76 6E0000BA        	    17: 	bgt.w	ExitProcessProcessLoadScreen	; exit if bad save game
                            	    18: 	;---------------------------------------------------------------------------	
                            	    19: 	; load game	
                            	    20: 	;---------------------------------------------------------------------------	
00:00000B7A 6100FEC4        	    21: 	bsr.w	LoadGame	;	load the game from SRAM
00:00000B7E 61001380        	    22: 	bsr.w	ReloadCurrentScene	; reload current scene (needed to fix sprites)
00:00000B82 6000F84A        	    23: 	bra.w	MainGameLoop	;	return to start of game loop	
                            	    24: ProcessLoadScreenTestDpad:
                            	    25: 	; process dpad press
00:00000B86 1C39FFFF0024    	    26: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:00000B8C 02060001        	    27: 	andi.b	#BUTTON_UP_PRESSED,d6	; test if the up button was pressed
00:00000B90 664A            	    28: 	bne.s	ProcessLoadScreenDecrementSelector	; up pressed, branch
00:00000B92 1C39FFFF0024    	    29: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:00000B98 02060002        	    30: 	andi.b	#BUTTON_DOWN_PRESSED,d6	; test if the down button was pressed
00:00000B9C 661C            	    31: 	bne.s	ProcessLoadScreenIncrementSelector	; down pressed, branch
00:00000B9E 1C39FFFF0024    	    32: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:00000BA4 02060004        	    33: 	andi.b	#BUTTON_LEFT_PRESSED,d6	; test if the left button was pressed
00:00000BA8 6632            	    34: 	bne.s	ProcessLoadScreenDecrementSelector	; left pressed, branch
00:00000BAA 1C39FFFF0024    	    35: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:00000BB0 02060008        	    36: 	andi.b	#BUTTON_RIGHT_PRESSED,d6	; test if the right button was pressed
00:00000BB4 6604            	    37: 	bne.s	ProcessLoadScreenIncrementSelector	; right pressed, branch
00:00000BB6 60000046        	    38: 	bra.w	ProcessLoadScreenMoveSelector
                            	    39: ProcessLoadScreenIncrementSelector:
00:00000BBA 0C790003FFFF0222	    40: 	cmpi.w	#$003,(MEM_MENU_SELECTION)
00:00000BC2 660C            	    41: 	bne.s	.1
00:00000BC4 33FC0000FFFF0222	    42: 	move.w	#$0000,(MEM_MENU_SELECTION)
00:00000BCC 60000030        	    43: 	bra.w	ProcessLoadScreenMoveSelector
                            	    44: .1
00:00000BD0 06790001FFFF0222	    45: 	add.w	#$0001,(MEM_MENU_SELECTION)
00:00000BD8 60000024        	    46: 	bra.w	ProcessLoadScreenMoveSelector
                            	    47: ProcessLoadScreenDecrementSelector:
00:00000BDC 0C790000FFFF0222	    48: 	cmpi.w	#$0000,(MEM_MENU_SELECTION)
00:00000BE4 660C            	    49: 	bne.s	.1
00:00000BE6 33FC0003FFFF0222	    50: 	move.w	#$003,(MEM_MENU_SELECTION)
00:00000BEE 6000000E        	    51: 	bra.w	ProcessLoadScreenMoveSelector
                            	    52: .1
00:00000BF2 04790001FFFF0222	    53: 	sub.w	#$0001,(MEM_MENU_SELECTION)
00:00000BFA 60000002        	    54: 	bra.w	ProcessLoadScreenMoveSelector
                            	    55: ProcessLoadScreenMoveSelector:
                            	    56: 	; move selector sprite based on menu selection
00:00000BFE 3E39FFFF0222    	    57: 	move.w	(MEM_MENU_SELECTION),d7	; copy current value to d7
00:00000C04 CEFC0008        	    58: 	mulu.w	#$0008,d7	; rows are 8 apart
00:00000C08 DE7C00F8        	    59: 	add.w	#$00F8,d7	; first row is F8
00:00000C0C 2C3C78000002    	    60: 	move.l	#VDP_VRAM_WRITE_SPRITE,d6	; add to sprite table address
00:00000C12 23C600C00004    	    61: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00000C18 33C700C00000    	    62: 	move.w	d7,(VDP_DATA)	; copy the new y-coordinate
00:00000C1E DCBC00060000    	    63: 	add.l	#$00060000,d6	; move to x-coordinate
00:00000C24 23C600C00004    	    64: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00000C2A 33FC00C800C00000	    65: 	move.w	#$00C8,(VDP_DATA)	; copy the new x-coordinate
                            	    66: ExitProcessProcessLoadScreen:
00:00000C32 6000F79A        	    67: 	bra.w	MainGameLoop
                            	    68: 

Source: "inc_Subroutines.X68"
                            	    15: 
                            	    16: 	include	'sub_BuildLoadScreen.X68'

Source: "sub_BuildLoadScreen.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; yes, I realize there is a lot of duplicate code between this and
                            	     3: ; sub_BuildStatusScreen - maybe I'll clean that up one day
                            	     4: ;-------------------------------------------------------------------------------
                            	     5: BuildLoadScreen:
00:00000C36 46FC2700        	     6: 	move.w	#$2700,sr		; disable interrupts
00:00000C3A 3A3C0003        	     7: 	move.w	#$0003,d5	; three save slots
                            	     8: BuildLoadScreenLoop:
00:00000C3E 3E05            	     9: 	move.w	d5,d7	; d7 gets modified by SaveGameLookup
00:00000C40 6100FEC4        	    10: 	bsr.w	SaveGameLookup	; get save title into d6
00:00000C44 0C460017        	    11: 	cmpi.w	#MAX_OBJECTIVE,d6	; is this > MAX_OBJECTIVE?
00:00000C48 6E000012        	    12: 	bgt	.empty
                            	    13: 	; lookup text
00:00000C4C CCFC0004        	    14: 	mulu.w	#LWORD_SIZE,d6	; multiply by LWORD_SIZE to get offset
00:00000C50 4BF90001CD52    	    15: 	lea	SaveGameTitles,a5	; point a5 to the lookup table
00:00000C56 DBC6            	    16: 	adda.l	d6,a5	; move to offset
00:00000C58 2055            	    17: 	move.l	(a5),a0	; point a0 to the first character
00:00000C5A 6006            	    18: 	bra.s	.buildtext
                            	    19: .empty
00:00000C5C 41F90011264F    	    20: 	lea	StatusScreenEmptySave,a0	; use text for empty save slot
                            	    21: .buildtext
00:00000C62 2E3C67940003    	    22: 	move.l	#LOAD_SCREEN_SAVE0_VDP,d7	; point d7 to first line
00:00000C68 4246            	    23: 	clr	d6	; lazy way to prevent various bugs
00:00000C6A 3C3C0080        	    24: 	move.w	#$0080,d6	; using d6 to compute row
00:00000C6E CCC5            	    25: 	mulu.w	d5,d6	; multiply by current save slot
00:00000C70 4846            	    26: 	swap	d6	; move to high word
00:00000C72 DE86            	    27: 	add.l	d6,d7	; add offset to d7
00:00000C74 23C7FFFF0232    	    28: 	move.l	d7,(MEM_DIALOG_VDP)
                            	    29: DrawSaveTitleLoop:
00:00000C7A 4246            	    30: 	clr	d6	; lazy way to prevent various bugs
00:00000C7C 1C18            	    31: 	move.b	(a0)+,d6	; copy current character to d6
00:00000C7E 0C060003        	    32: 	cmpi.b	#ETX,d6	; is this the end of the text?
00:00000C82 6726            	    33: 	beq.s	DrawSaveTitleLoopExit	; end of text, move on
                            	    34: 	; update d6 to point to the tile ID
00:00000C84 9C7C0020        	    35: 	sub.w	#$20,d6	; subtract 32 to get the character index
00:00000C88 DC7C8090        	    36: 	add.w	#DIALOG_BASE_TILE_LOW+%1000000000000000,d6	; add the base tile
00:00000C8C 23F9FFFF023200C0	    37: 	move.l	(MEM_DIALOG_VDP),(VDP_CONTROL)	; set VDP address
00:00000C94 0004
00:00000C96 33C600C00000    	    38: 	move.w  d6,(VDP_DATA)	; copy the character to VDP
                            	    39: 	; draw the next character
00:00000C9C 06B900020000FFFF	    40: 	add.l	#$00020000,(MEM_DIALOG_VDP)	; move to the next column
00:00000CA4 0232
00:00000CA6 6000FFD2        	    41: 	bra.w	DrawSaveTitleLoop ; loop until ETX
                            	    42: DrawSaveTitleLoopExit:
00:00000CAA 51CDFF92        	    43: 	dbf	d5,BuildLoadScreenLoop ; loop
                            	    44: ExitBuildLoadScreen:
00:00000CAE 46FC2000        	    45: 	move.w	#$2000,sr	; re-enable interrupts
00:00000CB2 4E75            	    46: 	rts
                            	    47: 
                            	    48: 

Source: "inc_Subroutines.X68"
                            	    17: 
                            	    18: 	include	'sub_BuildStatusScreen.X68'

Source: "sub_BuildStatusScreen.X68"
                            	     1: BuildStatusScreen:
                            	     2: 	;---------------------------------------------------------------------------
                            	     3: 	; load sprite zero
