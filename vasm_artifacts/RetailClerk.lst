                            	   338: ;****************************************************************************
                            	   339: ; Echo_SetVolumeEx
                            	   340: ; Changes the global volume for each individual channel.
                            	   341: ;
                            	   342: ; input a0.l ... Pointer to 13 bytes
                            	   343: ;                  8 bytes with FM volumes (0..127)
                            	   344: ;                  4 bytes with PSG volumes (0..15)
                            	   345: ;                  1 byte with PCM toggle (0/1)
                            	   346: ;****************************************************************************
                            	   347: 
                            	   348: Echo_SetVolumeEx:
                            	   349:     Echo_Z80Request                 ; We need the Z80 bus
00:00009DAC 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000095:
00:00009DB4 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009DBC 66F6            	     4M     bne.s   @Echo_WaitZ80_000095         ; Keep waiting
00:00009DBE 48E700C0        	   350:     movem.l a0-a1, -(sp)            ; Save registers
                            	   351:     
00:00009DC2 43F900A01FE0    	   352:     lea     ($A01FE0), a1           ; Copy new volume values
00:00009DC8 12D8            	   353:     move.b  (a0)+, (a1)+              ; FM channel 0
00:00009DCA 12D8            	   354:     move.b  (a0)+, (a1)+              ; FM channel 1
00:00009DCC 12D8            	   355:     move.b  (a0)+, (a1)+              ; FM channel 2
00:00009DCE 12D8            	   356:     move.b  (a0)+, (a1)+              ; FM channel 3
00:00009DD0 12D8            	   357:     move.b  (a0)+, (a1)+              ; FM channel 4
00:00009DD2 12D8            	   358:     move.b  (a0)+, (a1)+              ; FM channel 5
00:00009DD4 12D8            	   359:     move.b  (a0)+, (a1)+              ; FM channel 6
00:00009DD6 12D8            	   360:     move.b  (a0)+, (a1)+              ; FM channel 7
00:00009DD8 12D8            	   361:     move.b  (a0)+, (a1)+              ; PSG channel 0
00:00009DDA 12D8            	   362:     move.b  (a0)+, (a1)+              ; PSG channel 1
00:00009DDC 12D8            	   363:     move.b  (a0)+, (a1)+              ; PSG channel 2
00:00009DDE 12D8            	   364:     move.b  (a0)+, (a1)+              ; PSG channel 3
