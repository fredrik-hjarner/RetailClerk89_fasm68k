                            	    59: 	include 'init_MDInit.X68'

Source: "init_MDInit.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; initialization
                            	     3: ;*******************************************************************************
                            	     4: 		
                            	     5: Start:
                            	     6: 
00:00000200 46FC2700        	     7: 	move.w	#$2700,sr		; disable interrupts
                            	     8: 
                            	     9: SecurityCheck:
00:00000204 103900A10001    	    10: 	move.b	(REG_HWVERSION),d0	; get the hardware version
00:0000020A 0200000F        	    11: 	andi.b	#$0F,d0				; the last four bits contains the version
00:0000020E 670A            	    12: 	beq.b	SkipSecurity		; skip the next instruction on v1 hardware
00:00000210 23FC5345474100A1	    13: 	move.l	#'SEGA',(REG_TMS)	; otherwise copy 'SEGA' to TMS register
00:00000218 4000
                            	    14: SkipSecurity:
                            	    15: 
                            	    16: 	if _ATGAMES_HACKS
                            	    17:     ; AtGames audio fix
                            	    18: 	; https://bigevilcorporation.co.uk/2018/04/18/taming-the-atgames-firecore/
                            	    19: 	move.w #$FFFF,($00000000)  ; Latch 0x0000
                            	    20: 	move.b #$78,($00B00018)    ; Write new PSG frequency
                            	    21: 	move.b #$26,($00B01054)    ; Write new FM frequency
                            	    22: 	move.b #$20,($00B01055)    ; Write new FM clock
                            	    23: 	move.w #$FFF7,($00000000)  ; Latch 0x0000
                            	    24: 	endif
                            	    25: 
                            	    26: InitController:
00:0000021A 13FC004000A10009	    27: 	move.b	#$40,(CTRL_1_CONTROL)
00:00000222 13FC004000A10003	    28: 	move.b	#$40,(CTRL_1_DATA)
                            	    29: 
                            	    30: InitVDP:
00:0000022A 41F90000B39A    	    31: 	lea	(VDPInitDataStart),a0	; load the address of the VDP init data to a0
00:00000230 323C0018        	    32: 	move.w	#(VDPInitDataEnd-VDPInitDataStart)/2,d1	; length of init data to d1
                            	    33: InitVDPDataLoop:
00:00000234 33D800C00004    	    34: 	move.w	(a0)+,(VDP_CONTROL)	; write the init data
00:0000023A 51C9FFF8        	    35: 	dbf	d1,InitVDPDataLoop		; decrement value of d1 and loop if not 0
                            	    36: 
                            	    37: ClearCRAM:
00:0000023E 23FCC000000000C0	    38: 	move.l	#VDP_CRAM_WRITE,(VDP_CONTROL); set VDP ctrl to CRAM write
00:00000246 0004
00:00000248 323C003F        	    39: 	move.w	#$003f,d1	; 3f = 63 = (64 palettes in CRAM - 1)
                            	    40: ClearCRAMLoop:
                            	    41: 	if _DEBUG_
                            	    42: 	move.w	#$FFFF,(VDP_DATA)
                            	    43: 	else
00:0000024C 33FC000000C00000	    44: 	move.w	#$0000,(VDP_DATA)
                            	    45: 	endif
00:00000254 51C9FFF6        	    46: 	dbf	d1,ClearCRAMLoop
                            	    47: 
                            	    48: ; clear VRAM - prevents garbage tiles from showing at boot on clone systems
00:00000258 61000790        	    49: 	bsr.w	ClearVRAM	; clear VRAM
                            	    50: 
                            	    51: ClearRAM:
00:0000025C 41F9FFFF0000    	    52: 	lea	MEM_START,a0
00:00000262 323C039A        	    53: 	move.w	#(MEM_END-MEM_START),d1
                            	    54: ClearRAMLoop:
00:00000266 30FC0000        	    55: 	move.w	#$0000,(a0)+
00:0000026A 51C9FFFA        	    56: 	dbf	d1,ClearRAMLoop
                            	    57: 
                            	    58: InitEcho:
00:0000026E 41F90000B334    	    59: 	lea (EchoPointerList),a0
00:00000274 4EB900009E36    	    60: 	jsr Echo_Init
                            	    61: 
00:0000027A 46FC2000        	    62: 	move.w	#$2000,sr		; re-enable interrupts
                            	    63: 

