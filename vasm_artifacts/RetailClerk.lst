00:0000071A 33FC0000FFFF0222	   307: 	move.w	#$0000,(MEM_MENU_SELECTION)	; clear menu selection
00:00000722 08C7000C        	   308: 	bset.l	#STATE_FLAG_LOAD_MENU,d7 ; set debug menu flag
00:00000726 23C7FFFF0028    	   309: 	move.l	d7,(MEM_GAME_STATE)	; save updated game state
00:0000072C 4DF900013A9C    	   310: 	lea	SceneLoad,a6	; address of the scene for the debug menu
00:00000732 61001516        	   311: 	bsr.w	LoadScene	; branch to LoadScene subroutine
00:00000736 61001322        	   312: 	bsr.w	LoadPlayerSprite	; load the player sprite (also loads sprite 0)
00:0000073A 610004FA        	   313: 	bsr.w	BuildLoadScreen	; builds the text on the screen
00:0000073E 61002576        	   314: 	bsr.w	FadeIn	; fade in to the new scene
