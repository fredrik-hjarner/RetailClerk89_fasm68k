Source: "const_ScriptedEventCommands.X68"
                            	     1: SCRIPTED_EVENT_END=$FFFF	; end of scripted event
                            	     2: SCRIPTED_EVENT_DIALOG=$EEEE	; show a dialog
                            	     3: SCRIPTED_EVENT_CHANGE_SPRITE=$DDDD	; change the moving sprite
                            	     4: SCRIPTED_EVENT_CHANGE_SCENE=$CCCC	; switch scenes
                            	     5: SCRIPTED_EVENT_CHANGE_PLAYER_SPRITE=$BBBB	; switch player sprites
                            	     6: SCRIPTED_EVENT_SET_PLAYER_SPRITE_X=$AAAA	; set player sprite X
                            	     7: SCRIPTED_EVENT_SET_PLAYER_SPRITE_Y=$9999	; set player sprite Y
                            	     8: SCRIPTED_EVENT_SET_PLAYER_SPRITE_DIRECTION=$8888	; set player direction
                            	     9: SCRIPTED_EVENT_FADE_BLACK=$7777	; fade and blackout the palette
                            	    10: SCRIPTED_EVENT_DRAW_SCENE=$6666	; draw scene, but not completely reload scene
                            	    11: SCRIPTED_EVENT_TIMER=$5555	; pause for a specified number of frames
                            	    12: SCRIPTED_EVENT_ENDGAME=$4444	; end the game
                            	    13: 

