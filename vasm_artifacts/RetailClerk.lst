                            	   373: ;****************************************************************************
                            	   374: ; Echo_GetStatus
                            	   375: ; Gets the current status of Echo
                            	   376: ;
                            	   377: ; output d0.w ... Echo status
                            	   378: ;                   Bit #0: SFX is playing
                            	   379: ;                   Bit #1: BGM is playing
                            	   380: ;                   Bit #14: direct events not played
                            	   381: ;                   Bit #15: command still not parsed
                            	   382: ;****************************************************************************
                            	   383: 
                            	   384: Echo_GetStatus:
00:00009DF8 7000            	   385:     moveq   #0, d0
                            	   386:     Echo_Z80Request                 ; We need the Z80 bus
00:00009DFA 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000097:
00:00009E02 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009E0A 66F6            	     4M     bne.s   @Echo_WaitZ80_000097         ; Keep waiting
00:00009E0C 103900A01FF0    	   387:     move.b  ($A01FF0), d0           ; Get the status flags
00:00009E12 4A3900A01FFF    	   388:     tst.b   ($A01FFF)               ; Check if command still has to be parsed
00:00009E18 6704            	   389:     beq.s   @NotBusy                ; Any commands left to be parsed?
00:00009E1A 08C0000F        	   390:     bset.l  #15, d0                 ; If so, set the relevant flag
                            	   391: @NotBusy:
00:00009E1E 0C3900FF00A01F00	   392:     cmpi.b  #$FF, ($A01F00)         ; Check if the direct buffer is empty
00:00009E26 6704            	   393:     beq.s   @DirectEmpty            ; Any direct events still to be played?
00:00009E28 08C0000E        	   394:     bset.l  #14, d0                 ; If so, set the relevant flag
                            	   395: @DirectEmpty:
                            	   396:     Echo_Z80Release                 ; Let the Z80 go!
00:00009E2C 33FC000000A11100	     1M     move.w  #$000, ($A11100)        ; Release Z80 bus
00:00009E34 4E75            	   397:     rts                             ; End of subroutine
                            	   398: 
                            	   399: ;****************************************************************************
                            	   400: ; Echo_ListEntry
                            	   401: ; Defines an entry in a pointer list
                            	   402: ;****************************************************************************
                            	   403: 
                            	   404: Echo_ListEntry macro addr
                            	   405:     dc.b    $80|((\1)>>8&$7F)                 ; High byte of address
                            	   406:     dc.b    (\1)&$FF                          ; Low byte of address
                            	   407:     dc.b    ((\1)>>15&$7F)|((\1)>>16&$80)   ; Bank number
                            	   408:     endm
                            	   409: 
                            	   410: ;****************************************************************************
                            	   411: ; Echo_ListEnd
                            	   412: ; Ends a pointer list
                            	   413: ;****************************************************************************
                            	   414: 
                            	   415: Echo_ListEnd macro
                            	   416:     dc.b    $00                     ; End of list mark
                            	   417:     even                            ; Just in case...
                            	   418:     endm
                            	   419: 
