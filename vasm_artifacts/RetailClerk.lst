00:00009C26 103C0002        	   175:     move.b  #$02, d0                ; Command $02 = play SFX
00:00009C2A 6100FF1E        	   176:     bsr     Echo_SendCommandAddr    ; Send command to Echo
00:00009C2E 301F            	   177:     move.w  (sp)+, d0               ; Restore register
00:00009C30 4E75            	   178:     rts                             ; End of subroutine
