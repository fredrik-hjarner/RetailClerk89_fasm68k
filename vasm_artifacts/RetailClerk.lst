00:0000061C 61001074        	   204: 	bsr.w	MoveSprite	; branch to move MoveSprite
                            	   205: 	; did the sprite move successfully?
00:00000620 4A79FFFF0298    	   206: 	tst.w	(MEM_COLLISION_RESULT)	; test result of last collision
00:00000626 6704            	   207: 	beq.s	MainGameLoopUpdateNPCSpritesLoopEnd ; done updating this sprite	
00:00000628 526D000E        	   208: 	addq	#$0001,(STRUCT_SPRITE_MOVEMENT_COUNTER,a5)	; rollback counter
                            	   209: MainGameLoopUpdateNPCSpritesLoopEnd:
