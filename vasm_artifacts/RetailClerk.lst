                            	     4: ActionScriptNullEvent:
00:00002F48 4E75            	     5: 	rts
                            	     6: 
                            	     7: ;*******************************************************************************
                            	     8: ; used for lookup table conditions that only ever show default look text
                            	     9: ;*******************************************************************************
                            	    10: ActionScriptDefaultLook:
00:00002F4A 6100006A        	    11: 	bsr.w	ShowDefaultText
00:00002F4E 4E75            	    12: 	rts
                            	    13: 
                            	    14: ;*******************************************************************************
                            	    15: ; used for lookup table conditions that show default use text (no npcs)
                            	    16: ;*******************************************************************************
                            	    17: ActionScriptDefaultUse:
00:00002F50 4DF900100499    	    18: 	lea	DialogTextNothingHappens,a6	; load default text
00:00002F56 23CEFFFF022E    	    19: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:00002F5C 4E75            	    20: 	rts
                            	    21: 
                            	    22: ;*******************************************************************************
                            	    23: ; used for lookup table conditions that show default take text (no npcs)
                            	    24: ;*******************************************************************************
                            	    25: ActionScriptDefaultTake:
00:00002F5E 4DF9001004AA    	    26: 	lea	DialogTextCantTake,a6	; load default text
00:00002F64 23CEFFFF022E    	    27: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:00002F6A 4E75            	    28: 	rts
                            	    29: 
                            	    30: ;*******************************************************************************
                            	    31: ; end the game
                            	    32: ;*******************************************************************************
                            	    33: EndGame:
                            	    34: 	; set the end game flag
00:00002F6C 2E39FFFF0028    	    35: 	move.l	(MEM_GAME_STATE),d7	; copy game state
00:00002F72 CEBC00000000    	    36: 	and.l	#$0000,d7	; clear all other flags
00:00002F78 08C70008        	    37: 	bset.l	#STATE_FLAG_END_SCREEN,d7 ; set end screen state flag	
00:00002F7C 23C7FFFF0028    	    38: 	move.l	d7,(MEM_GAME_STATE)	; save updated game state
                            	    39: 	;---------------------------------------------------------------------------
                            	    40: 	; determine which ending to load
                            	    41: 	;---------------------------------------------------------------------------
00:00002F82 2E39FFFF00A2    	    42: 	move.l	(MEM_DAY_EVENT_FLAGS),d7	; copy day event flags to d7
00:00002F88 08070007        	    43: 	btst.l	#EVENT_FLAG_DAY07_PERFECT_ENDING,d7	; perfect ending achieved?
00:00002F8C 6708            	    44: 	beq.s	.1	; perfect ending not achieved
00:00002F8E 4DF900014AFA    	    45: 	lea	SceneEndingPerfect0,a6	; last screen of perfect ending
00:00002F94 6014            	    46: 	bra.s	EndGameLoadScene	; load the scene
                            	    47: .1
00:00002F96 08070006        	    48: 	btst.l	#EVENT_FLAG_DAY07_GOOD_ENDING,d7	; good ending achieved?
00:00002F9A 6708            	    49: 	beq.s	EndGameBadEnding	; good ending not achieved
00:00002F9C 4DF900014A0C    	    50: 	lea	SceneEndingGood3,a6	; last screen of good ending
00:00002FA2 6006            	    51: 	bra.s	EndGameLoadScene	; load the scene
                            	    52: EndGameBadEnding:
00:00002FA4 4DF9000150F8    	    53: 	lea	SceneEndingBad3,a6	; last screen of bad ending
                            	    54: EndGameLoadScene:
00:00002FAA 4EB900001C4A    	    55: 	jsr	LoadScene	; branch to LoadScene subroutine
00:00002FB0 6100FD04        	    56: 	bsr.w	FadeIn	; fade in
00:00002FB4 4E75            	    57: 	rts
                            	    58: 
                            	    59: ;*******************************************************************************
                            	    60: ; default text for look events
                            	    61: ;*******************************************************************************
                            	    62: 	include	'sub_ShowDefaultText.X68'

Source: "sub_ShowDefaultText.X68"
                            	     1: ShowDefaultText:
00:00002FB6 3E39FFFF002E    	     2: 	move.w	(MEM_ACTION_TARGET_OBJID),d7	; move target object ID to d7
00:00002FBC 3C39FFFF002E    	     3: 	move.w	(MEM_ACTION_TARGET_OBJID),d6	; move target object ID to d6
00:00002FC2 02470FFF        	     4: 	andi.w	#$0FFF,d7	; clear the base value
00:00002FC6 CEFC0004        	     5: 	mulu.w	#$4,d7	; multiply by 4 to get the offset
                            	     6: 	; determine whether this is an object or NPC
00:00002FCA 02461000        	     7: 	andi.w	#OBJ_SCENE_BASE,d6	; and d6 against base object value
00:00002FCE 6708            	     8: 	beq.s	.1	; branch if zero (not an object)
                            	     9: 	; object
00:00002FD0 4DF90001C7BE    	    10: 	lea	DefaultObjectDescriptionTable,a6	; point to default object text table
00:00002FD6 6006            	    11: 	bra.s	.2
                            	    12: .1	; npc
00:00002FD8 4DF90001C8A2    	    13: 	lea	DefaultNPCDescriptionTable,a6	; point to default npc text table
                            	    14: .2
00:00002FDE DDC7            	    15: 	adda.l	d7,a6	; add offset
00:00002FE0 23D6FFFF022E    	    16: 	move.l	(a6),(MEM_DIALOG_TEXT)	; copy value at a6 to MEM_DIALOG_TEXT
00:00002FE6 4E75            	    17: 	rts
                            	    18: 

Source: "actionscript/ActionScript.X68"
                            	    63: 
                            	    64: ;*******************************************************************************
                            	    65: ; scene exit actions - a lot of the game flow is in here, probably too much
                            	    66: ;*******************************************************************************
                            	    67: 	include	'actionscript/ActionScriptSceneExit.X68'

Source: "actionscript/ActionScriptSceneExit.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; default exit scene handler
                            	     3: ;-------------------------------------------------------------------------------
                            	     4: DefaultExitScene:
                            	     5: 	; determine which exit is being used based on sprite direction
00:00002FE8 3C39FFFF00C4    	     6: 	move.w	(MEM_PLAYER_SPRITE_DIRECTION),d6	; copy player direction to d6
00:00002FEE CCFC0002        	     7: 	mulu.w	#$2,d6	; multiply by 2 to get offset
00:00002FF2 4DF9FFFF0140    	     8: 	lea	MEM_ACTIVE_SCENE_EXIT_S,a6	; point a6 to the first exit
00:00002FF8 DDC6            	     9: 	adda.l	d6,a6	; add offset
00:00002FFA 3C16            	    10: 	move.w	(a6),d6	; copy location to d6
00:00002FFC 0C46FFFF        	    11: 	cmpi.w	#$FFFF,d6	; is this a valid exit?
00:00003000 670000D0        	    12: 	beq.w	ExitDefaultExit	; if not a valid exit then exit subroutine
                            	    13: 	;---------------------------------------------------------------------------
                            	    14: 	; test if a key is needed to enter the new scene
                            	    15: 	;---------------------------------------------------------------------------
                            	    16: 	; only test for keys if the mall is closed	
00:00003004 2E39FFFF0028    	    17: 	move.l	(MEM_GAME_STATE),d7	; copy game state to d7
00:0000300A 0807000B        	    18: 	btst.l	#STATE_FLAG_MALL_CLOSED,d7	; test mall closed flag
00:0000300E 6762            	    19: 	beq.s	DefaultExitSceneLoadNewScene	; branch if not set
                            	    20: 	; don't test for keys when entering/exiting any scene that's not a store	
00:00003010 0C4600FF        	    21: 	cmpi.w	#$00FF,d6	; <$0100 means this this is a store
00:00003014 6E5C            	    22: 	bgt.s	DefaultExitSceneLoadNewScene
00:00003016 0C7900FFFFFF013E	    23: 	cmpi.w	#$00FF,(MEM_ACTIVE_SCENE_ID)	; <$0100 means this this is a store
00:0000301E 6E52            	    24: 	bgt.s	DefaultExitSceneLoadNewScene
                            	    25: 	; lookup if destination store needs a key
00:00003020 3E06            	    26: 	move.w	d6,d7	; copy destination store to d7 because d6 is used later
00:00003022 CEFC0002        	    27: 	mulu.w	#$2,d7	; multiply by 2 to get offset
00:00003026 4DF90001DA72    	    28: 	lea	SceneKeyLookupTable,a6	; point a6 to scene key lookup table
00:0000302C DDC7            	    29: 	adda.l	d7,a6	; add offset
00:0000302E 3E16            	    30: 	move.w	(a6),d7	; copy value of lookup table to d7
00:00003030 0C47FFFF        	    31: 	cmpi.w	#$FFFF,d7	; test if the scene has a key
00:00003034 673C            	    32: 	beq.s	DefaultExitSceneLoadNewScene	; if lookup value is #FFFF branch	
                            	    33: 	; now test if the player has the key for this store
00:00003036 2A39FFFF00B6    	    34: 	move.l	(MEM_PLAYER_STORE_KEYS),d5	; copy keys to d5
00:0000303C 0F05            	    35: 	btst.l	d7,d5	; test if player has the key
00:0000303E 6632            	    36: 	bne.s	DefaultExitSceneLoadNewScene	; player has the key, branch
                            	    37: 	;--------------------------------------------------------------------------- 
                            	    38: 	; at this point the player needs a key for the store
                            	    39: 	; if the day is 05 and EVENT_FLAG_DAY05_EVENT_LEAVING is set
                            	    40: 	; then there are different rules
                            	    41: 	;--------------------------------------------------------------------------- 
00:00003040 0C790005FFFF009A	    42: 	cmpi.w	#$0005,(MEM_DAY)
00:00003048 660E            	    43: 	bne.s	DefaultExitSceneNoKey	; branch to default
00:0000304A 2E39FFFF00A2    	    44: 	move.l	(MEM_DAY_EVENT_FLAGS),d7	; copy day event flags to d7
00:00003050 08070001        	    45: 	btst.l	#EVENT_FLAG_DAY05_EVENT_LEAVING,d7	; test flag
00:00003054 66000B84        	    46: 	bne.w	ExitSceneDay05Blizzard	; flag set, branch
                            	    47: DefaultExitSceneNoKey:
                            	    48: 	; this line is for a bug that was really fun to track down
00:00003058 33FCFFFFFFFF0030	    49: 	move.w	#$FFFF,(MEM_ACTION_TARGET_NPCID)
                            	    50: 	; display message
00:00003060 4DF9001004E5    	    51: 	lea	DialogTextStoreClosed,a6	; load dialog text
00:00003066 23CEFFFF022E    	    52: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:0000306C 6100FA00        	    53: 	bsr.w	SetDialogOpening
00:00003070 4E75            	    54: 	rts
                            	    55: 	;---------------------------------------------------------------------------
                            	    56: 	; load the new scene
                            	    57: 	;---------------------------------------------------------------------------
                            	    58: DefaultExitSceneLoadNewScene:
00:00003072 CCFC0004        	    59: 	mulu.w	#$4,d6	; multiply by 4 to get offset
00:00003076 4DF90001C71E    	    60: 	lea	SceneDefinitionTable,a6	; point a6 to the scene definition table
00:0000307C DDC6            	    61: 	adda.l	d6,a6	; add offset
00:0000307E 2C56            	    62: 	move.l	(a6),a6	; have a6 point to the value at a6
00:00003080 6100EBC8        	    63: 	bsr.w	LoadScene	; branch to LoadScene subroutine
00:00003084 6100E9D4        	    64: 	bsr.w	LoadPlayerSprite	; load the player sprite
                            	    65: 	; move player to the correct position
00:00003088 3C39FFFF00C4    	    66: 	move.w	(MEM_PLAYER_SPRITE_DIRECTION),d6	; copy player direction to d6
                            	    67: 	;---------------------------------------------------------------------------
                            	    68: 	; adjust player sprite x/y
                            	    69: 	;---------------------------------------------------------------------------
                            	    70: DefaultExitSceneTestDown:
00:0000308E 0C460000        	    71: 	cmpi.w	#DIRECTION_DOWN,d6	; test for down
00:00003092 660C            	    72: 	bne.s	DefaultExitSceneTestUp	; direction is not down, test for up
00:00003094 33FC0088FFFF00C0	    73: 	move.w	#SCENE_ENTER_TOP,(MEM_PLAYER_SPRITE_Y)	; update y location
00:0000309C 60000030        	    74: 	bra.w	DefaultExitSceneFixSprites	; exit
                            	    75: DefaultExitSceneTestUp:
00:000030A0 0C460001        	    76: 	cmpi.w	#DIRECTION_UP,d6	; test for up
00:000030A4 660A            	    77: 	bne.s	DefaultExitSceneTestLeft	; direction is not up, test for left
00:000030A6 33FC0150FFFF00C0	    78: 	move.w	#SCENE_ENTER_BOTTOM,(MEM_PLAYER_SPRITE_Y)	; update y location
00:000030AE 601E            	    79: 	bra.s	DefaultExitSceneFixSprites	; exit
                            	    80: DefaultExitSceneTestLeft:
00:000030B0 0C460002        	    81: 	cmpi.w	#DIRECTION_LEFT,d6	; test for left
00:000030B4 660A            	    82: 	bne.s	DefaultExitSceneTestRight	; direction is not left, test for right
00:000030B6 33FC01B8FFFF00BE	    83: 	move.w	#SCENE_ENTER_RIGHT,(MEM_PLAYER_SPRITE_X)	; update x location
00:000030BE 600E            	    84: 	bra.s	DefaultExitSceneFixSprites	; exit
                            	    85: DefaultExitSceneTestRight:
00:000030C0 0C460003        	    86: 	cmpi.w	#DIRECTION_RIGHT,d6	; test for right
00:000030C4 6608            	    87: 	bne.s	DefaultExitSceneFixSprites	; should be unreachable
00:000030C6 33FC0088FFFF00BE	    88: 	move.w	#SCENE_ENTER_LEFT,(MEM_PLAYER_SPRITE_X)	; update x location
                            	    89: DefaultExitSceneFixSprites:
00:000030CE 6100E6B8        	    90: 	bsr.w	FixSprites ; fix all the sprites
                            	    91: ExitDefaultExit:
00:000030D2 6100FBE2        	    92: 	bsr.w	FadeIn ; fade in now that everything is loaded
00:000030D6 4E75            	    93: 	rts
                            	    94: 
                            	    95: ;-------------------------------------------------------------------------------
                            	    96: ; exit scene 00 (SCENE_ID_VB)
                            	    97: ;-------------------------------------------------------------------------------
                            	    98: ExitScene00:
00:000030D8 0C790000FFFF009A	    99: 	cmpi.w	#$0000,(MEM_DAY)
00:000030E0 6732            	   100: 	beq.s	ExitScene00Day00	; branch to day 0
00:000030E2 0C790001FFFF009A	   101: 	cmpi.w	#$0001,(MEM_DAY)
00:000030EA 6748            	   102: 	beq.s	ExitScene00Day01	; branch to day 1
00:000030EC 0C790002FFFF009A	   103: 	cmpi.w	#$0002,(MEM_DAY)
00:000030F4 677C            	   104: 	beq.s	ExitScene00Day02	; branch to day 2
00:000030F6 0C790004FFFF009A	   105: 	cmpi.w	#$0004,(MEM_DAY)
00:000030FE 67000098        	   106: 	beq.w	ExitScene00Day04	; branch to day 4
00:00003102 0C790007FFFF009A	   107: 	cmpi.w	#$0007,(MEM_DAY)
00:0000310A 670000FA        	   108: 	beq.w	ExitScene00Day07	; branch to day 7
00:0000310E 6100FED8        	   109: 	bsr.w	DefaultExitScene	; use default handler
00:00003112 4E75            	   110: 	rts
                            	   111: ExitScene00Day00:
00:00003114 2E39FFFF0028    	   112: 	move.l	(MEM_GAME_STATE),d7	; copy game state to d7
00:0000311A 08070007        	   113: 	btst.l	#STATE_FLAG_EXITS_BLOCKED,d7	; test flag blocking the exits
00:0000311E 6700FEC8        	   114: 	beq.w	DefaultExitScene	; branch if flag is not set
                            	   115: 	; display message
00:00003122 4DF9001004BF    	   116: 	lea	DialogTextCantLeaveStoreUnattended,a6	; load dialog text
00:00003128 23CEFFFF022E    	   117: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:0000312E 6100F93E        	   118: 	bsr.w	SetDialogOpening
00:00003132 4E75            	   119: 	rts
                            	   120: ExitScene00Day01:
00:00003134 0C790001FFFF009C	   121: 	cmpi.w	#PLAYER_SPRITE_DANI,(MEM_PLAYER_SPRITE)	; test which PC this is
00:0000313C 672E            	   122: 	beq.s	ExitScene00Day01CanExit	; ok to exit
00:0000313E 2E39FFFF00A6    	   123: 	move.l	(MEM_MISSION_EVENT_FLAGS),d7	; copy mission flags to d7
00:00003144 08070000        	   124: 	btst.l	#MISSION_FLAG_DAY01_SUB02_STARTED,d7	; test if flag is set
00:00003148 6622            	   125: 	bne.s	ExitScene00Day01CanExit	; flag is set, OK to exit
