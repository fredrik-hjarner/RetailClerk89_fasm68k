                            	   166: ;****************************************************************************
                            	   167: ; Echo_PlaySFX
                            	   168: ; Plays a SFX
                            	   169: ;
                            	   170: ; input a0.l ... Pointer to SFX data
                            	   171: ;****************************************************************************
                            	   172: 
                            	   173: Echo_PlaySFX:
