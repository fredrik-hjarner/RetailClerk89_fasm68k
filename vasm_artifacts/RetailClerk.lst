                            	   274: ;****************************************************************************
                            	   275: ; Echo_SetVolume
                            	   276: ; Changes the global volume for every channel.
                            	   277: ;
                            	   278: ; input d0.b ... New volume (0 = quietest, 255 = loudest)
                            	   279: ;****************************************************************************
                            	   280: 
                            	   281: Echo_SetVolume:
                            	   282:     Echo_Z80Request                 ; We need the Z80 bus
00:00009CBA 33FC010000A11100	     1M     move.w  #$100, ($A11100)        ; Request Z80 bus
                            	     2M @Echo_WaitZ80_000093:
00:00009CC2 0839000000A11100	     3M     btst.b  #0, ($A11100)           ; Did we get it yet?
00:00009CCA 66F6            	     4M     bne.s   @Echo_WaitZ80_000093         ; Keep waiting
00:00009CCC 48E7C0C0        	   283:     movem.l d0-d1/a0-a1, -(sp)      ; Save registers
                            	   284:     
00:00009CD0 41FA005A        	   285:     lea     @FMTable(pc), a0        ; Determine FM volume
00:00009CD4 7200            	   286:     moveq   #0, d1
00:00009CD6 1200            	   287:     move.b  d0, d1
00:00009CD8 E409            	   288:     lsr.b   #2, d1
00:00009CDA 12301000        	   289:     move.b  (a0,d1.w), d1
                            	   290:     
00:00009CDE 43F900A01FE0    	   291:     lea     ($A01FE0), a1           ; Copy new FM volume values
00:00009CE4 12C1            	   292:     move.b  d1, (a1)+                 ; FM channel 0
00:00009CE6 12C1            	   293:     move.b  d1, (a1)+                 ; FM channel 1
00:00009CE8 12C1            	   294:     move.b  d1, (a1)+                 ; FM channel 2
00:00009CEA 12C1            	   295:     move.b  d1, (a1)+                 ; FM channel 3
00:00009CEC 12C1            	   296:     move.b  d1, (a1)+                 ; FM channel 4
00:00009CEE 12C1            	   297:     move.b  d1, (a1)+                 ; FM channel 5
00:00009CF0 12C1            	   298:     move.b  d1, (a1)+                 ; FM channel 6
00:00009CF2 12C1            	   299:     move.b  d1, (a1)+                 ; FM channel 7
                            	   300:     
00:00009CF4 41FA0076        	   301:     lea     @PSGTable(pc), a0       ; Determine PSG volume
00:00009CF8 7200            	   302:     moveq   #0, d1
00:00009CFA 1200            	   303:     move.b  d0, d1
00:00009CFC E409            	   304:     lsr.b   #2, d1
