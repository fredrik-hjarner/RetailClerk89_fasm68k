                            	     1: ;*******************************************************************************
                            	     2: ; general routines to take items & add items to the player's inventory
                            	     3: ;*******************************************************************************
                            	     4: ;-------------------------------------------------------------------------------
                            	     5: ; displays a message if the player can't hold more items
                            	     6: ;-------------------------------------------------------------------------------
                            	     7: DefaultActionInventoryFull:
00:0000991E 4DF90011009E    	     8: 	lea	TakeMenuFull,a6	; load dialog text
00:00009924 23CEFFFF022E    	     9: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
                            	    10: ExitDefaultActionInventoryFull:
00:0000992A 4E75            	    11: 	rts
                            	    12: 
                            	    13: ;-------------------------------------------------------------------------------
                            	    14: ; adds an item from the take dialog to the player's inventory
                            	    15: ;-------------------------------------------------------------------------------
                            	    16: DefaultTakeAddItem:
00:0000992C 3E39FFFF0036    	    17: 	move.w	(MEM_ACTIVE_ITEM),d7	; copy active item to d7
00:00009932 61009534        	    18: 	bsr.w	HasItem	; check if the player already has the item
00:00009936 0C46FFFF        	    19: 	cmpi.w	#$FFFF,d6	; d6 will have FFFF if the player has the item	
00:0000993A 6612            	    20: 	bne.s	DefaultTakeAddItemHasItem	; branch if the player has the item
00:0000993C 610094F0        	    21: 	bsr.w	AddItem	; add the item
00:00009940 4DF90011007A    	    22: 	lea	TakeMenuItemTaken,a6	; load dialog text
00:00009946 23CEFFFF022E    	    23: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:0000994C 4E75            	    24: 	rts
                            	    25: DefaultTakeAddItemHasItem:
00:0000994E 4DF900110081    	    26: 	lea	TakeMenuAlreadyCarrying,a6	; load dialog text
00:00009954 23CEFFFF022E    	    27: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:0000995A 4E75            	    28: 	rts
