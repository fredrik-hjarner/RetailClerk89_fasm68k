Source: "init_Header.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; cartridge info header
                            	     3: ; see-https://en.wikibooks.org/wiki/Genesis_Programming#ROM_header
                            	     4: ;*******************************************************************************
00:00000100 534547412047454E	     5: 	dc.b	'SEGA GENESIS    '	; console name
00:00000108 4553495320202020
00:00000110 28432948554A4F20	     6: 	dc.b	'(C)HUJO '			; copyright
00:00000118 323032302E534550	     7:  	dc.b	'2020.SEP'			; date
                            	     8: 	if	_EMULATOR_DIAGNOSTICS_
                            	     9: 	dc.b	'Retail Clerk 89 - Emulator Diagnostics Build    ' ; cart name
                            	    10: 	dc.b	'Retail Clerk 89 - Emulator Diagnostics Build    ' ; cart name (alt)
                            	    11: 	else 
                            	    12: 	if _DEBUG_
                            	    13: 	dc.b	'Retail Clerk 89 - Debug Build                   ' ; cart name
                            	    14: 	dc.b	'Retail Clerk 89 - Debug Build                   ' ; cart name (alt)
                            	    15: 	else
00:00000120 52657461696C2043	    16: 	dc.b	'Retail Clerk 89 - Release Build 20200901-00     ' ; cart name
00:00000128 6C65726B20383920
00:00000130 2D2052656C656173
00:00000138 65204275696C6420
00:00000140 3230323030393031
00:00000148 2D30302020202020
00:00000150 52657461696C2043	    17: 	dc.b	'Retail Clerk 89 - Release Build 20200901-00     ' ; cart name (alt)
00:00000158 6C65726B20383920
00:00000160 2D2052656C656173
00:00000168 65204275696C6420
00:00000170 3230323030393031
00:00000178 2D30302020202020
                            	    18: 	endif
                            	    19: 	endif
00:00000180 474D203230323030	    20: 	dc.b	'GM 20200901-00'	; program type / serial number / version
00:00000188 3930312D3030
00:0000018E 0000            	    21: 	dc.w	$0000				; ROM checksum
00:00000190 4A20202020202020	    22: 	dc.b	'J               '	; I/O device support (unused)
00:00000198 2020202020202020
00:000001A0 00000000        	    23: 	dc.l	$00000000			; address of ROM start
00:000001A4 00200000        	    24: 	dc.l	RomEnd				; address of ROM end
00:000001A8 FFFF0000        	    25: 	dc.l	$FFFF0000,$FFFFFFFF	; RAM start/end
00:000001AC FFFFFFFF
                            	    26: ;	dc.b	'            '		; backup RAM info
00:000001B0 5241            	    27: 	dc.b	'RA',$F8,$20	; SRAM type
00:000001B2 F8
00:000001B3 20
00:000001B4 00200001        	    28: 	dc.l	SRAM_START	; SRAM start address
00:000001B8 0020FFFF        	    29: 	dc.l	SRAM_END	; SRAM end address
00:000001BC 2020202020202020	    30: 	dc.b	'            '		; modem info
00:000001C4 20202020
00:000001C8 687474703A2F2F68	    31: 	dc.b	'http://huguesjohnson.com/               ' ; comment
00:000001D0 75677565736A6F68
00:000001D8 6E736F6E2E636F6D
00:000001E0 2F20202020202020
00:000001E8 2020202020202020
00:000001F0 4A55452020202020	    32: 	dc.b	'JUE             '	; regions allowed
00:000001F8 2020202020202020
