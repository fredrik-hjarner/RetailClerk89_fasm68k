                            	    66: MEM_PLAYER_SPRITE_ID=$FFFF00BC	; sprite table id of player sprite
                            	    67: MEM_PLAYER_SPRITE_X=$FFFF00BE	; virtual x position of the player
                            	    68: MEM_PLAYER_SPRITE_Y=$FFFF00C0	; virtual y position of the player
                            	    69: MEM_PLAYER_SPRITE_PATTERN_INDEX=$FFFF00C2	; index of pattern in VDP
                            	    70: MEM_PLAYER_SPRITE_DIRECTION=$FFFF00C4	; which direction the player faces
                            	    71: MEM_PLAYER_SPRITE_FRAME=$FFFF00C6	; animation frame of player sprite
