00:00000712 4A79FFFF0222    	   300: 	tst.w	(MEM_MENU_SELECTION)	; which item was selected?
00:00000718 672C            	   301: 	beq.s	TestTitleLoadNewGame	; new game selected
                            	   302: 	if _DEBUG_
                            	   303: 	cmpi.w	#$0002,(MEM_MENU_SELECTION)	; debug menu selected?
