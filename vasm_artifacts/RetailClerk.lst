Source: "inc_Subroutines.X68"
                            	    83: 
                            	    84: 	include	'sub_FadeInFadeOut.X68'

Source: "sub_FadeInFadeOut.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; FadeIn
                            	     3: ; Fades in the screen to MEM_SCENE_PALETTE, MEM_SCENE_PALETTE is not modified
                            	     4: ; a1, d2-d6 are modified
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: FadeIn:
00:00002CB6 7602            	     7: 	moveq	#$0002,d3	; d3 is the number of times to loop
                            	     8: LoadSceneFadeInOuterLoop:
00:00002CB8 3403            	     9: 	move.w	d3,d2	; d2 will be used as the lsr loop counter
00:00002CBA 61000076        	    10: 	bsr.w	FadeFrameDelay	; fade in/out delay frames
00:00002CBE 23FCC000000000C0	    11: 	move.l	#VDP_CRAM_WRITE,(VDP_CONTROL) ; set up VDP write to CRAM
00:00002CC6 0004
00:00002CC8 43F9FFFF01A2    	    12: 	lea	(MEM_SCENE_PALETTE),a1	; point a1 to the now previous scene palette
00:00002CCE 7A3F            	    13: 	moveq	#$003F,d5	; 64 words of palette data
                            	    14: LoadSceneFadeInInnerLoop:
00:00002CD0 3C19            	    15: 	move.w	(a1)+,d6	; get the next palette entry
00:00002CD2 4A43            	    16: 	tst.w	d3	; is d3 0?
00:00002CD4 670A            	    17: 	beq.s	LoadSceneFadeInWritePaletteEntry; if d3 is then then done fading
                            	    18: LoadSceneFadeInLsrLoop:
00:00002CD6 E24E            	    19: 	lsr.w	#$01,d6	; shift bits to the right to decrease color intensity
                            	    20: 	;	      0000BBBSGGGSRRRS
00:00002CD8 CC7C0EEE        	    21: 	and.w	#%0000111011101110,d6	; prevent color overflow
00:00002CDC 51CAFFF8        	    22: 	dbf	d2,LoadSceneFadeInLsrLoop	; loop until done shifting
                            	    23: LoadSceneFadeInWritePaletteEntry:
00:00002CE0 33C600C00000    	    24: 	move.w	d6,(VDP_DATA)	; write the palette entry
00:00002CE6 3403            	    25: 	move.w	d3,d2	; reset d2
00:00002CE8 51CDFFE6        	    26: 	dbf	d5,LoadSceneFadeInInnerLoop	; decrement d5 and loop
00:00002CEC 51CBFFCA        	    27: 	dbf	d3,LoadSceneFadeInOuterLoop	; decrement d3 and loop
                            	    28: ExitFadeIn:
00:00002CF0 4E75            	    29: 	rts	; exit
                            	    30: 
                            	    31: ;-------------------------------------------------------------------------------
                            	    32: ; FadeOut
                            	    33: ; Fades out the screen to black, MEM_SCENE_PALETTE is not modified
                            	    34: ; a1, d5-d3 are modified
                            	    35: ;-------------------------------------------------------------------------------
                            	    36: FadeOut:
00:00002CF2 363C0000        	    37: 	move.w	#$0000,d3	; d3 is the number of times to loop
                            	    38: FadeOutOuterLoop:
00:00002CF6 3403            	    39: 	move.w	d3,d2	; d2 will be used as the lsr loop counter
00:00002CF8 61000038        	    40: 	bsr.w	FadeFrameDelay	; fade in/out delay frames
00:00002CFC 23FCC000000000C0	    41: 	move.l	#VDP_CRAM_WRITE,(VDP_CONTROL) ; set up VDP write to CRAM
00:00002D04 0004
00:00002D06 43F9FFFF01A2    	    42: 	lea	(MEM_SCENE_PALETTE),a1	; point a1 to the now previous scene palette
00:00002D0C 3A3C003F        	    43: 	move.w	#$003F,d5	; 64 words of palette data
                            	    44: FadeOutInnerLoop:
00:00002D10 3C19            	    45: 	move.w	(a1)+,d6	; get the next palette entry
                            	    46: FadeOutLsrLoop:
00:00002D12 E24E            	    47: 	lsr.w	#$01,d6	; shift bits to the right to decrease color intensity
                            	    48: 	;	      0000BBBSGGGSRRRS
00:00002D14 CC7C0EEE        	    49: 	and.w	#%0000111011101110,d6	; prevent color overflow
00:00002D18 51CAFFF8        	    50: 	dbf	d2,FadeOutLsrLoop	; loop until done shifting
00:00002D1C 33C600C00000    	    51: 	move.w	d6,(VDP_DATA)	; write the palette entry
00:00002D22 3403            	    52: 	move.w	d3,d2	; reset d2
00:00002D24 51CDFFEA        	    53: 	dbf	d5,FadeOutInnerLoop	; decrement d5 and loop
00:00002D28 5243            	    54: 	addq	#$0001,d3	; increment d3
00:00002D2A 0C430003        	    55: 	cmpi.w	#$0003,d3	; loop for three shifts
00:00002D2E 6DC6            	    56: 	blt.s	FadeOutOuterLoop	; loop until fade is complete
                            	    57: ExitFadeOut:
00:00002D30 4E75            	    58: 	rts	; exit
                            	    59: 
                            	    60: FadeFrameDelay:
00:00002D32 383C0003        	    61: 	move.w	#FADE_FRAME_DELAY,d4	; copy frame delay to d6
                            	    62: FadeFrameDelayLoop:
00:00002D36 6100DBB4        	    63: 	bsr.w	WaitVBlank	; force waiting for a frame
00:00002D3A 51CCFFFA        	    64: 	dbf.w	d4,FadeFrameDelayLoop	; frame delay loop
00:00002D3E 4E75            	    65: 	rts	; exit
                            	    66: 

Source: "inc_Subroutines.X68"
                            	    85: 
                            	    86: 	include	'sub_ProcessAction.X68'

Source: "sub_ProcessAction.X68"
                            	     1: ProcessAction:
                            	     2: 	; --------------------------------------------------------------------------
                            	     3: 	; test if the action is the player exiting the scene, if so process it
                            	     4: 	; --------------------------------------------------------------------------
00:00002D40 0C79F000FFFF002C	     5: 	cmpi.w	#ACTION_EXIT_SCENE,(MEM_ACTION_ID)	; test if this is an exit action
00:00002D48 661A            	     6: 	bne.s	ProcessActionResetDialog	; not an exit action, branch
00:00002D4A 4BF90001D9B2    	     7: 	lea	SceneExitTable,a5	; point to scene exit table
00:00002D50 3E39FFFF013E    	     8: 	move.w	(MEM_ACTIVE_SCENE_ID),d7	; copy scene ID to d7
00:00002D56 CEFC0004        	     9: 	mulu.w	#LWORD_SIZE,d7	; multiply by lword size to get offset
00:00002D5A DAC7            	    10: 	adda.w	d7,a5	; move to offset location
00:00002D5C 2C55            	    11: 	move.l	(a5),a6	; a5 has the address of the subroutine to jump to
00:00002D5E 4E96            	    12: 	jsr	(a6)	; jump to location of code to process this event
00:00002D60 600000BA        	    13: 	bra.w	ExitProcessAction	; exit
                            	    14: 	; --------------------------------------------------------------------------
                            	    15: 	; action is something other than exiting the current scene
                            	    16: 	; --------------------------------------------------------------------------
                            	    17: ProcessActionResetDialog:
00:00002D64 6100FD2A        	    18: 	bsr.w	ResetDialog	; reset the dialog
                            	    19: 	; if the target is an NPC - the resulting dialog should be titled
00:00002D68 3E39FFFF002E    	    20: 	move.w	(MEM_ACTION_TARGET_OBJID),d7	; copy action target to d7
00:00002D6E 02472000        	    21: 	andi.w	#OBJ_NPC_BASE,d7	; and against base npc ID
00:00002D72 671A            	    22: 	beq.s	ProcessActionTestDefaultActions	; target is not an NPC
00:00002D74 0C790000FFFF002C	    23: 	cmpi.w	#ACTION_LOOK,(MEM_ACTION_ID)	; test if this is a look action
00:00002D7C 6710            	    24: 	beq.s	ProcessActionTestDefaultActions	; look action, no title
00:00002D7E 2E39FFFF0226    	    25: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy dialog flags to d7
00:00002D84 08C70013        	    26: 	bset.l	#DIALOG_FLAG_STYLE_TITLED,d7	; set the titled flag
00:00002D88 23C7FFFF0226    	    27: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save updated event flags for the day	
                            	    28: ProcessActionTestDefaultActions:
                            	    29: 	; --------------------------------------------------------------------------
                            	    30: 	; test if a default handler should be used
                            	    31: 	; --------------------------------------------------------------------------
00:00002D8E 0C790002FFFF002C	    32: 	cmpi.w	#ACTION_TAKE_GIVE,(MEM_ACTION_ID)	; test if this is a give action
00:00002D96 6648            	    33: 	bne.s	ProcessActionBuildActionTableOffset	; not give action, branch
00:00002D98 3E39FFFF002E    	    34: 	move.w	(MEM_ACTION_TARGET_OBJID),d7	; copy action target to d7
00:00002D9E 02472000        	    35: 	andi.w	#OBJ_NPC_BASE,d7	; and against base npc ID
00:00002DA2 6710            	    36: 	beq.s	ProcessActionTakeTestScenery	; target is not an NPC
                            	    37: 	; --------------------------------------------------------------------------
                            	    38: 	; default handler for giving an item to an NPC
                            	    39: 	; --------------------------------------------------------------------------
00:00002DA4 0C790000FFFF0036	    40: 	cmpi.w	#$0000,(MEM_ACTIVE_ITEM)	; test if there is an active item
00:00002DAC 6632            	    41: 	bne.s	ProcessActionBuildActionTableOffset	; responding to a give menu
00:00002DAE 61006B06        	    42: 	bsr.w	DefaultActionGive	; otherwise launch default action
00:00002DB2 6068            	    43: 	bra.s	ExitProcessAction	; exit
                            	    44: ProcessActionTakeTestScenery:	; test if target is scenery
00:00002DB4 3E39FFFF002E    	    45: 	move.w	(MEM_ACTION_TARGET_OBJID),d7	; copy action target to d7
00:00002DBA 02471000        	    46: 	andi.w	#OBJ_SCENE_BASE,d7	; and against base npc ID
00:00002DBE 6720            	    47: 	beq.s	ProcessActionBuildActionTableOffset	; target is not scenery
                            	    48: 	; --------------------------------------------------------------------------
                            	    49: 	; trying to take an item from a scene, test if inventory is full
                            	    50: 	; --------------------------------------------------------------------------
00:00002DC0 0C790000FFFF0036	    51: 	cmpi.w	#$0000,(MEM_ACTIVE_ITEM)	; test if there is an active item
00:00002DC8 6706            	    52: 	beq.s	ProcessActionDefaultTakeMenu	; 0 = opening a take menu
00:00002DCA 61006B60        	    53: 	bsr.w	DefaultTakeAddItem	; add the item to the player's inventory
00:00002DCE 604C            	    54: 	bra.s	ExitProcessAction	; exit
                            	    55: ProcessActionDefaultTakeMenu:	; default take menu
                            	    56: 	; --------------------------------------------------------------------------
                            	    57: 	; trying to take an item from a scene, test if inventory is full
                            	    58: 	; --------------------------------------------------------------------------
00:00002DD0 0C790004FFFF00AC	    59: 	cmpi.w	#MAX_ITEMS,(MEM_PLAYER_ITEM_COUNT)	; carrying max items?
00:00002DD8 6606            	    60: 	bne.s	ProcessActionBuildActionTableOffset	; branch if < max
00:00002DDA 61006B42        	    61: 	bsr.w	DefaultActionInventoryFull	; launch default action
00:00002DDE 603C            	    62: 	bra.s	ExitProcessAction	; exit
                            	    63: ProcessActionBuildActionTableOffset:
00:00002DE0 6100FC5A        	    64: 	bsr.w	BuildActionTableOffset	; build action table offset
00:00002DE4 4BF90001CDB2    	    65: 	lea	ActionTable,a5	; point to action table
00:00002DEA DAF9FFFF0034    	    66: 	adda.w	(MEM_ACTION_TABLE_OFFSET),a5	; move to offset location
00:00002DF0 2C55            	    67: 	move.l	(a5),a6	; a5 has the address of the subroutine to jump to
00:00002DF2 4E96            	    68: 	jsr	(a6)	; jump to location of code to process this event
                            	    69: 	;---------------------------------------------------------------------------
                            	    70: 	; returning from the action
                            	    71: 	; if the dialog is now titled style then some extra setup is needed
                            	    72: 	;---------------------------------------------------------------------------
00:00002DF4 2E39FFFF0226    	    73: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy flags to d7
00:00002DFA 08070013        	    74: 	btst.l	#DIALOG_FLAG_STYLE_TITLED,d7	; test if flag is set
00:00002DFE 671C            	    75: 	beq.s	ExitProcessAction
00:00002E00 08C7001B        	    76: 	bset.l	#DIALOG_FLAG_TEXT_TITLE_DRAWING,d7	; change state to title drawing
00:00002E04 23C7FFFF0226    	    77: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save updated flags
00:00002E0A 6100FCDA        	    78: 	bsr.w	ClearDialog	; clear the dialog
00:00002E0E 23FC49940003FFFF	    79: 	move.l	#(VDP_VRAM_WRITE_A+DIALOG_TITLE_ROWCOL),(MEM_DIALOG_VDP)
00:00002E16 0232
00:00002E18 6100FA54        	    80: 	bsr.w	ProcessDialogLookupNPCName	; lookup the NPC name
                            	    81: ExitProcessAction:
00:00002E1C 2E39FFFF0028    	    82: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:00002E22 08870004        	    83: 	bclr.l	#STATE_FLAG_ACTION,d7 ; clear action flag
00:00002E26 23C7FFFF0028    	    84: 	move.l	d7,(MEM_GAME_STATE)	; save it back
00:00002E2C 4E75            	    85: 	rts
                            	    86: 

Source: "inc_Subroutines.X68"
                            	    87: 
                            	    88: 	include	'sub_Inventory.X68'

Source: "sub_Inventory.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; subroutines to manage player inventory
                            	     3: ;*******************************************************************************
                            	     4: 
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: ; adds an item to the player's inventory 
                            	     7: ; d7 = item to add
                            	     8: ; d6 is modified by this subroutine
                            	     9: ; a1 is modified by this subroutine
                            	    10: ;-------------------------------------------------------------------------------
                            	    11: AddItem:
00:00002E2E 3C39FFFF00AC    	    12: 	move.w	(MEM_PLAYER_ITEM_COUNT),d6	; copy current item count to d6
00:00002E34 0C460004        	    13: 	cmpi.w	#MAX_ITEMS,d6	; check if inventory is full 
00:00002E38 6C14            	    14: 	bge.s	ExitAddItem	; branch if already at the limit
                            	    15: AddItemFindOpenSlot:
00:00002E3A 5279FFFF00AC    	    16: 	addq	#$1,(MEM_PLAYER_ITEM_COUNT)	; increment item count
00:00002E40 CCFC0002        	    17: 	mulu.w	#WORD_SIZE,d6	; find index of location to write the item
00:00002E44 43F9FFFF00AE    	    18: 	lea MEM_PLAYER_ITEMS,a1	; point to start of item list
00:00002E4A 33876000        	    19: 	move.w	d7,(a1,d6)	; copy the item	
                            	    20: ExitAddItem:
00:00002E4E 4E75            	    21: 	rts
                            	    22: 
                            	    23: ;-------------------------------------------------------------------------------
                            	    24: ; adds an item to the player's inventory
                            	    25: ; overwrites first item if the player's inventory is full  
                            	    26: ; d7 = item to add
                            	    27: ; d6 is modified by this subroutine
                            	    28: ; a1 is modified by this subroutine
                            	    29: ;-------------------------------------------------------------------------------
                            	    30: AddItemOverwrite:
00:00002E50 3C39FFFF00AC    	    31: 	move.w	(MEM_PLAYER_ITEM_COUNT),d6	; copy current item count to d6
00:00002E56 0C460004        	    32: 	cmpi.w	#MAX_ITEMS,d6	; check if inventory is full 
00:00002E5A 6D00FFDE        	    33: 	blt.w	AddItemFindOpenSlot	; branch if below the limit
                            	    34: 	; overwrite the first item
00:00002E5E 43F9FFFF00AE    	    35: 	lea MEM_PLAYER_ITEMS,a1	; point to start of item list
00:00002E64 3247            	    36: 	move.w	d7,a1	; copy the item	
                            	    37: ExitAddItemOverwrite:
00:00002E66 4E75            	    38: 	rts
                            	    39: 
                            	    40: ;-------------------------------------------------------------------------------
                            	    41: ; tests if the player has an item
                            	    42: ; d7 = item to look for
                            	    43: ; d6 will have index of item if found, otherwise FFFF
                            	    44: ; d5 is modified by this subroutine
                            	    45: ; a1 is modified by this subroutine
                            	    46: ;-------------------------------------------------------------------------------
                            	    47: HasItem:
00:00002E68 3C39FFFF00AC    	    48: 	move.w	(MEM_PLAYER_ITEM_COUNT),d6	; copy item count to d6
00:00002E6E 4A46            	    49: 	tst.w	d6	; test if item count is zero
00:00002E70 671E            	    50: 	beq.s	HasItemNotFound	; item count is zero, return FFFF and exit
00:00002E72 5346            	    51: 	subq	#$1,d6	; decrement for zero-based list
00:00002E74 3A06            	    52: 	move.w	d6,d5	; copy item count to d5
00:00002E76 CAFC0002        	    53: 	mulu.w	#WORD_SIZE,d5	; multiply to get the index of the last item
00:00002E7A 43F9FFFF00AE    	    54: 	lea MEM_PLAYER_ITEMS,a1	; point to start of item list
00:00002E80 D3C5            	    55: 	adda.l	d5,a1	; move a1 to last item in the list
                            	    56: HasItemLoop:
00:00002E82 BE51            	    57: 	cmp.w	(a1),d7	; test if this is the item we're looking for
00:00002E84 670E            	    58: 	beq.s	ExitHasItem	; branch if it is
00:00002E86 93FC00000002    	    59: 	suba.l	#WORD_SIZE,a1	; move to next item
00:00002E8C 51CEFFF4        	    60: 	dbra	d6,HasItemLoop	; loop to the end of the list
                            	    61: HasItemNotFound:
00:00002E90 3C3CFFFF        	    62: 	move.w	#$FFFF,d6	; set FFFF as the return value
                            	    63: ExitHasItem:
00:00002E94 4E75            	    64: 	rts
                            	    65: 
                            	    66: ;-------------------------------------------------------------------------------
                            	    67: ; removes an item from the player's inventory
                            	    68: ; d7 = item to remove
                            	    69: ; d5 and d6 are modified by this subroutine
                            	    70: ; a1 is modified by this subroutine
                            	    71: ;-------------------------------------------------------------------------------
                            	    72: RemoveActiveItem:
00:00002E96 3E39FFFF0036    	    73: 	move.w	(MEM_ACTIVE_ITEM),d7	; copy active item to d7
                            	    74: RemoveItem:
00:00002E9C 6100FFCA        	    75: 	bsr.w	HasItem	; test if the item is in the inventory
00:00002EA0 0C46FFFF        	    76: 	cmpi.w	#$FFFF,d6	; test if the item was found
00:00002EA4 6738            	    77: 	beq.s	ExitRemoveItem	; exit if it was not
00:00002EA6 5379FFFF00AC    	    78: 	subq	#$1,(MEM_PLAYER_ITEM_COUNT)	; decrement item count
00:00002EAC 3A06            	    79: 	move.w	d6,d5	; copy item index to d5
00:00002EAE CAFC0002        	    80: 	mulu.w	#WORD_SIZE,d5	; multiply to get the index of the removed item
00:00002EB2 43F9FFFF00AE    	    81: 	lea MEM_PLAYER_ITEMS,a1	; point to start of item list
00:00002EB8 D3C5            	    82: 	adda.l	d5,a1	; move a1 to the removed item
00:00002EBA 32BC0000        	    83: 	move.w	#$0000,(a1)	; clear removed item	
00:00002EBE 3A39FFFF00AC    	    84: 	move.w	(MEM_PLAYER_ITEM_COUNT),d5	; copy item count to d5
00:00002EC4 BA46            	    85: 	cmp.w	d6,d5	; test if the last item in the list was removed
00:00002EC6 6716            	    86: 	beq.s	ExitRemoveItem	; if the last item was removed then exit
00:00002EC8 9A46            	    87: 	sub.w	d6,d5	; subtract item index from count to get loop control
00:00002ECA 5345            	    88: 	subq	#$1,d5	; subtract one from loop control
                            	    89: RemoveItemLoop:
00:00002ECC 32A90002        	    90: 	move.w	(WORD_SIZE,a1),(a1)	; copy item+1 to current item
00:00002ED0 D3FC00000002    	    91: 	adda.l	#WORD_SIZE,a1	; move to next item
00:00002ED6 32BC0000        	    92: 	move.w	#$0000,(a1)	; clear item slot	
00:00002EDA 51CDFFF0        	    93: 	dbra	d5,RemoveItemLoop	; loop to next item
                            	    94: ExitRemoveItem:
00:00002EDE 4E75            	    95: 	rts
                            	    96: 
                            	    97: 

