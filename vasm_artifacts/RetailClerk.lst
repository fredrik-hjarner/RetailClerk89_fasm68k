00:00003DB0 4E75            	   136: 	rts	; exit
                            	   137: Day00Scene00Action02DefaultTake:
00:00003DB2 61005BA8        	   138: 	bsr.w	Scene00DefaultTake	; use scene defaults
00:00003DB6 600000B2        	   139: 	bra.w	ExitDay00Scene00Action02	; exit
                            	   140: Day00Scene00Action02GiveNPC:
