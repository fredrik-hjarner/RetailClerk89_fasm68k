                            	   474: 	; store sprite x in d4, sprite y in d5
00:00002794 7800            	   475: 	moveq	#$0000,d4	; set to 0 by default
00:00002796 7A00            	   476: 	moveq	#$0000,d5	; set to 0 by default
                            	   477: 	; test for option to persist the selector
00:00002798 08070012        	   478: 	btst.l	#DIALOG_FLAG_OPTION_PERSIST_SELECTOR,d7	; test flag
00:0000279C 66000092        	   479: 	bne.w	ExitMoveSelectorSprite	; exit if flag is set
00:000027A0 0807001F        	   480: 	btst.l	#DIALOG_FLAG_TEXT_CLOSING,d7	; test if the dialog is closing
00:000027A4 6666            	   481: 	bne.s	MoveSelectorSpriteUpdateXY	; flag is set move to update VDP section
00:000027A6 08070015        	   482: 	btst.l	#DIALOG_FLAG_STYLE_MENU,d7	; test if this is a menu
00:000027AA 671A            	   483: 	beq.s	MoveSelectorSprite2Choice	; flag is not set, try next test
                            	   484: MoveSelectorSprite3Choice:
00:000027AC 08C70019        	   485: 	bset.l	#DIALOG_FLAG_SELECTION_WAIT,d7	; set waiting for selection flag 
00:000027B0 383C00C8        	   486: 	move.w	#DIALOG_MENU_INIT_SELECTION_X,d4	; x value
                            	   487: 	; move x value based on which item is selected
00:000027B4 7C38            	   488: 	moveq	#$0038,d6	; the selections are 38 apart
00:000027B6 CCF9FFFF0222    	   489: 	mulu.w	(MEM_MENU_SELECTION),d6	; multiply by selection number
00:000027BC D846            	   490: 	add.w	d6,d4	; add result to x
00:000027BE 3A3C0128        	   491: 	move.w	#DIALOG_MENU_INIT_SELECTION_Y,d5	; y value
00:000027C2 5045            	   492: 	addq	#$8,d5	; adjust for options being on 2nd row of dialog
00:000027C4 6046            	   493: 	bra.s	MoveSelectorSpriteUpdateXY	; move to update VDP section
                            	   494: MoveSelectorSprite2Choice:
00:000027C6 08070017        	   495: 	btst.l	#DIALOG_FLAG_STYLE_TEXT_2CHOICE,d7	; test if this is 2 choice menu
00:000027CA 6716            	   496: 	beq.s	MoveSelectorSprite4Choice	; flag is not set, try next test
00:000027CC 08C70019        	   497: 	bset.l	#DIALOG_FLAG_SELECTION_WAIT,d7	; set waiting for selection flag 
00:000027D0 383C00C8        	   498: 	move.w	#DIALOG_MENU_INIT_SELECTION_X,d4	; x value
00:000027D4 3A3C0128        	   499: 	move.w	#DIALOG_MENU_INIT_SELECTION_Y,d5	; y value
                            	   500: 	; move y value based on which item is selected
00:000027D8 7C08            	   501: 	moveq	#$0008,d6	; the selections are 8 apart
00:000027DA CCF9FFFF0222    	   502: 	mulu.w	(MEM_MENU_SELECTION),d6	; multiply by selection number
00:000027E0 DA46            	   503: 	add.w	d6,d5	; add result to y
                            	   504: MoveSelectorSprite4Choice:
00:000027E2 08070016        	   505: 	btst.l	#DIALOG_FLAG_STYLE_TEXT_4CHOICE,d7	; test if this is 4 choice menu
00:000027E6 6724            	   506: 	beq.s	MoveSelectorSpriteUpdateXY	; flag is not set, use default values
00:000027E8 08C70019        	   507: 	bset.l	#DIALOG_FLAG_SELECTION_WAIT,d7	; set waiting for selection flag 
00:000027EC 383C00C8        	   508: 	move.w	#DIALOG_MENU_INIT_SELECTION_X,d4	; x value
00:000027F0 3A3C0128        	   509: 	move.w	#DIALOG_MENU_INIT_SELECTION_Y,d5	; y value
00:000027F4 3C39FFFF0222    	   510: 	move.w	(MEM_MENU_SELECTION),d6	; copy menu selection to d6
                            	   511: 	; if selection is 1 or 3 then move y value
00:000027FA 08060000        	   512: 	btst.l	#$0,d6	; test if the first bit is set
00:000027FE 6702            	   513: 	beq.s	MoveSelectorSprite4ChoiceX	; branch if not
00:00002800 5045            	   514: 	addq	#$0008,d5	; increment y value to move down
                            	   515: MoveSelectorSprite4ChoiceX:	; if selection is 2 or 3 then move x value
