00:0000B376 D91F            	     7: 	dc.w	$d91f
00:0000B378 1127            	     8: 	dc.w	$1127
00:0000B37A 0021            	     9: 	dc.w	$0021
00:0000B37C 2600            	    10: 	dc.w	$2600
00:0000B37E F977            	    11: 	dc.w	$f977 
00:0000B380 EDB0            	    12: 	dc.w    $edb0
