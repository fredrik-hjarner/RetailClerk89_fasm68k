Source: "init_Vectors.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; vectors
                            	     3: ; see-http://www.hacking-cult.org/?r/18/21
                            	     4: ; see also-"68000 Family Assembly Language" 1994 by Alan Clements page 451
                            	     5: ;*******************************************************************************
00:00000000 FFFFFE00        	     6: 	dc.l	$FFFFFE00		; Stack pointer
00:00000004 00000200        	     7: 	dc.l	Start			; Code start
00:00000008 00000940        	     8: 	dc.l	TrapException	; Bus error
00:0000000C 00000940        	     9: 	dc.l	TrapException	; Address error
00:00000010 00000940        	    10: 	dc.l	TrapException	; Illegal instruction
00:00000014 00000940        	    11: 	dc.l	TrapException	; Divistion by zero
00:00000018 00000940        	    12: 	dc.l	TrapException	; CHK exception
00:0000001C 00000940        	    13: 	dc.l	TrapException	; TRAPV exception
00:00000020 00000940        	    14: 	dc.l	TrapException	; Privilege violation
00:00000024 00000940        	    15: 	dc.l	TrapException	; TRACE exeption
00:00000028 00000940        	    16: 	dc.l	TrapException	; Line 1010 emulator
00:0000002C 00000940        	    17: 	dc.l	TrapException	; Line 1111 emulator
00:00000030 00000940        	    18: 	dc.l	TrapException	; Reserved
00:00000034 00000940        	    19: 	dc.l	TrapException	; Reserved
00:00000038 00000940        	    20: 	dc.l	TrapException	; Reserved
00:0000003C 00000940        	    21: 	dc.l	TrapException	; Reserved
