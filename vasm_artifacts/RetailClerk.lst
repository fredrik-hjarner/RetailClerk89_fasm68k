                            	   174: MainGameLoopUpdateNPCSpritesLoop:
                            	   175: 	; if STRUCT_SPRITE_MOVE_FREQUENCY = $FFFF then don't move the sprite
00:000005C2 0C6DFFFF0010    	   176: 	cmpi.w	#$FFFF,(STRUCT_SPRITE_MOVE_FREQUENCY,a5)	; test
00:000005C8 6762            	   177: 	beq.s	MainGameLoopUpdateNPCSpritesLoopEnd	; branch if equal
00:000005CA 0C6D0000000E    	   178: 	cmpi.w	#$0000,(STRUCT_SPRITE_MOVEMENT_COUNTER,a5)	; is the NPC moving?
00:000005D0 66000038        	   179: 	bne	.2	; if MOVEMENT_COUNTER > 0 then the sprite is moving
                            	   180: 	; test if it's time for them to move again
00:000005D4 3C39FFFF001A    	   181: 	move.w	(MEM_VBLANK_COUNTER),d6	; copy vblank counter
00:000005DA CC6D0010        	   182: 	and.w	(STRUCT_SPRITE_MOVE_FREQUENCY,a5),d6	; and against it
00:000005DE BC6D0010        	   183: 	cmp.w	(STRUCT_SPRITE_MOVE_FREQUENCY,a5),d6	; test 
00:000005E2 6648            	   184: 	bne.s	MainGameLoopUpdateNPCSpritesLoopEnd ; not time to move
00:000005E4 3B7C0009000E    	   185: 	move.w	#NPC_SPRITE_MOVE_STEPS,(STRUCT_SPRITE_MOVEMENT_COUNTER,a5)	; reset
                            	   186: 	; set the direction
00:000005EA 546D0018        	   187: 	addq	#$2,(STRUCT_SPRITE_MOVE_INDEX,a5)	; increment index of movement
00:000005EE 3C2D0016        	   188: 	move.w	(STRUCT_SPRITE_MOVE_PATTERN_LENGTH,a5),d6
