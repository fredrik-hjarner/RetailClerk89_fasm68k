                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; game state flags
                            	     3: ;-------------------------------------------------------------------------------
                            	     4: STATE_FLAG_VBLANK=$00	; vblank flag
                            	     5: STATE_FLAG_PAUSED=$01	; game is paused
                            	     6: STATE_FLAG_EXPLORING=$02	; player is controlling the sprite on the map
                            	     7: STATE_FLAG_DIALOG=$03	; player is interacting with a dialog
                            	     8: STATE_FLAG_ACTION=$04	; there is an action queued
                            	     9: STATE_FLAG_SCRIPTED_EVENT=$05	; a scripted event is running
                            	    10: STATE_FLAG_TITLE_SCREEN=$06	; title screen is displaying
                            	    11: STATE_FLAG_EXITS_BLOCKED=$07	; blocks sprite from leaving scene
                            	    12: STATE_FLAG_END_SCREEN=$08	; end screen is displaying
                            	    13: STATE_FLAG_INTRO_SCREEN=$09	; day intro screen is displaying
                            	    14: STATE_FLAG_STATUS_SCREEN=$0A	; status screen is displaying
                            	    15: STATE_FLAG_MALL_CLOSED=$0B	; mall is closed for the night
                            	    16: STATE_FLAG_LOAD_MENU=$0C	; load menu is displaying
                            	    17: 	if	_DEBUG_
                            	    18: STATE_FLAG_DEBUG_MENU=$0F	; debug menu is displaying
                            	    19: 	endif
                            	    20: 
                            	    21: ;-------------------------------------------------------------------------------
                            	    22: ; dialog state flags
                            	    23: ;-------------------------------------------------------------------------------
                            	    24: ; high word of MEM_DIALOG_FLAGS is used to track the state
                            	    25: DIALOG_FLAG_OPTION_PERSIST_SELECTOR=$12	; don't hide the selector after closing
                            	    26: DIALOG_FLAG_STYLE_TITLED=$13	; show dialog with title
                            	    27: DIALOG_FLAG_STYLE_ITEM_MENU=$14	; item menu dialog
                            	    28: DIALOG_FLAG_STYLE_MENU=$15	; overworld menu style dialog
                            	    29: DIALOG_FLAG_STYLE_TEXT_4CHOICE=$16	; dialog has text with selection at the end
                            	    30: DIALOG_FLAG_STYLE_TEXT_2CHOICE=$17	; dialog has text with selection at the end
                            	    31: DIALOG_FLAG_STYLE_SIMPLE_TEXT=$18	; dialog is a simple text dialog
                            	    32: DIALOG_FLAG_SELECTION_WAIT=$19	; waiting for the player to make a selection 
                            	    33: DIALOG_FLAG_TEXT_OPENING=$1A	; dialog is opening
                            	    34: DIALOG_FLAG_TEXT_TITLE_DRAWING=$1B	; dialog title text is drawing
                            	    35: DIALOG_FLAG_TEXT_DRAWING=$1C	; dialog text is drawing
                            	    36: DIALOG_FLAG_TEXT_OPEN=$1D	; dialog is open
                            	    37: DIALOG_FLAG_TEXT_NEW_PAGE=$1E	; dialog text has another page
                            	    38: DIALOG_FLAG_TEXT_CLOSING=$1F	; dialog is closing
                            	    39: 
                            	    40: ;-------------------------------------------------------------------------------
                            	    41: ; global event flags - used to track events across days 
                            	    42: ;-------------------------------------------------------------------------------
                            	    43: GLOBAL_FLAG_PDAWG_CUSTOMER0=$0	; customer 1 of 3 referred
                            	    44: GLOBAL_FLAG_PDAWG_CUSTOMER1=$1	; customer 2 of 3 referred
                            	    45: GLOBAL_FLAG_PDAWG_CUSTOMER2=$2	; customer 3 of 3 referred
                            	    46: GLOBAL_FLAG_JKEY_CPLANET=$3	; npc jordan has the cplanet key
                            	    47: GLOBAL_FLAG_JKEY_SVIDEO=$4	; npc jordan has the svideo key
                            	    48: GLOBAL_FLAG_DANI_GIFT=$5	; Dani has received the secret shopper gift
                            	    49: GLOBAL_FLAG_DB_SAFE=$6	; D.B. found a safe place to hide on day 06
                            	    50: 
                            	    51: ;-------------------------------------------------------------------------------
                            	    52: ; day event flags - used to track events in the current day 
                            	    53: ;-------------------------------------------------------------------------------
                            	    54: EVENT_FLAG_DAY00_NPC00_DIALOG00=$1	; 1st dialog with NPC0
                            	    55: ; in the 1st dialog with NPC1 the player selection affects the 2nd dialog
                            	    56: EVENT_FLAG_DAY00_NPC01_DIALOG00_RESPONSE00=$2	; selected option 0
                            	    57: EVENT_FLAG_DAY00_NPC01_DIALOG00_RESPONSE01=$3	; selected option 1
                            	    58: EVENT_FLAG_DAY00_NPC01_DIALOG01=$4	; 2nd dialog with NPC1
                            	    59: EVENT_FLAG_DAY00_NPC01_GIVE00=$5	; 1st time player gives an item to NPC1
                            	    60: EVENT_FLAG_DAY00_NPC01_GIVE01=$6	; 2nd time player gives an item to NPC1
                            	    61: EVENT_FLAG_DAY00_NPC01_GIVE02=$7		; 3rd time player gives an item to NPC1
                            	    62: EVENT_FLAG_DAY00_EVENT00_COMPLETE=$8	; 1st scripted event complete
                            	    63: EVENT_FLAG_DAY00_EVENT01_COMPLETE=$9	; 2nd scripted event complete
                            	    64: EVENT_FLAG_DAY01_SUB00_COMPLETE=$0	; sub-quest 0 in day 1 complete
                            	    65: EVENT_FLAG_DAY01_SUB01_COMPLETE=$1	; sub-quest 1 in day 1 complete
                            	    66: EVENT_FLAG_DAY02_SUB00_COMPLETE=$0	; sub-quest 0 in day 2 complete
                            	    67: EVENT_FLAG_DAY02_SUB01_STARTED=$1	; sub-quest 1 in day 2 complete
                            	    68: EVENT_FLAG_DAY02_SUB01_MID=$2	; sub-quest 1 in day 2 midpoint
                            	    69: EVENT_FLAG_DAY02_SUB01_COMPLETE=$3	; subquests complete
                            	    70: EVENT_FLAG_DAY02_MID_EVENT=$4	; midpoint event complete
                            	    71: EVENT_FLAG_DAY02_SUB02_STARTED=$5	; sub-quest 2 in day 2 started
                            	    72: EVENT_FLAG_DAY02_SUB02_MID=$6	; sub-quest 2 in day 2 midpoint
                            	    73: EVENT_FLAG_DAY02_SUB02_COMPLETE=$7	; sub-quest 2 in day 2 complete
                            	    74: EVENT_FLAG_DAY03_SUB_TLODGE_STARTED=$0	; tlodge sub-quest day 3 started
                            	    75: EVENT_FLAG_DAY03_SUB_TLODGE_COMPLETE=$1	; tlodge sub-quest day 3 complete
                            	    76: EVENT_FLAG_DAY03_SUB_VB_STARTED=$2	; vb sub-quest day 3 started
                            	    77: EVENT_FLAG_DAY03_SUB_VB_COMPLETE=$3	; vb sub-quest day 3 complete
                            	    78: EVENT_FLAG_DAY04_SUB_STARTED=$0	; secret santa sub-quest started
                            	    79: EVENT_FLAG_DAY04_SUB_NPCFOUND=$1	; found npc to join sub-quest
                            	    80: EVENT_FLAG_DAY04_SUB_FINDGIFTSTARTED=$2	; looking for a gift
                            	    81: EVENT_FLAG_DAY04_SUB_TBOOKS_DIALOG=$3	; dialog at tbooks complete
                            	    82: EVENT_FLAG_DAY04_SUB_CHOICE0=$4	; envelope choice 0 was selected
                            	    83: EVENT_FLAG_DAY04_SUB_CHOICE1=$5	; envelope choice 1 was selected
                            	    84: EVENT_FLAG_DAY04_SUB_TALK_NPC=$6	; talk to NPC about gift they want
                            	    85: EVENT_FLAG_DAY04_SUB_GIFT_GIVEN=$7	; gift given
                            	    86: EVENT_FLAG_DAY04_SUB_GOOD_GIFT=$8	; whether a good gift was given
                            	    87: EVENT_FLAG_DAY04_SUB_COMPLETE=$9	; secret santa sub-quest complete
                            	    88: EVENT_FLAG_DAY05_EVENT_WEATHER=$0	; heard blizzard forecast
                            	    89: EVENT_FLAG_DAY05_EVENT_LEAVING=$1	; trying to leave the mall
                            	    90: EVENT_FLAG_DAY05_EVENT_TALKDANI=$2	; after dialog with Dani
                            	    91: EVENT_FLAG_DAY05_EVENT_SNOWEDIN=$3	; snowed-in to the mall
                            	    92: EVENT_FLAG_DAY05_SUB_STARTED=$4	; subquest to find items started
                            	    93: EVENT_FLAG_DAY05_SUB_COMPLETE=$5	; subquest to find items complete
                            	    94: EVENT_FLAG_DAY05_CAMP_STARTED=$6	; camping scene started
                            	    95: EVENT_FLAG_DAY05_CAMP_COMPLETE=$7	; camping scene complete
                            	    96: EVENT_FLAG_DAY06_EVENT_PLAN=$0	; plan for the day complete
                            	    97: EVENT_FLAG_DAY06_SUB00_STARTED=$1	; sub-quest 0 in day 6 started
                            	    98: EVENT_FLAG_DAY06_SUB00_COMPLETE=$2	; sub-quest 0 in day 6 complete
                            	    99: EVENT_FLAG_DAY06_MISSION_STARTED=$3	; night mission started
                            	   100: EVENT_FLAG_DAY06_MISSION_COMPLETE=$4	; night mission started
                            	   101: EVENT_FLAG_DAY06_ENDING_OPEN=$5	; ending is available
                            	   102: EVENT_FLAG_DAY07_POGODAWG_OPEN=$0	; whether the store is open on the last day
                            	   103: EVENT_FLAG_DAY07_POGODAWG_KEY=$1	; whether the key has been given
                            	   104: EVENT_FLAG_DAY07_LEAVE_VB=$2	; whether it's clear to leave VB
                            	   105: EVENT_FLAG_DAY07_EVENT0=$3	; after talking to Dani in DCountry
                            	   106: EVENT_FLAG_DAY07_EVENT1=$4	; after entering nshack
                            	   107: EVENT_FLAG_DAY07_SEARCH_TENT=$5	; after searching the tents
                            	   108: EVENT_FLAG_DAY07_GOOD_ENDING=$6	; the "good ending" is available
                            	   109: EVENT_FLAG_DAY07_PERFECT_ENDING=$7	; the "perfect ending" is available
                            	   110: 
                            	   111: ;-------------------------------------------------------------------------------
                            	   112: ; mission event flags - used to track progress within sub-quests 
                            	   113: ;-------------------------------------------------------------------------------
                            	   114: MISSION_FLAG_DAY01_SUB00_STARTED=$0	; sub-quest started
                            	   115: MISSION_FLAG_DAY01_SUB00_NPC1_D0R0=$1	; player gave response 0 to dialog 0
                            	   116: MISSION_FLAG_DAY01_SUB00_NPC1_D0R1=$2	; player gave response 1 to dialog 0
                            	   117: MISSION_FLAG_DAY01_SUB00_NPC1_DONE=$3	; done interacting with NPC1
                            	   118: MISSION_FLAG_DAY01_SUB00_NPC2_D0=$4	; first dialog with the NPC
                            	   119: MISSION_FLAG_DAY01_SUB00_NPC2_D1=$5	; second dialog with the NPC
                            	   120: MISSION_FLAG_DAY01_SUB00_NPC2_D2=$6	; third dialog with the NPC
                            	   121: MISSION_FLAG_DAY01_SUB00_NPC2_DONE=$7	; done interacting with NPC2
                            	   122: MISSION_FLAG_DAY01_SUB00_NPC3_D0=$8	; first dialog with the NPC3
                            	   123: MISSION_FLAG_DAY01_SUB00_NPC3_D1=$9	; second dialog with the NPC3
                            	   124: MISSION_FLAG_DAY01_SUB00_NPC3_D2=$A	; third dialog with the NPC3
                            	   125: MISSION_FLAG_DAY01_SUB00_NPC3_DONE=$B	; done interacting with NPC3
                            	   126: MISSION_FLAG_DAY01_SUB02_STARTED=$0	; sub-quest started
                            	   127: MISSION_FLAG_DAY01_SUB02_D0=$1	; first dialog complete
                            	   128: MISSION_FLAG_DAY01_SUB02_D1=$2	; second dialog complete
                            	   129: MISSION_FLAG_DAY02_SUB01_D0=$0	; first event dialog complete
                            	   130: MISSION_FLAG_DAY02_SUB01_D1=$1	; second event dialog complete
                            	   131: MISSION_FLAG_DAY02_SUB01_D2=$2	; third event dialog complete
                            	   132: MISSION_FLAG_DAY02_SUB02_D0=$3	; first event dialog complete
                            	   133: MISSION_FLAG_DAY02_SUB02_D1=$4	; second event dialog complete
                            	   134: MISSION_FLAG_DAY02_SUB02_D2=$5	; third event dialog complete
                            	   135: MISSION_FLAG_DAY03_CAMERA1_GET=$0	; found the first camera
                            	   136: MISSION_FLAG_DAY03_CAMERA1_GIVE=$1	; gave the first camera
                            	   137: MISSION_FLAG_DAY03_CAMERA2_GET=$2	; found the second camera
                            	   138: MISSION_FLAG_DAY03_CAMERA2_GIVE=$3	; gave the second camera
                            	   139: MISSION_FLAG_DAY03_CAMERA3_GET=$4	; found the third camera
                            	   140: MISSION_FLAG_DAY03_CAMERA3_GIVE=$5	; gave the third camera
                            	   141: MISSION_FLAG_DAY05_READBOOK=$0	; read the cookbook
                            	   142: MISSION_FLAG_DAY05_FOOD0GET=$1	; found food item 0
                            	   143: MISSION_FLAG_DAY05_FOOD1GET=$2	; found food item 1
                            	   144: MISSION_FLAG_DAY05_FOOD0GIVE=$3	; gave food item 0
                            	   145: MISSION_FLAG_DAY05_FOOD1GIVE=$4	; gave food item 1
                            	   146: MISSION_FLAG_DAY06_SUB00_GETITEM=$0	; get item in day06 sub00
                            	   147: MISSION_FLAG_DAY06_SCRIPTEDEVENT0=$0	; first scripted event in mission
                            	   148: MISSION_FLAG_DAY06_SCRIPTEDEVENT1=$1	; second scripted event in mission
                            	   149: MISSION_FLAG_DAY06_RADIO=$2	; second scripted event in mission
