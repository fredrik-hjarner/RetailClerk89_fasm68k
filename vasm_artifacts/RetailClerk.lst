                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; scene data structure
                            	     3: ;	-tiles
                            	     4: ;		-tileset count
                            	     5: ;		-references to locations of tilesets to load
                            	     6: ;	-palettes
                            	     7: ;		-palette count
                            	     8: ;		-references to locations of palettes to load
                            	     9: ;	-scenery
                            	    10: ;		-scenery count
                            	    11: ;		-scenery definitions
                            	    12: ;			-Pattern
                            	    13: ;			-Rows -> Word
                            	    14: ;			-Columns -> Word
                            	    15: ;			-Repeat -> Word number of times to repeat the pattern
                            	    16: ;			-Base tile ID -> Word (Base tile ID + Palette + Priority)
                            	    17: ;			-Initial address offset -> Long (either A or B)
                            	    18: ;			-Start Row (or Y) -> Word
                            	    19: ;			-Start Column (or X) -> Word
                            	    20: ;	-objects[]
                            	    21: ;		-object count
                            	    22: ;		-list of objects
                            	    23: ;	-collision data
                            	    24: ;		-size of collision data
                            	    25: ;		-reference to location of collision data
                            	    26: ;	-BGM
                            	    27: ;		-reference to location of background music
