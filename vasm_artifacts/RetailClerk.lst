                            	    61: ;*******************************************************************************
                            	    62: ; main game program
                            	    63: ;*******************************************************************************
                            	    64: 
                            	    65: Main:
                            	    66: 
                            	    67: 	; run the diagnostic loop 
                            	    68: 	if	_EMULATOR_DIAGNOSTICS_
                            	    69: 	include	'sub_DiagnosticLoop.X68'
                            	    70: 	endif
                            	    71: 
                            	    72: 	include	'init_NewGame.X68'

Source: "init_NewGame.X68"
                            	     1: NewGame:
                            	     2: 
00:0000027E 46FC2700        	     3: 	move.w	#$2700,sr		; disable interrupts
                            	     4: 
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: ; init SRAM
                            	     7: ;-------------------------------------------------------------------------------
00:00000282 61000806        	     8: 	bsr.w	InitSRAM
                            	     9: 
                            	    10: InitCounters:
00:00000286 33FC0000FFFF001A	    11: 	move.w	#$0000,(MEM_VBLANK_COUNTER)
00:0000028E 33FC0000FFFF001C	    12: 	move.w	#$0000,(MEM_MAINLOOP_COUNTER)
00:00000296 33FC0000FFFF001E	    13: 	move.w	#$0000,(MEM_FRAME_COUNTER)
                            	    14: 
                            	    15: InitGameState:
00:0000029E 203C00000000    	    16: 	move.l	#$00000000,d0
00:000002A4 08C00006        	    17: 	bset.l	#STATE_FLAG_TITLE_SCREEN,d0	; set title screen flag
00:000002A8 08C00007        	    18: 	bset.l	#STATE_FLAG_EXITS_BLOCKED,d0	; set exits blocked flag
00:000002AC 08C0000B        	    19: 	bset.l	#STATE_FLAG_MALL_CLOSED,d0	; set mall closed flag
00:000002B0 23C0FFFF0028    	    20: 	move.l	d0,(MEM_GAME_STATE)	; save game state
00:000002B6 33FC0000FFFF009A	    21: 	move.w	#$0000,(MEM_DAY)	; starting day is zero
00:000002BE 33FC0000FFFF0026	    22: 	move.w	#OBJECTIVE_D0_O0,(MEM_OBJECTIVE)	; initial objective
00:000002C6 02B900000000FFFF	    23: 	and.l	#$00000000,(MEM_GLOBAL_EVENT_FLAGS)	; clear event flags
00:000002CE 009E
00:000002D0 02B900000000FFFF	    24: 	and.l	#$00000000,(MEM_DAY_EVENT_FLAGS)	; clear event flags
00:000002D8 00A2
00:000002DA 02B900000000FFFF	    25: 	and.l	#$00000000,(MEM_MISSION_EVENT_FLAGS)	; clear mission flags
00:000002E2 00A6
00:000002E4 02B900000000FFFF	    26: 	and.l	#$00000000,(MEM_SCENE_BGM)	; clear BGM
00:000002EC 019E
00:000002EE 33FC0000FFFF009C	    27: 	move.w	#PLAYER_SPRITE_DB,(MEM_PLAYER_SPRITE)	; initial sprite
00:000002F6 61002BE8        	    28: 	bsr.w	ClearPlayerInventory	; clear player inventory
00:000002FA 02B900000000FFFF	    29: 	and.l	#$00000000,(MEM_PLAYER_STORE_KEYS)	; clear store keys
00:00000302 00B6
00:00000304 33FC0000FFFF00AA	    30: 	move.w	#$0000,(MEM_CUSTOMER_FEEDBACK_SCORE)	; clear customer feedback
                            	    31: 
                            	    32: ;-------------------------------------------------------------------------------
                            	    33: ; load the initial NPC locations
                            	    34: ;-------------------------------------------------------------------------------
00:0000030C 61002910        	    35: 	bsr.w	InitNPCLocations
                            	    36: 
00:00000310 46FC2000        	    37: 	move.w	#$2000,sr		; re-enable interrupts
                            	    38: ;-------------------------------------------------------------------------------
                            	    39: ; load the initial scene
                            	    40: ;-------------------------------------------------------------------------------
                            	    41: DisplayLegalScene:
00:00000314 4DF9000138EE    	    42: 	lea	SceneLegal,a6	; address of the scene for the title screen
00:0000031A 6100192E        	    43: 	bsr.w	LoadScene	; branch to LoadScene subroutine
00:0000031E 61002996        	    44: 	bsr.w	FadeIn	; fade in to the intro scene
00:00000322 3E3C0100        	    45: 	move.w	#LEGAL_SCREEN_LOOP,d7	; use d7 for loop control
                            	    46: DisplayLegalSceneLoop:
00:00000326 610005C4        	    47: 	bsr.w	WaitVBlank	; wait for vblank
00:0000032A 51CFFFFA        	    48: 	dbf	d7,DisplayLegalSceneLoop	; loop
                            	    49: 
                            	    50: LoadTitleScene:
00:0000032E 4DF9000139BC    	    51: 	lea	SceneTitle,a6	; address of the scene for the title screen
00:00000334 61001914        	    52: 	bsr.w	LoadScene	; branch to LoadScene subroutine
00:00000338 6100297C        	    53: 	bsr.w	FadeIn	; fade in to the intro scene
00:0000033C 33FC2800FFFF0098	    54: 	move.w	#TITLE_SCREEN_COUNTER_START,(MEM_INTRO_SCENE_COUNTER)
                            	    55: 
                            	    56: ;-------------------------------------------------------------------------------
                            	    57: ; load and setup the sprites
                            	    58: ;-------------------------------------------------------------------------------
00:00000344 46FC2700        	    59: 	move.w	#$2700,sr	; disable interrupts
                            	    60: 
                            	    61: ; sprite zero is used on the menu screen
                            	    62: LoadSpriteZero:
00:00000348 41F90001B17A    	    63: 	lea     SpriteZeroDefinition,a0	; store address of sprite definition
00:0000034E 7001            	    64: 	moveq	#$01,d0	; 1 sprite = 2 longs
00:00000350 23FC7800000200C0	    65: 	move.l	#VDP_VRAM_WRITE_SPRITE,(VDP_CONTROL) ; set write location
00:00000358 0004
                            	    66: LoadSpriteZeroLoop:
00:0000035A 23D800C00000    	    67: 	move.l  (a0)+,(VDP_DATA)
00:00000360 51C8FFF8        	    68: 	dbra    d0,LoadSpriteZeroLoop
                            	    69: 
                            	    70: ; move sprite zero to the first menu item
                            	    71: 	;---------------------------------------------------------------------------
                            	    72: 	; update y
                            	    73: 	;---------------------------------------------------------------------------
00:00000364 2C3C78000002    	    74: 	move.l	#VDP_VRAM_WRITE_SPRITE,d6	; add to sprite table address
00:0000036A 23C600C00004    	    75: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00000370 33FC011800C00000	    76: 	move.w	#$0118,(VDP_DATA)	; copy the new y-coordinate
                            	    77: 	;---------------------------------------------------------------------------
                            	    78: 	; update x
                            	    79: 	;---------------------------------------------------------------------------
00:00000378 DCBC00060000    	    80: 	add.l	#$00060000,d6	; move to x-coordinate
00:0000037E 23C600C00004    	    81: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00000384 33FC017000C00000	    82: 	move.w	#$0170,(VDP_DATA)	; copy the new x-coordinate
                            	    83: 
                            	    84: InitPlayerSprite:
                            	    85: 	; player	
00:0000038C 33FC0001FFFF00BC	    86: 	move.w	#$0001,(MEM_PLAYER_SPRITE_ID)	; player sprite is the 2nd entry
00:00000394 33FC0100FFFF00BE	    87: 	move.w	#SPRITE_PLAYER_INIT_X,(MEM_PLAYER_SPRITE_X)	; starting x location
00:0000039C 33FC0100FFFF00C0	    88: 	move.w	#SPRITE_PLAYER_INIT_Y,(MEM_PLAYER_SPRITE_Y)	; starting y location
00:000003A4 33FC6111FFFF00C2	    89: 	move.w	#SPRITE_PLAYER_PATTERN,(MEM_PLAYER_SPRITE_PATTERN_INDEX) ; pattern
00:000003AC 33FC0000FFFF00C4	    90: 	move.w	#DIRECTION_DOWN,(MEM_PLAYER_SPRITE_DIRECTION)	; direction
00:000003B4 33FC0000FFFF00C6	    91: 	move.w	#$0000,(MEM_PLAYER_SPRITE_FRAME)	; frame
                            	    92: 	; setting SPRITE_STEP_COUNTER to SPRITE_ANIMATION_STEPS forces movement
                            	    93: 	; animation to trigger the next time the sprite moves
00:000003BC 33FC0008FFFF00C8	    94: 	move.w	#SPRITE_ANIMATION_STEPS,(MEM_PLAYER_SPRITE_STEP_COUNTER)
00:000003C4 4DF9FFFF00BC    	    95: 	lea	(MEM_PLAYER_SPRITE_ID),a6	; setup call to FlipSpriteMapPosition
                            	    96: 	if	_SPRITE_COLLISION_
                            	    97: 	bsr.w	FlipSpriteMapPosition	; block the sprite's initial position
                            	    98: 	endif
                            	    99: 
00:000003CA 46FC2000        	   100: 	move.w	#$2000,sr		; re-enable interrupts
                            	   101: 

