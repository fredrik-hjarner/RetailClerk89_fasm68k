                            	   230: ;*******************************************************************************
                            	   231: ; text
                            	   232: ;*******************************************************************************
                            	   233: 	include 'strings_en-us.X68'

Source: "strings_en-us.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; There's a 0.000001% chance this will ever be translated to another language.
                            	     3: ; (Almost) All the game text is in one file to make it easier if that happens.
                            	     4: ;
                            	     5: ; The best way to go about it is:
                            	     6: ;  1) Copy this file and rename it to 'string_[locale].X68'
                            	     7: ;  2) Painfully change all the text
                            	     8: ;  3) Not rename any of the labels
                            	     9: ;  4) Change the include path in the main file
                            	    10: ;  5) Change version in init_Header to avoid confusion
                            	    11: ;  6) Rebuild
                            	    12: ;
                            	    13: ; Things that will make translations difficult:
                            	    14: ;  1) In the overhead view, the dialog displays a fixed 22 chars per row
                            	    15: ;  2) Game font only includes ASCII, unused chars could be re-purposed though
                            	    16: ;  3) The game logo text is not in this file
                            	    17: ;  4) Character & item names are also restricted to small values
                            	    18: ;
                            	    19: ; The second item is the one I feel worst about..
                            	    20: ; It makes adding non-English characters a complete nightmare.
                            	    21: ; Another option would be extending the dialog font but that has issues too..
                            	    22: ; Hint: If you try doing that also make sure to update DIALOG_BASE_TILE.
                            	    23: ;
                            	    24: ; Yes, this script was written by a native English speaker.
                            	    25: ; I know that is very difficult to believe.
                            	    26: ;*******************************************************************************
                            	    27: 
                            	    28: ;-------------------------------------------------------------------------------
                            	    29: ; character constants
                            	    30: ;-------------------------------------------------------------------------------
                            	    31: LF=$0A	; '\n' - used to break text into multiple lines
                            	    32: FF=$0C	; form feed - used to break text into pages
                            	    33: FFR=$0D	; form feed & reset dialog style
                            	    34: ETX=$03	; end of text
                            	    35: OBJNAMEEND=$1E	; end of object name
                            	    36: NPCNAMEEND=$1F	; end of NPC name
                            	    37: ITEMNAMESTART=$1C	; indicator to draw the next item name
                            	    38: ITEMNAMEEND=$1D	; end of item name
                            	    39: CHAR_DQUOTE=$22	; ACSII code for double quote character
                            	    40: 
                            	    41: ;-------------------------------------------------------------------------------
