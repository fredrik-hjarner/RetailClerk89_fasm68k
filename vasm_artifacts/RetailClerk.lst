00:0000041C 41F9FFFF01A2    	    36: 	lea	(MEM_SCENE_PALETTE),a0	; point a0 to the scene palette
00:00000422 23FCC000000000C0	    37: 	move.l	#VDP_CRAM_WRITE,(VDP_CONTROL) ; set up VDP write to CRAM
00:0000042A 0004
00:0000042C 703F            	    38: 	moveq	#$003F,d0	; 64 words of palette data
                            	    39: SetPausedPaletteLoop:
00:0000042E 3218            	    40: 	move.w	(a0)+,d1	; get the next palette entry
00:00000430 E249            	    41: 	lsr	#1,d1	; shift color intensity
                            	    42: 	;	      0000BBBSGGGSRRRS
00:00000432 C27C0666        	    43: 	and.w	#%0000011001100110,d1	; prevent color overflow
00:00000436 33C100C00000    	    44: 	move.w	d1,(VDP_DATA)	; write the palette entry
00:0000043C 51C8FFF0        	    45: 	dbf	d0,SetPausedPaletteLoop	; decrement d0 and loop
00:00000440 6028            	    46: 	bra.s	UpdatePause	; save the paused state
                            	    47: Unpause:
