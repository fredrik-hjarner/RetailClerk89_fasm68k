00:00003C4A 6600001E        	    27: 	bne	Day00Scene00Action01NPCDaniFlag8	; branch if it is
00:00003C4E 08070001        	    28: 	btst.l	#EVENT_FLAG_DAY00_NPC00_DIALOG00,d7	; test if flag set
00:00003C52 66000020        	    29: 	bne	Day00Scene00Action01NPCDaniFlag1	; branch if it is
00:00003C56 08C70001        	    30: 	bset.l	#EVENT_FLAG_DAY00_NPC00_DIALOG00,d7	; set flag
00:00003C5A 23C7FFFF00A2    	    31: 	move.l	d7,(MEM_DAY_EVENT_FLAGS)	; save updated event flags for the day
00:00003C60 4DF90010060C    	    32: 	lea	DialogTextDaniScene00Day00Flag0,a6	; load dialog text
00:00003C66 600000F0        	    33: 	bra.w	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	    34: Day00Scene00Action01NPCDaniFlag8:
00:00003C6A 4DF9001006AC    	    35: 	lea	DialogTextDaniScene00Day00Flag8,a6	; load dialog text
00:00003C70 600000E6        	    36: 	bra.w	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	    37: Day00Scene00Action01NPCDaniFlag1:
00:00003C74 4DF900100664    	    38: 	lea	DialogTextDaniScene00Day00Flag1,a6	; load dialog text
00:00003C7A 600000DC        	    39: 	bra.w	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	    40: Day00Scene00Action01NPCMaleShopper:
                            	    41: 	;---------------------------------------------------------------------------
                            	    42: 	; handle dialog with shopper		
                            	    43: 	;---------------------------------------------------------------------------
00:00003C7E 0C792002FFFF002E	    44: 	cmpi.w	#OBJ_NPC_MALE_SHOPPER0,(MEM_ACTION_TARGET_OBJID)	; test target
00:00003C86 660000B4        	    45: 	bne.w	Day00Scene00Action01NPCGreenberg	; test next NPC
00:00003C8A 08070008        	    46: 	btst.l	#EVENT_FLAG_DAY00_EVENT00_COMPLETE,d7	; test if 1st event ran
00:00003C8E 6600000C        	    47: 	bne	Day00Scene00Action01NPCMaleShopperTestFlag8	; branch if it is
00:00003C92 08070004        	    48: 	btst.l	#EVENT_FLAG_DAY00_NPC01_DIALOG01,d7	; test if flag set
00:00003C96 6600005A        	    49: 	bne	Day00Scene00Action01NPCMaleShopperFlag4	; branch if it is set
                            	    50: 	; if 4 is not set but 2 or 3 are then the player cancelled a dialog
00:00003C9A 600A            	    51: 	bra.s	Day00Scene00Action01NPCMaleShopperTestFlag3 ; no flags are set
                            	    52: Day00Scene00Action01NPCMaleShopperTestFlag8:
00:00003C9C 4DF900100E84    	    53: 	lea	DialogTextMaleShopper0Scene00Day00Flag8,a6	; load dialog text
00:00003CA2 600000B4        	    54: 	bra.w	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	    55: Day00Scene00Action01NPCMaleShopperTestFlag3:
00:00003CA6 08070003        	    56: 	btst.l	#EVENT_FLAG_DAY00_NPC01_DIALOG00_RESPONSE01,d7	; test if flag set
00:00003CAA 6714            	    57: 	beq.s	Day00Scene00Action01NPCMaleShopperTestFlag2	; flag is 0, next test
00:00003CAC 2E39FFFF0226    	    58: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy dialog flags to d7
00:00003CB2 08C70017        	    59: 	bset.l	#DIALOG_FLAG_STYLE_TEXT_2CHOICE,d7	; set text choice flag
00:00003CB6 23C7FFFF0226    	    60: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save updated dialog flags
00:00003CBC 60000208        	    61: 	bra.w	Day00Scene00Action03NPCMaleShopperFlag0R1	; show selection
                            	    62: Day00Scene00Action01NPCMaleShopperTestFlag2:
00:00003CC0 08070002        	    63: 	btst.l	#EVENT_FLAG_DAY00_NPC01_DIALOG00_RESPONSE00,d7	; test if flag set
00:00003CC4 6714            	    64: 	beq.s	Day00Scene00Action01NPCMaleShopperNoFlags	; flag is 0
00:00003CC6 2E39FFFF0226    	    65: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy dialog flags to d7
00:00003CCC 08C70017        	    66: 	bset.l	#DIALOG_FLAG_STYLE_TEXT_2CHOICE,d7	; set text choice flag
00:00003CD0 23C7FFFF0226    	    67: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save updated dialog flags
00:00003CD6 600001CE        	    68: 	bra.w	Day00Scene00Action03NPCMaleShopperFlag0R0	; show selection
                            	    69: Day00Scene00Action01NPCMaleShopperNoFlags:
                            	    70: 	; no flags for this NPC are set - use initial dialog
00:00003CDA 2E39FFFF0226    	    71: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy dialog flags to d7
00:00003CE0 08C70017        	    72: 	bset.l	#DIALOG_FLAG_STYLE_TEXT_2CHOICE,d7	; set text choice flag
00:00003CE4 23C7FFFF0226    	    73: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save updated dialog flags
00:00003CEA 4DF900100B38    	    74: 	lea	DialogTextMaleShopper0Scene00Day00Flag0,a6	; load dialog text
00:00003CF0 6066            	    75: 	bra.s	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	    76: Day00Scene00Action01NPCMaleShopperFlag4:	; flag is set
00:00003CF2 4DF900100E64    	    77: 	lea	DialogTextMaleShopper0Scene00Day00Flag4,a6	; load dialog text
00:00003CF8 605E            	    78: 	bra.s	Day00Scene00Action01CopyDialogText	; branch to setup dialog
                            	    79: Day00Scene00Register:
00:00003CFA 08070008        	    80: 	btst.l	#EVENT_FLAG_DAY00_EVENT00_COMPLETE,d7	; test if 1st event ran
00:00003CFE 6752            	    81: 	beq.s	Day00Scene00Action01Default	; branch if not
00:00003D00 08070009        	    82: 	btst.l	#EVENT_FLAG_DAY00_EVENT01_COMPLETE,d7	; test if 2nd event ran
00:00003D04 664C            	    83: 	bne.s	Day00Scene00Action01Default	; branch if it did
00:00003D06 08C70009        	    84: 	bset.l	#EVENT_FLAG_DAY00_EVENT01_COMPLETE,d7	; set that 2nd event now ran
00:00003D0A 23C7FFFF00A2    	    85: 	move.l	d7,(MEM_DAY_EVENT_FLAGS)	; save the updated day event flags
00:00003D10 2E39FFFF0028    	    86: 	move.l	(MEM_GAME_STATE),d7	; copy game state to d7
00:00003D16 08870007        	    87: 	bclr.l	#STATE_FLAG_EXITS_BLOCKED,d7	; clear flag blocking the exits
00:00003D1A 23C7FFFF0028    	    88: 	move.l	d7,(MEM_GAME_STATE)	; save updated flags
                            	    89: 	; queue the scripted event
00:00003D20 4DF90001B5D2    	    90: 	lea ScriptedEventDay00Exit,a6	; point a6 to event to load
00:00003D26 6100F1D6        	    91: 	bsr.w QueueScriptedEvent	; queue the event
                            	    92: 	; update NPC locations
00:00003D2A 23FC01000000FFFF	    93: 	move.l	#$01000000,(MEM_NPC_LOCATION_PARKINGLOT)
00:00003D32 004C
