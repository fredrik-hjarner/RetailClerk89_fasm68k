                            	    35: 
                            	    36: 	include	'sub_FlipSpriteMapPosition.X68'

Source: "sub_FlipSpriteMapPosition.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; Flips the map data where a sprite is located from 0 to 1 or 1 to 0
                            	     3: ; a6 = address of sprite info start
                            	     4: ; a6 is not modified in this subroutine
                            	     5: ; a3 is modified used to reference collision data
                            	     6: ; d6 is modified to temporarily store sprite row & column
                            	     7: ; d7 is modified to store & update map collision data
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: FlipSpriteMapPosition:
00:000018BC 6100FF72        	    10: 	bsr.w	SetActiveSpriteMapRowCol	; set the active map position
                            	    11: 	;---------------------------------------------------------------------------
                            	    12: 	; block the left side of the sprite
                            	    13: 	;---------------------------------------------------------------------------
00:000018C0 3C39FFFF0288    	    14: 	move.w	(MEM_ACTIVE_SPRITE_LEFT_COLUMN),d6	; copy left column to d6
00:000018C6 47F9FFFF029A    	    15: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:000018CC D6F9FFFF028A    	    16: 	adda.w	(MEM_ACTIVE_SPRITE_HIGH_LEFT),a3 ; move to row
00:000018D2 2E13            	    17: 	move.l	(a3),d7	; copy row data to memory
00:000018D4 0D47            	    18: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:000018D6 2687            	    19: 	move.l	d7,(a3)	; save the map data back
00:000018D8 47F9FFFF029A    	    20: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:000018DE D6F9FFFF028C    	    21: 	adda.w	(MEM_ACTIVE_SPRITE_LOW_LEFT),a3 ; move to row
00:000018E4 2E13            	    22: 	move.l	(a3),d7	; copy row data to memory
00:000018E6 0D47            	    23: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:000018E8 2687            	    24: 	move.l	d7,(a3)	; save the map data back
                            	    25: 	;---------------------------------------------------------------------------
                            	    26: 	; block the right side of the sprite
                            	    27: 	;---------------------------------------------------------------------------
00:000018EA 3C39FFFF028E    	    28: 	move.w	(MEM_ACTIVE_SPRITE_RIGHT_COLUMN),d6	; copy right column to d6
00:000018F0 47F9FFFF029A    	    29: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:000018F6 D6F9FFFF0290    	    30: 	adda.w	(MEM_ACTIVE_SPRITE_HIGH_RIGHT),a3 ; move to row
00:000018FC 2E13            	    31: 	move.l	(a3),d7	; copy row data to memory
00:000018FE 0D47            	    32: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:00001900 2687            	    33: 	move.l	d7,(a3)	; save the map data back
00:00001902 47F9FFFF029A    	    34: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:00001908 D6F9FFFF0292    	    35: 	adda.w	(MEM_ACTIVE_SPRITE_LOW_RIGHT),a3 ; move to row
00:0000190E 2E13            	    36: 	move.l	(a3),d7	; copy row data to memory
00:00001910 0D47            	    37: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:00001912 2687            	    38: 	move.l	d7,(a3)	; save the map data back
                            	    39: 	;---------------------------------------------------------------------------
                            	    40: 	; if the sprite is occupying 3 columns (common) then block the middle
                            	    41: 	;---------------------------------------------------------------------------
00:00001914 3E39FFFF0288    	    42: 	move.w	(MEM_ACTIVE_SPRITE_LEFT_COLUMN),d7	; copy left column to d7
00:0000191A 3C39FFFF028E    	    43: 	move.w	(MEM_ACTIVE_SPRITE_RIGHT_COLUMN),d6	; copy right column to d6
00:00001920 BC47            	    44: 	cmp.w	d7,d6	; test if the right column is greater than the left column
00:00001922 6E06            	    45: 	bgt.s	.1	; if left is greater then the sprite is crossing the middle
                            	    46: 	; if the right column = 1 here then the sprite is on different map halves
00:00001924 0C460001        	    47: 	cmpi.w	#$0001,d6	; test if right column is 1
00:00001928 6D2C            	    48: 	blt.s	.2	; if right column is 1 then continue otherwise branch
                            	    49: 	;---------------------------------------------------------------------------
                            	    50: 	; block middle column based on right columns
                            	    51: 	;---------------------------------------------------------------------------
                            	    52: .1	; right and left side of sprite are on the same half of the map
00:0000192A 5346            	    53: 	subq	#$0001,d6	; decrement right column
00:0000192C BC47            	    54: 	cmp.w	d7,d6	; test if the right and left are touching
00:0000192E 6752            	    55: 	beq.s	ExitFlipSpriteMapPosition ; if they are touching, exit
                            	    56: 	; at this point d6 has the middle column
00:00001930 47F9FFFF029A    	    57: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:00001936 D6F9FFFF0290    	    58: 	adda.w	(MEM_ACTIVE_SPRITE_HIGH_RIGHT),a3 ; move to row
00:0000193C 2E13            	    59: 	move.l	(a3),d7	; copy row data to memory
00:0000193E 0D47            	    60: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:00001940 2687            	    61: 	move.l	d7,(a3)	; save the map data back
00:00001942 47F9FFFF029A    	    62: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:00001948 D6F9FFFF0292    	    63: 	adda.w	(MEM_ACTIVE_SPRITE_LOW_RIGHT),a3 ; move to row
00:0000194E 2E13            	    64: 	move.l	(a3),d7	; copy row data to memory
00:00001950 0D47            	    65: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:00001952 2687            	    66: 	move.l	d7,(a3)	; save the map data back
00:00001954 602C            	    67: 	bra.s	ExitFlipSpriteMapPosition
                            	    68: 	;---------------------------------------------------------------------------
                            	    69: 	; block middle column based on left columns when right column is zero
                            	    70: 	;---------------------------------------------------------------------------
                            	    71: .2	; right & left sides of the sprite are on different halves of the map
00:00001956 0C47001F        	    72: 	cmpi.w	#$001F,d7	; if left column is 1F the sprite is occupying 2 columns
00:0000195A 6726            	    73: 	beq.s	ExitFlipSpriteMapPosition	; exit if the sprite is only 2 columns
                            	    74: 	; otherwise block column 1F in the left rows
00:0000195C 7C1F            	    75: 	moveq	#$001F,d6	; copy left column to d6
00:0000195E 47F9FFFF029A    	    76: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:00001964 D6F9FFFF028A    	    77: 	adda.w	(MEM_ACTIVE_SPRITE_HIGH_LEFT),a3 ; move to row
00:0000196A 2E13            	    78: 	move.l	(a3),d7	; copy row data to memory
00:0000196C 0D47            	    79: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:0000196E 2687            	    80: 	move.l	d7,(a3)	; save the map data back
00:00001970 47F9FFFF029A    	    81: 	lea		MEM_COLLISION_DATA,a3	; move start address of map data to a3
00:00001976 D6F9FFFF028C    	    82: 	adda.w	(MEM_ACTIVE_SPRITE_LOW_LEFT),a3 ; move to row
00:0000197C 2E13            	    83: 	move.l	(a3),d7	; copy row data to memory
00:0000197E 0D47            	    84: 	bchg.l	d6,d7	; flip the map data from 0 to 1 or 1 to 0
00:00001980 2687            	    85: 	move.l	d7,(a3)	; save the map data back
                            	    86: ExitFlipSpriteMapPosition:
00:00001982 4E75            	    87: 	rts
                            	    88: 

Source: "inc_Subroutines.X68"
                            	    37: 
                            	    38: 	include	'sub_StopSprite.X68'

Source: "sub_StopSprite.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; StopSprite
                            	     3: ; sets the pattern for a sprite based on its direction and frame
                            	     4: ; a6 = address of sprite info start
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: StopSprite:
00:00001984 3D7C0000000A    	     7: 	move.w	#$0000,(STRUCT_SPRITE_FRAME,a6) ; move back to frame 0
00:0000198A 6100FA44        	     8: 	bsr.w	UpdateSpritePattern ; branch to move SetSpritePattern
                            	     9: EndStopSprite:
00:0000198E 4E75            	    10: 	rts
                            	    11: 
                            	    12: 

Source: "inc_Subroutines.X68"
                            	    39: 
                            	    40: 	include	'sub_MovePlayer.X68'

Source: "sub_MovePlayer.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; MovePlayer
                            	     3: ; moves the player sprite if a d-pad direction is being pressed
                            	     4: ; calls MoveSprite to actually move the sprite
                            	     5: ; d7 is used to test controller input and scrolling
                            	     6: ; d6 is used to test for scrolling
                            	     7: ; a6 is used to store the start address of the sprite info if there is movement
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: MovePlayer:
00:00001990 028700000000    	    10: 	andi.l	#$00000000,d7	; lazy way to prevent issues
00:00001996 1E39FFFF0022    	    11: 	move.b	(MEM_CONTROL_HELD),d7	; copy button held value to d7 for eor
                            	    12: ;	cmpi.b	#$00,d7				; test if it is zero
00:0000199C 670000B0        	    13: 	beq.w	StopPlayerSprite		; branch if a direction is being held
                            	    14: ;PlayerNotMoving:
                            	    15: ;	bra.w	StopPlayerSprite		; reset the sprite frame
                            	    16: ;	;bra.w	EndMovePlayer	
                            	    17: 
                            	    18: SetPlayerDirection:
                            	    19: ; map key press to direction
                            	    20: TestUpHeld:
00:000019A0 1E39FFFF0022    	    21: 	move.b	(MEM_CONTROL_HELD),d7	; copy button held value to d7 for andi
00:000019A6 02070001        	    22: 	andi.b	#BUTTON_UP_PRESSED,d7	; test if the up button is held
00:000019AA 6714            	    23: 	beq.s	TestDownHeld			; branch if not
00:000019AC 33FC0001FFFF00C4	    24: 	move.w	#DIRECTION_UP,(MEM_PLAYER_SPRITE_DIRECTION)	; set direction
                            	    25: 	; test if player is exiting top edge of scene
00:000019B4 0C790080FFFF00C0	    26: 	cmpi.w	#SCENE_EXIT_TOP,(MEM_PLAYER_SPRITE_Y)	; test if at exit edge
00:000019BC 6E64            	    27: 	bgt.s	MovePlayerSprite	; branch if not
00:000019BE 606E            	    28: 	bra.s	QueueExitAction	; queue an exit scene event
                            	    29: TestDownHeld:
00:000019C0 1E39FFFF0022    	    30: 	move.b	(MEM_CONTROL_HELD),d7	; copy button held value to d7 for andi
00:000019C6 02070002        	    31: 	andi.b	#BUTTON_DOWN_PRESSED,d7	; test if the down button is held
00:000019CA 6714            	    32: 	beq.s	TestLeftHeld			; branch if not
00:000019CC 33FC0000FFFF00C4	    33: 	move.w	#DIRECTION_DOWN,(MEM_PLAYER_SPRITE_DIRECTION)	; set direction
                            	    34: 	; test if player is exiting bottom edge of scene
00:000019D4 0C790150FFFF00C0	    35: 	cmpi.w	#SCENE_EXIT_BOTTOM,(MEM_PLAYER_SPRITE_Y)	; test if at exit edge
00:000019DC 6D44            	    36: 	blt.s	MovePlayerSprite	; branch if not
00:000019DE 604E            	    37: 	bra.s	QueueExitAction	; queue an exit scene event
                            	    38: TestLeftHeld:
00:000019E0 1E39FFFF0022    	    39: 	move.b	(MEM_CONTROL_HELD),d7	; copy button held value to d7 for andi
00:000019E6 02070004        	    40: 	andi.b	#BUTTON_LEFT_PRESSED,d7	; test if the left button is held
00:000019EA 6714            	    41: 	beq.s	TestRightHeld			; branch if not
00:000019EC 33FC0002FFFF00C4	    42: 	move.w	#DIRECTION_LEFT,(MEM_PLAYER_SPRITE_DIRECTION)	; set direction
                            	    43: 	; test if player is exiting left edge of scene
00:000019F4 0C790080FFFF00BE	    44: 	cmpi.w	#SCENE_EXIT_LEFT,(MEM_PLAYER_SPRITE_X)	; test if at exit edge
00:000019FC 6E24            	    45: 	bgt.s	MovePlayerSprite	; branch if not
00:000019FE 602E            	    46: 	bra.s	QueueExitAction	; queue an exit scene event
                            	    47: TestRightHeld:
00:00001A00 1E39FFFF0022    	    48: 	move.b	(MEM_CONTROL_HELD),d7	; copy button held value to d7 for andi
00:00001A06 02070008        	    49: 	andi.b	#BUTTON_RIGHT_PRESSED,d7	; test if the right button is held
00:00001A0A 67000042        	    50: 	beq.w	StopPlayerSprite			; non-directional button held
00:00001A0E 33FC0003FFFF00C4	    51: 	move.w	#DIRECTION_RIGHT,(MEM_PLAYER_SPRITE_DIRECTION)	; set direction
00:00001A16 0C7901BAFFFF00BE	    52: 	cmpi.w	#SCENE_EXIT_RIGHT,(MEM_PLAYER_SPRITE_X)	; test if at exit edge
00:00001A1E 6D02            	    53: 	blt.s	MovePlayerSprite	; branch if not
00:00001A20 600C            	    54: 	bra.s	QueueExitAction	; queue an exit scene event
                            	    55: MovePlayerSprite:
00:00001A22 4DF9FFFF00BC    	    56: 	lea (MEM_PLAYER_SPRITE_ID),a6	; setup call to MoveSprite
00:00001A28 6100FC68        	    57: 	bsr.w	MoveSprite				; branch to move MoveSprite
00:00001A2C 602A            	    58: 	bra.s	EndMovePlayer			; exit
                            	    59: QueueExitAction:
00:00001A2E 2E39FFFF0028    	    60: 	move.l	(MEM_GAME_STATE),d7	; copy game state to d7
00:00001A34 08C70004        	    61: 	bset.l	#STATE_FLAG_ACTION,d7	; set the action flag
00:00001A38 23C7FFFF0028    	    62: 	move.l	d7,(MEM_GAME_STATE)	; save it back
00:00001A3E 33FCF000FFFF002C	    63: 	move.w	#ACTION_EXIT_SCENE,(MEM_ACTION_ID)	; set the action id
                            	    64: 	; test if the exits are blocked
00:00001A46 08070007        	    65: 	btst.l	#STATE_FLAG_EXITS_BLOCKED,d7	; test exits blocked flag
00:00001A4A 6602            	    66: 	bne.s	StopPlayerSprite	; if set stop the sprite
00:00001A4C 60D4            	    67: 	bra.s	MovePlayerSprite	; move the player sprite
                            	    68: StopPlayerSprite:
00:00001A4E 4DF9FFFF00BC    	    69: 	lea (MEM_PLAYER_SPRITE_ID),a6	; setup call to StopSprite
00:00001A54 6100FF2E        	    70: 	bsr.w	StopSprite				; reset the sprite frame
                            	    71: EndMovePlayer:
00:00001A58 4E75            	    72: 	rts
                            	    73: 
                            	    74: 

Source: "inc_Subroutines.X68"
                            	    41: 
                            	    42: 	include	'sub_LoadPlayerSprite.X68'

Source: "sub_LoadPlayerSprite.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; also loads sprite zero
                            	     3: ; d0, a0, and a6 are modified
                            	     4: ;-------------------------------------------------------------------------------
                            	     5: LoadPlayerSprite:
00:00001A5A 6100EE90        	     6: 	bsr.w	WaitVBlank	; wait for vblank to complete
00:00001A5E 46FC2700        	     7: 	move.w	#$2700,sr		; disable interrupts
00:00001A62 41F90001B17A    	     8: 	lea     SpriteZeroDefinition,a0	; store address of sprite definition
00:00001A68 7003            	     9: 	moveq	#$03,d0	; 1 sprite = 2 longs
00:00001A6A 23FC7800000200C0	    10: 	move.l	#VDP_VRAM_WRITE_SPRITE,(VDP_CONTROL) ; set write location
00:00001A72 0004
                            	    11: LoadPlayerSpriteLoop:
00:00001A74 23D800C00000    	    12: 	move.l  (a0)+,(VDP_DATA)
00:00001A7A 51C8FFF8        	    13: 	dbra    d0,LoadPlayerSpriteLoop
                            	    14: 	if	_SPRITE_COLLISION_
                            	    15: 	lea	(MEM_PLAYER_SPRITE_ID),a6	; setup call to FlipSpriteMapPosition
                            	    16: 	bsr.w	FlipSpriteMapPosition	; block the sprite's initial position
                            	    17: 	endif
                            	    18: 	; call to StopSprite is to fix an issue where wrong tiles display
00:00001A7E 4DF9FFFF00BC    	    19: 	lea (MEM_PLAYER_SPRITE_ID),a6	; setup call to StopSprite
00:00001A84 6100FEFE        	    20: 	bsr.w	StopSprite	; reset the sprite frame
                            	    21: ExitLoadPlayerSprite:
00:00001A88 46FC2000        	    22: 	move.w	#$2000,sr		; re-enable interrupts
00:00001A8C 4E75            	    23: 	rts
                            	    24: 

Source: "inc_Subroutines.X68"
                            	    43: 
                            	    44: 	include	'sub_LoadSpriteTiles.X68'

Source: "sub_LoadSpriteTiles.X68"
                            	     1: LoadSpriteZeroTiles:
00:00001A8E 6100EE5C        	     2: 	bsr.w	WaitVBlank	; added to resolve issue running in Genecyst
00:00001A92 46FC2700        	     3: 	move.w	#$2700,sr		; disable interrupts
00:00001A96 41F90015681C    	     4: 	lea	SpriteZeroTilesStart,a0	; set address of first tile to load
00:00001A9C 323C2200        	     5: 	move.w	#SPRITE_VDP,d1	; setup call to BuildVRAMWriteAddress
00:00001AA0 610010A2        	     6: 	bsr.w	BuildVRAMWriteAddress	; build the VRAM write address
00:00001AA4 7008            	     7: 	moveq	#$8,d0	; number of tiles in a sprite tileset
00:00001AA6 6100EF00        	     8: 	bsr.w	LoadTiles	; branch to LoadTiles subroutine
00:00001AAA 46FC2000        	     9: 	move.w	#$2000,sr	; re-enable interrupts
00:00001AAE 4E75            	    10: 	rts
                            	    11: 
                            	    12: LoadPlayerSpriteTiles:
00:00001AB0 6100EE3A        	    13: 	bsr.w	WaitVBlank	; added to resolve issue running in Genecyst
00:00001AB4 46FC2700        	    14: 	move.w	#$2700,sr		; disable interrupts
00:00001AB8 0C790001FFFF009C	    15: 	cmpi.w	#PLAYER_SPRITE_DANI,(MEM_PLAYER_SPRITE)	; which sprite tiles to use?
00:00001AC0 6712            	    16: 	beq.s	.1	; branch to use tiles for Dani
00:00001AC2 0C790002FFFF009C	    17: 	cmpi.w	#PLAYER_SPRITE_FCBCAMPING,(MEM_PLAYER_SPRITE)
00:00001ACA 6710            	    18: 	beq.s	.2	; branch to use tiles for FCBCamping sprite
                            	    19: 	; else use default tiles
00:00001ACC 41F90015683C    	    20: 	lea	PlayerSpriteTilesStart,a0	; set address of first tile to load
00:00001AD2 600E            	    21: 	bra.s	.3	; branch to write tiles to VPD
                            	    22: .1	; using the Dani tiles for the player sprite
00:00001AD4 41F90015743C    	    23: 	lea	NPCSpriteDaniTilesStart,a0	; set address of first tile to load
00:00001ADA 6006            	    24: 	bra.s	.3	; branch to write tiles to VPD
                            	    25: .2	; using the FCBCamping tiles for the player sprite - only used at the ending
00:00001ADC 41F90016A03C    	    26: 	lea	Scene16StaffNPCTilesStart,a0	; set address of first tile to load
                            	    27: .3	; write tiles to VDP
00:00001AE2 323C2220        	    28: 	move.w	#PLAYER_SPRITE_VDP,d1	; setup call to BuildVRAMWriteAddress
00:00001AE6 6100105C        	    29: 	bsr.w	BuildVRAMWriteAddress	; build the VRAM write address
00:00001AEA 303C0300        	    30: 	move.w	#SPRITE_TILESET_LWORDS,d0	; number of tiles in a sprite tileset
00:00001AEE 6100EEB8        	    31: 	bsr.w	LoadTiles	; branch to LoadTiles subroutine
00:00001AF2 46FC2000        	    32: 	move.w	#$2000,sr	; re-enable interrupts
00:00001AF6 4E75            	    33: 	rts
                            	    34: 

Source: "inc_Subroutines.X68"
                            	    45: 
                            	    46: 	include 'sub_FindActionTarget.X68'

Source: "sub_FindActionTarget.X68"
                            	     1: FindActionTarget:	; note - d6 and d7 are used by caller
                            	     2: 	; d4 - store player sprite x
00:00001AF8 3839FFFF00BE    	     3: 	move.w	(MEM_PLAYER_SPRITE_X),d4	; move base sprite x
                            	     4: 	; d5 - store sprite y
00:00001AFE 3A39FFFF00C0    	     5: 	move.w	(MEM_PLAYER_SPRITE_Y),d5	; move base sprite y
00:00001B04 DA7C0010        	     6: 	add.w	#SPRITE_COLLISION_Y,d5	; adjust for collision Y
                            	     7: 	; determine what the player is looking at
00:00001B08 3639FFFF00C4    	     8: 	move.w	(MEM_PLAYER_SPRITE_DIRECTION),d3	; copy direction
00:00001B0E 0C430001        	     9: 	cmpi.w	#DIRECTION_UP,d3	; test if sprite is facing up
00:00001B12 6606            	    10: 	bne.s	.1 	; branch if not
00:00001B14 5345            	    11: 	subq	#SPRITE_COLLISION_UP,d5	; adjust y
00:00001B16 60000026        	    12: 	bra.w	.4	; branch to object list search
                            	    13: .1	; down
00:00001B1A 0C430000        	    14: 	cmpi.w	#DIRECTION_DOWN,d3	; test if sprite is facing down
00:00001B1E 6608            	    15: 	bne.s	.2 	; branch if not
00:00001B20 DA7C0011        	    16: 	add.w	#SPRITE_COLLISION_DOWN,d5	; adjust y
00:00001B24 60000018        	    17: 	bra.w	.4	; branch to object list search
                            	    18: .2	; left
00:00001B28 0C430002        	    19: 	cmpi.w	#DIRECTION_LEFT,d3	; test if sprite is facing left
00:00001B2C 6606            	    20: 	bne.s	.3 	; branch if not
00:00001B2E 5344            	    21: 	subq	#SPRITE_COLLISION_LEFT,d4	; adjust x
00:00001B30 6000000C        	    22: 	bra.w	.4	; branch to object list search
                            	    23: .3	; right
00:00001B34 0C430003        	    24: 	cmpi.w	#DIRECTION_RIGHT,d3	; test if sprite is facing right
00:00001B38 6604            	    25: 	bne.s	.4 	; not reachable unless there's a bug in MovePlayer
00:00001B3A D87C0011        	    26: 	add.w	#SPRITE_COLLISION_RIGHT,d4	; adjust x
                            	    27: .4
                            	    28: 	; search object list	
00:00001B3E 41F9FFFF014A    	    29: 	lea	MEM_OBJECT_LIST_OBJS,a0	; point a0 to the object list
00:00001B44 363C000D        	    30: 	move.w	#OBJ_LIST_LOOP_CTRL,d3	; use d3 for loop control
                            	    31: 	;---------------------------------------------------------------------------
                            	    32: 	; hit test = ((htx>=x1)&&(htx<=x0))&&((hty>y0)&&(hty<y1))
                            	    33: 	; where
                            	    34: 	; htx = sprite x adjusted for map scroll
                            	    35: 	; hty = sprite y adjusted for map scorll
                            	    36: 	; x0 = right edge of object rect
                            	    37: 	; x1 = left edge of object rect
                            	    38: 	; y0 = bottom edge of object rect
                            	    39: 	; y1 = top edge of object rect
                            	    40: 	;---------------------------------------------------------------------------
                            	    41: FindActionTargetObjectLoop:
                            	    42: 	;---------------------------------------------------------------------------
                            	    43: 	; a0   = word0=Object ID (0-65535)
                            	    44: 	; a0+2 = word1[0-8]=x0 (0-511) word1[9-15]=width (0-127)
                            	    45: 	; a0+4 = word2[0-8]=y0 (0-512) word2[9-15]=height (0-127)
                            	    46: 	;---------------------------------------------------------------------------
00:00001B48 33D0FFFF002E    	    47: 	move.w	(a0),(MEM_ACTION_TARGET_OBJID)	; copy the current object id
00:00001B4E 0C790000FFFF002E	    48: 	cmpi.w	#OBJ_NOTHING,(MEM_ACTION_TARGET_OBJID)	; looking at nothing?
00:00001B56 6700004E        	    49: 	beq.w	FindActionTargetObjectLoopDbra	; if so loop to next object
                            	    50: 	; test if sprite x is between left and right edge
00:00001B5A 34280002        	    51: 	move.w	(2,a0),d2	; copy word 1 (x and width)
00:00001B5E 3202            	    52: 	move.w	d2,d1	; use d1 for width
00:00001B60 C47C01FF        	    53: 	and.w	#%0000000111111111,d2	; clear bits[9-15]
00:00001B64 B842            	    54: 	cmp.w	d2,d4	; (htx>=x1)
00:00001B66 6D00003E        	    55: 	blt.w	FindActionTargetObjectLoopDbra ; loop if sprite x < object left
                            	    56: 	; need to shift 9 bits right
00:00001B6A E049            	    57: 	lsr.w	#$08,d1	; shift 8
00:00001B6C E249            	    58: 	lsr.w	#$01,d1	; shift 1 more
00:00001B6E D441            	    59: 	add.w	d1,d2	; add width to left edge to get right edge
00:00001B70 B842            	    60: 	cmp.w	d2,d4	; (htx<=x0)
00:00001B72 6E000032        	    61: 	bgt.w	FindActionTargetObjectLoopDbra ; loop if sprite x > object right
                            	    62: 	; test if sprite y is between top and bottom edge
00:00001B76 34280004        	    63: 	move.w	(4,a0),d2	; copy word 2 (y and width)
00:00001B7A 3202            	    64: 	move.w	d2,d1	; use d1 for height
00:00001B7C C47C01FF        	    65: 	and.w	#%0000000111111111,d2	; clear bits[9-15]
00:00001B80 BA42            	    66: 	cmp.w	d2,d5	; (hty>y0)
00:00001B82 6D000022        	    67: 	blt.w	FindActionTargetObjectLoopDbra ; loop if sprite y < object top
                            	    68: 	; need to shift 9 bits right
00:00001B86 E049            	    69: 	lsr.w	#$08,d1	; shift 8
00:00001B88 E249            	    70: 	lsr.w	#$01,d1	; shift 1 more
00:00001B8A D441            	    71: 	add.w	d1,d2	; add height to top edge to get bottom edge
00:00001B8C BA42            	    72: 	cmp.w	d2,d5	; (hty<y1)
00:00001B8E 6C000016        	    73: 	bge.w	FindActionTargetObjectLoopDbra ; loop if no hit
                            	    74: 	; determine if this is an NPC
00:00001B92 343C0003        	    75: 	move.w	#NPC_LIST_LENGTH-1,d2	; if d3<NPC_LIST_LENGTH then we have an NPC
00:00001B96 9443            	    76: 	sub.w	d3,d2	; subtract d3 from d2
00:00001B98 6C04            	    77: 	bge.s	.1	; branch if the result is positive
00:00001B9A 343CFFFF        	    78: 	move.w	#$FFFF,d2	; set NPC id as -1 
                            	    79: .1
00:00001B9E 33C2FFFF0030    	    80: 	move.w	d2,(MEM_ACTION_TARGET_NPCID)	; store NPC id
00:00001BA4 6018            	    81: 	bra.s	ExitFindActionTarget	; exit
                            	    82: FindActionTargetObjectLoopDbra:
00:00001BA6 D0FC0006        	    83: 	adda.w	#OBJ_LIST_STRUCT_SIZE,a0	; move to next object list entry
00:00001BAA 51CBFF9C        	    84: 	dbra    d3,FindActionTargetObjectLoop	; decrement and loop
                            	    85: ActionTargetNotFound:
00:00001BAE 33FC0000FFFF002E	    86: 	move.w	#OBJ_NOTHING,(MEM_ACTION_TARGET_OBJID)	; nothing by default
00:00001BB6 33FCFFFFFFFF0030	    87: 	move.w	#$FFFF,(MEM_ACTION_TARGET_NPCID)	; nothing by default
                            	    88: ExitFindActionTarget:
00:00001BBE 4E75            	    89: 	rts
                            	    90: 
                            	    91: 

Source: "inc_Subroutines.X68"
                            	    47: 
                            	    48: 	include 'sub_BuildNPCObjectList.X68'

Source: "sub_BuildNPCObjectList.X68"
                            	     1: BuildNPCObjectList:
                            	     2: 	;---------------------------------------------------------------------------
                            	     3: 	; point a1 to location of the NPC list for the current scene
                            	     4: 	;---------------------------------------------------------------------------
00:00001BC0 43F9FFFF0038    	     5: 	lea	MEM_NPC_LOCATIONS,a1	; point a1 to the start of the list
00:00001BC6 3A39FFFF013E    	     6: 	move.w	(MEM_ACTIVE_SCENE_ID),d5	; copy active scene ID to d5
00:00001BCC CAFC0004        	     7: 	mulu.w	#NPC_LIST_LENGTH,d5	; multiply by list length
00:00001BD0 D2C5            	     8: 	adda.w	d5,a1	; add result to a1 to move to npc list for active scene
                            	     9: 	;---------------------------------------------------------------------------
                            	    10: 	; setup loop control - 2 NPCs per word in MEM_NPC_LOCATIONS
                            	    11: 	;---------------------------------------------------------------------------
00:00001BD2 383C0001        	    12: 	move.w	#(NPC_LIST_LENGTH-1)/2,d4	; use d4 for loop control
                            	    13: 	;---------------------------------------------------------------------------
                            	    14: 	; loop through all NPCs and add them to the list
                            	    15: 	;---------------------------------------------------------------------------
00:00001BD6 41F9FFFF0186    	    16: 	lea	MEM_OBJECT_LIST_NPCS,a0	; point to start of NPC location table
00:00001BDC 45F9FFFF00D6    	    17: 	lea	MEM_NPC0_SPRITE_ID,a2	; point to first NPC in memory
                            	    18: BuildNPCObjectListLoop:
                            	    19: 	;---------------------------------------------------------------------------
                            	    20: 	; object list structure
                            	    21: 	; word0=Object ID (0-65535)
                            	    22: 	; word1[0-8]=x0 (0-511)
                            	    23: 	; word1[9-15]=width (0-127)
                            	    24: 	; word2[0-8]=y0 (0-512)
                            	    25: 	; word2[9-15]=height (0-127)
                            	    26: 	;---------------------------------------------------------------------------	
00:00001BE2 3619            	    27: 	move.w	(a1)+,d3	; copy next NPC pair to d3
00:00001BE4 3403            	    28: 	move.w	d3,d2	; use d2 for first byte
00:00001BE6 C47CFF00        	    29: 	and.w	#$FF00,d2	; clear low byte	
00:00001BEA 670A            	    30: 	beq.s	.1	; branch if the result of the and is zero
00:00001BEC E04A            	    31: 	lsr.w	#$8,d2	; shift upper word to lower
00:00001BEE 4EB900001C24    	    32: 	jsr	StoreNPC	; save this NPC
00:00001BF4 600C            	    33: 	bra.s	.2	; move to next NPC
                            	    34: .1	; first NPC in pair is 0
00:00001BF6 30FC0000        	    35: 	move.w	#OBJ_NOTHING,(a0)+
00:00001BFA 30FC0000        	    36: 	move.w	#$0000,(a0)+
00:00001BFE 30FC0000        	    37: 	move.w	#$0000,(a0)+
                            	    38: .2	; test the second NPC in the pair
00:00001C02 3403            	    39: 	move.w	d3,d2	; copy NPC pair to d2 again
00:00001C04 C47C00FF        	    40: 	and.w	#$00FF,d2	; clear high byte	
00:00001C08 6708            	    41: 	beq.s	.3	; branch if the result of the and is zero
00:00001C0A 4EB900001C24    	    42: 	jsr	StoreNPC	; save this NPC
00:00001C10 600C            	    43: 	bra.s	.4	; move to next NPC pair
                            	    44: .3	; second NPC in pair is 0
00:00001C12 30FC0000        	    45: 	move.w	#OBJ_NOTHING,(a0)+
00:00001C16 30FC0000        	    46: 	move.w	#$0000,(a0)+
00:00001C1A 30FC0000        	    47: 	move.w	#$0000,(a0)+
                            	    48: .4	; move to the next NPC pair
00:00001C1E 51CCFFC2        	    49: 	dbra d4,BuildNPCObjectListLoop	; loop
                            	    50: ExitBuildNPCObjectList:
00:00001C22 4E75            	    51: 	rts
                            	    52: 
                            	    53: StoreNPC:
                            	    54: 	; word0=Object ID (0-65535)
00:00001C24 3A3C2000        	    55: 	move.w	#OBJ_NPC_BASE,d5	; NPC base ID
00:00001C28 DA42            	    56: 	add.w	d2,d5	; add NPC ID
00:00001C2A 30C5            	    57: 	move.w	d5,(a0)+	; add to object list
                            	    58: 	; word1[0-8]=x0 (0-511)
                            	    59: 	; word1[9-15]=width (0-127)
00:00001C2C 3A2A0002        	    60: 	move.w	(STRUCT_SPRITE_X,a2),d5	; store x position in d5
00:00001C30 5145            	    61: 	subq	#$0008,d5	; buffer area around sprite
00:00001C32 8A7C4000        	    62: 	or.w	#%0100000000000000,d5	; append sprite width+buffer to bits [9-15]
00:00001C36 30C5            	    63: 	move.w	d5,(a0)+	; store word 1
                            	    64: 	; word2[0-8]=y0 (0-512)
                            	    65: 	; word2[9-15]=height (0-127)
00:00001C38 3A2A0004        	    66: 	move.w	(STRUCT_SPRITE_Y,a2),d5	; store y position in d5
00:00001C3C 5145            	    67: 	subq	#$0008,d5	; buffer area around sprite
00:00001C3E 8A7C6000        	    68: 	or.w	#%0110000000000000,d5	; append sprite height+buffer to bits [9-15]
00:00001C42 30C5            	    69: 	move.w	d5,(a0)+	; store word 2
                            	    70: ExitStoreNPC:
00:00001C44 D4FC001A        	    71: 	adda.w	#NPC_RECORD_SIZE,a2	; increment to next NPC
00:00001C48 4E75            	    72: 	rts
                            	    73: 
                            	    74: 

Source: "inc_Subroutines.X68"
                            	    49: 
                            	    50: 	include 'sub_LoadScene.X68'

Source: "sub_LoadScene.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; LoadScene
                            	     3: ; clears the current scene and loads a new one 
                            	     4: ; Parameters
                            	     5: ; a6 = starting address of scene to load
                            	     6: ; other registers used
                            	     7: ; a0 & a1 are used to call other subroutines
                            	     8: ; assume that d0-d7 are used either by this subroutine or others it calls
                            	     9: ;-------------------------------------------------------------------------------
                            	    10: LoadScene:
                            	    11: ;---------------------------------------------------------------------------
                            	    12: ; scene ID
                            	    13: ;---------------------------------------------------------------------------
00:00001C4A 33DEFFFF013E    	    14: 	move.w	(a6)+,(MEM_ACTIVE_SCENE_ID)	; scene ID
                            	    15: 
                            	    16: ;-------------------------------------------------------------------------------
                            	    17: ; load tiles and palettes then draw the scene
                            	    18: ;-------------------------------------------------------------------------------
00:00001C50 610001E0        	    19: 	bsr.w	DrawScene	; branch to subroutine to draw the scene
                            	    20: 
00:00001C54 46FC2700        	    21: 	move.w	#$2700,sr		; disable interrupts
                            	    22: ;-------------------------------------------------------------------------------
                            	    23: ; load objects
                            	    24: ;-------------------------------------------------------------------------------
00:00001C58 3E1E            	    25: 	move.w	(a6)+,d7	; number of objects to load
00:00001C5A 41F9FFFF014A    	    26: 	lea	MEM_OBJECT_LIST_OBJS,a0	; address of object data
                            	    27: LoadSceneLoadObjectsLoop:
00:00001C60 30DE            	    28: 	move.w	(a6)+,(a0)+	; word0 (object ID)
00:00001C62 30DE            	    29: 	move.w	(a6)+,(a0)+	; word1 (x+width)
00:00001C64 30DE            	    30: 	move.w	(a6)+,(a0)+	; word2 (y+height)
00:00001C66 51CFFFF8        	    31: 	dbra d7,LoadSceneLoadObjectsLoop	; loop until all data is loaded
                            	    32: 
                            	    33: ;-------------------------------------------------------------------------------
                            	    34: ; load collision data
                            	    35: ;-------------------------------------------------------------------------------
00:00001C6A 3E1E            	    36: 	move.w	(a6)+,d7	; size of collision data
00:00001C6C 0C470000        	    37: 	cmpi.w	#$0000,d7	; test if no collision data
00:00001C70 670E            	    38: 	beq.s	LoadSceneLoadExits	; branch if no collision data
00:00001C72 205E            	    39: 	movea.l	(a6)+,a0	; start address of collision data
00:00001C74 43F9FFFF029A    	    40: 	lea	MEM_COLLISION_DATA,a1	; store destination memory location
                            	    41: LoadSceneLoadMapCollisionLoop:
00:00001C7A 22D8            	    42: 	move.l  (a0)+,(a1)+
00:00001C7C 51CFFFFC        	    43: 	dbra    d7,LoadSceneLoadMapCollisionLoop
                            	    44: 
                            	    45: ;-------------------------------------------------------------------------------
                            	    46: ; load scene exits
                            	    47: ;-------------------------------------------------------------------------------
                            	    48: LoadSceneLoadExits:
00:00001C80 33DEFFFF0140    	    49: 	move.w	(a6)+,(MEM_ACTIVE_SCENE_EXIT_S)	; north exit of active scene
00:00001C86 33DEFFFF0142    	    50: 	move.w	(a6)+,(MEM_ACTIVE_SCENE_EXIT_N)	; south exit of active scene
00:00001C8C 33DEFFFF0144    	    51: 	move.w	(a6)+,(MEM_ACTIVE_SCENE_EXIT_W)	; east exit of active scene
00:00001C92 33DEFFFF0146    	    52: 	move.w	(a6)+,(MEM_ACTIVE_SCENE_EXIT_E)	; west exit of active scene
                            	    53: 
                            	    54: ;-------------------------------------------------------------------------------
                            	    55: ; load sprite zero and player sprite
                            	    56: ;-------------------------------------------------------------------------------
00:00001C98 46FC2000        	    57: 	move.w	#$2000,sr		; re-enable interrupts
                            	    58: 
00:00001C9C 6100FDF0        	    59: 	bsr.w	LoadSpriteZeroTiles
00:00001CA0 6100FE0E        	    60: 	bsr.w	LoadPlayerSpriteTiles
                            	    61: 
00:00001CA4 46FC2700        	    62: 	move.w	#$2700,sr		; disable interrupts
                            	    63: 
                            	    64: ;-------------------------------------------------------------------------------
                            	    65: ; load NPCs
                            	    66: ;-------------------------------------------------------------------------------
                            	    67: LoadSceneLoadNPCData:
00:00001CA8 3E1E            	    68: 	move.w	(a6)+,d7	; number of NPC slots in the scene
00:00001CAA 7C02            	    69: 	moveq	#$0002,d6	; use d6 to track sprite ID
00:00001CAC 3A3C6171        	    70: 	move.w	#NPC0_BASE_TILE,d5	; use d5 to track the base tile
00:00001CB0 41F9FFFF00D6    	    71: 	lea	MEM_NPC0_SPRITE_ID,a0	; point a0 to the first NPC sprite
00:00001CB6 0C470003        	    72: 	cmpi.w	#(NPC_LIST_LENGTH-1),d7	; test to defend against my own stupidity
00:00001CBA 6304            	    73: 	bls.s	LoadSceneLoadNPCDataLoop	; did I add more NPCs than supported?
00:00001CBC 3E3C0003        	    74: 	move.w	#(NPC_LIST_LENGTH-1),d7	; set d7 to the max possible NPCs
                            	    75: LoadSceneLoadNPCDataLoop:
00:00001CC0 30C6            	    76: 	move.w	d6,(a0)+	; ID
00:00001CC2 30DE            	    77: 	move.w	(a6)+,(a0)+	; x
00:00001CC4 30DE            	    78: 	move.w	(a6)+,(a0)+	; y
00:00001CC6 30C5            	    79: 	move.w	d5,(a0)+ ; pattern
00:00001CC8 30DE            	    80: 	move.w	(a6)+,(a0)+	; direction
00:00001CCA 30FC0000        	    81: 	move.w	#$0000,(a0)+	; frame
00:00001CCE 30FC0000        	    82: 	move.w	#$0000,(a0)+	; step counter
00:00001CD2 30FC0000        	    83: 	move.w	#$0000,(a0)+	; move counter
00:00001CD6 30DE            	    84: 	move.w	(a6)+,(a0)+	; movement frequency
00:00001CD8 20DE            	    85: 	move.l	(a6)+,(a0)+	; movement pattern
00:00001CDA 30DE            	    86: 	move.w	(a6)+,(a0)+	; movement pattern length
00:00001CDC 30FC0000        	    87: 	move.w	#$0000,(a0)+	; movement index
00:00001CE0 5246            	    88: 	addq	#$1,d6	; increment sprite ID
00:00001CE2 DA7C0060        	    89: 	add.w	#NPC_BASE_TILE_INC,d5	; increment base tile
00:00001CE6 51CFFFD8        	    90: 	dbra    d7,LoadSceneLoadNPCDataLoop
                            	    91: 
00:00001CEA 61000036        	    92: 	bsr.w	LoadSceneLoadNPCSprites
                            	    93: 
                            	    94: 	; once all NPCs have been added, rebuild the object list
00:00001CEE 6100FED0        	    95: 	bsr.w	BuildNPCObjectList
                            	    96: 
                            	    97: ;-------------------------------------------------------------------------------
                            	    98: ; setup to rebuild sprite order after loading new NPCs
                            	    99: ;-------------------------------------------------------------------------------
00:00001CF2 61000CE8        	   100: 	bsr.w	SetDefaultSpriteOrder	; set the initial sprite order
                            	   101: 
                            	   102: ;-------------------------------------------------------------------------------
                            	   103: ; load & start the background music
                            	   104: ;-------------------------------------------------------------------------------
00:00001CF6 205E            	   105: 	movea.l	(a6)+,a0	; address of the BGM
00:00001CF8 B1FC00000000    	   106: 	cmp.l	#$00000000,a0	; test if there is background music to play
00:00001CFE 6608            	   107: 	bne.s	LoadScenePlayBGM	; there is music to play
00:00001D00 4EB900009C4E    	   108: 	jsr Echo_StopBGM	; otherwise stop the background music
00:00001D06 6014            	   109: 	bra.s	ExitLoadScene	; move on
                            	   110: LoadScenePlayBGM:
00:00001D08 B1F9FFFF019E    	   111: 	cmp.l	(MEM_SCENE_BGM),a0 ; test if scene BGM is already playing
00:00001D0E 670C            	   112: 	beq.s	ExitLoadScene	; same BGM, branch
                            	   113: LoadScenePlayBGMNewBGM:
00:00001D10 23C8FFFF019E    	   114: 	move.l	a0,(MEM_SCENE_BGM)	; save reference to new BGM
00:00001D16 4EB900009C40    	   115: 	jsr Echo_PlayBGM	; start the background music
                            	   116: 
                            	   117: ExitLoadScene:
00:00001D1C 46FC2000        	   118: 	move.w	#$2000,sr		; re-enable interrupts
00:00001D20 4E75            	   119: 	rts
                            	   120: 
                            	   121: LoadSceneLoadNPCSprites:
                            	   122: 	; lookup which NPCs sprites are in this scene and add them
00:00001D22 33FC0000FFFF0148	   123: 	move.w	#$0000,(MEM_ACTIVE_NPC_COUNT)	; reset active scene NPC count 
00:00001D2A 43F9FFFF0038    	   124: 	lea	MEM_NPC_LOCATIONS,a1	; point a1 to the start of the list
00:00001D30 4245            	   125: 	clr	d5	; out of paranoia
00:00001D32 3A39FFFF013E    	   126: 	move.w	(MEM_ACTIVE_SCENE_ID),d5	; copy active scene ID to d5
00:00001D38 0C450017        	   127: 	cmpi.w	#MAX_STORE_ID,d5	; test is this is a store
00:00001D3C 6E000032        	   128: 	bgt.w	ExitLoadSceneLoadNPCSprites	; branch if not
00:00001D40 CAFC0004        	   129: 	mulu.w	#NPC_LIST_LENGTH,d5	; multiply by list length
00:00001D44 D2C5            	   130: 	adda.w	d5,a1	; add result to a1 to move to npc list for active scene
                            	   131: 	;---------------------------------------------------------------------------
                            	   132: 	; setup loop control - 2 NPCs per word in MEM_NPC_LOCATIONS
                            	   133: 	;---------------------------------------------------------------------------
00:00001D46 363C0001        	   134: 	move.w	#NPC_LIST_LOOP_CTRL,d3	; use d3 for loop control
                            	   135: 	;---------------------------------------------------------------------------
                            	   136: 	; loop through all NPCs in the scene and add their sprites
                            	   137: 	;---------------------------------------------------------------------------
00:00001D4A 7402            	   138: 	moveq	#$0002,d2	; use d2 to track sprite ID
                            	   139: LoadSceneLoadNPCSpritesLoop:
00:00001D4C 3819            	   140: 	move.w	(a1)+,d4	; copy next NPC pair to d4
00:00001D4E 3A04            	   141: 	move.w	d4,d5	; use d5 for first byte
00:00001D50 CA7CFF00        	   142: 	and.w	#$FF00,d5	; clear low byte	
00:00001D54 6708            	   143: 	beq.s	.1	; branch if the result of the and is zero
00:00001D56 E04D            	   144: 	lsr.w	#$8,d5	; shift upper word to lower
00:00001D58 4EB900001D72    	   145: 	jsr	LoadNPC	; load this NPC sprite
                            	   146: .1	; second NPC in the pair
00:00001D5E 3A04            	   147: 	move.w	d4,d5	; copy NPC pair to d5 again
00:00001D60 CA7C00FF        	   148: 	and.w	#$00FF,d5	; clear high byte
00:00001D64 6706            	   149: 	beq.s	.2	; branch if the result of the and is zero
00:00001D66 4EB900001D72    	   150: 	jsr	LoadNPC	; load this NPC sprite
                            	   151: .2
00:00001D6C 51CBFFDE        	   152: 	dbra d3,LoadSceneLoadNPCSpritesLoop	; loop
                            	   153: ExitLoadSceneLoadNPCSprites:
00:00001D70 4E75            	   154: 	rts
                            	   155: 
                            	   156: LoadNPC:
00:00001D72 45F90001B18A    	   157: 	lea	CharacterDefinitionStart,a2	; point a2 to the character definition
                            	   158: 	; d5 contains NPC ID
00:00001D78 CAFC0004        	   159: 	mulu.w	#CHARACTER_DEFINITION_SIZE,d5	; multiply to get NPC def location
00:00001D7C D4C5            	   160: 	adda.w	d5,a2	; increment a2 to the NPC definition
00:00001D7E 47F9FFFF00D6    	   161: 	lea	MEM_NPC0_SPRITE_ID,a3	; point a3 to the first NPC memory location
00:00001D84 3A02            	   162: 	move.w	d2,d5	; d2 has sprite ID, copy it to d5
00:00001D86 5545            	   163: 	subq	#$2,d5	; decrement to account for player sprite
00:00001D88 CAFC001A        	   164: 	mulu.w	#NPC_RECORD_SIZE,d5	; multiply to get location
00:00001D8C D6C5            	   165: 	adda.w	d5,a3	; increment a3 to the NPC memory location
00:00001D8E 205A            	   166: 	movea.l	(a2)+,a0	; set address of first tile to load
                            	   167: 	; calculate VDP write address
00:00001D90 3202            	   168: 	move.w	d2,d1	; copy sprite ID to d1
00:00001D92 5341            	   169: 	subq.w	#$1,d1	; subtract 1 to account for zero indexing
00:00001D94 C2FC0C00        	   170: 	mulu.w	#(SPRITE_TILESET_LWORDS*LWORD_SIZE),d1	; multiply to get location
00:00001D98 D27C2220        	   171: 	add.w	#PLAYER_SPRITE_VDP,d1
00:00001D9C 61000DA6        	   172: 	bsr.w	BuildVRAMWriteAddress	; build VRAM write address
                            	   173: 	;swap	d1	; move to upper word
                            	   174: 	;add.l	#PLAYER_SPRITE_VDP,d1 ; add base address
                            	   175: 	; load the tiles
00:00001DA0 303C0300        	   176: 	move.w	#SPRITE_TILESET_LWORDS,d0	; number of tiles in a sprite tileset
                            	   177: 	; note - a0, d0, and d1 are modified by this call
00:00001DA4 6100EC02        	   178: 	bsr.w	LoadTiles	; branch to LoadTiles subroutine
                            	   179: 	; --------------------------------------------------------------------------
                            	   180: 	; update x, y, and pattern in the sprite table
                            	   181: 	; this could be optimized a bit to use fewer calculations
                            	   182: 	; --------------------------------------------------------------------------
                            	   183: 	; y
00:00001DA8 2C02            	   184: 	move.l	d2,d6	; copy sprite ID to d1
00:00001DAA CCFC0008        	   185: 	mulu.w	#$08,d6	; multiply sprite ID by 8 to get sprite array offset
00:00001DAE 4846            	   186: 	swap	d6	; move to upper word
00:00001DB0 DCBC78000002    	   187: 	add.l	#VDP_VRAM_WRITE_SPRITE,d6	; add to sprite table address
00:00001DB6 23C600C00004    	   188: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00001DBC 33EB000400C00000	   189: 	move.w	(STRUCT_SPRITE_Y,a3),(VDP_DATA)			; copy the new y-coordinate
                            	   190: 	; x
00:00001DC4 3C02            	   191: 	move.w	d2,d6	; store sprite ID in d6
00:00001DC6 CCFC0008        	   192: 	mulu.w	#$08,d6	; multiply sprite ID by 8 to get sprite array offset
00:00001DCA 5C46            	   193:    	addq	#STRUCT_SPRITEDEF_X,d6		; move to x-coordinate
00:00001DCC 4846            	   194: 	swap	d6	; move to upper word
00:00001DCE DCBC78000002    	   195: 	add.l	#VDP_VRAM_WRITE_SPRITE,d6	; add to sprite table address
00:00001DD4 23C600C00004    	   196: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00001DDA 33EB000200C00000	   197: 	move.w	(STRUCT_SPRITE_X,a3),(VDP_DATA)			; copy the new y-coordinate
                            	   198: 	; size & link
00:00001DE2 3C02            	   199: 	move.w	d2,d6	; store sprite ID in d6
00:00001DE4 CCFC0008        	   200: 	mulu.w	#$08,d6	; multiply sprite ID by 8 to get sprite array offset
00:00001DE8 5446            	   201: 	addq	#STRUCT_SPRITEDEF_SIZE_LINK,d6		; move to x-coordinate
00:00001DEA 4846            	   202: 	swap	d6	; move to upper word
00:00001DEC DCBC78000002    	   203: 	add.l	#VDP_VRAM_WRITE_SPRITE,d6	; add to sprite table address
00:00001DF2 23C600C00004    	   204: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00001DF8 33FC070000C00000	   205: 	move.w	#SPRITE_DEF_WORD2_BASE,(VDP_DATA)	; set default size
                            	   206: 	; pattern
00:00001E00 3C02            	   207: 	move.w	d2,d6	; store sprite ID in d6
00:00001E02 CCFC0008        	   208: 	mulu.w	#$08,d6	; multiply sprite ID by 8 to get sprite array offset
00:00001E06 5846            	   209:    	addq	#STRUCT_SPRITEDEF_PATTERN,d6		; move to pattern
00:00001E08 4846            	   210: 	swap	d6	; move to upper word
00:00001E0A DCBC78000002    	   211: 	add.l	#VDP_VRAM_WRITE_SPRITE,d6	; add to sprite table address
00:00001E10 23C600C00004    	   212: 	move.l	d6,(VDP_CONTROL)	; set write location in VDP
00:00001E16 33EB000600C00000	   213: 	move.w	(STRUCT_SPRITE_BASE_PATTERN,a3),(VDP_DATA)	; copy the new pattern
00:00001E1E 284E            	   214: 	move.l	a6,a4	; workaround caused by my lack of planning
00:00001E20 2C4B            	   215: 	move.l	a3,a6	; setup call to UpdateSpritePattern
00:00001E22 6100F5AC        	   216: 	bsr.w	UpdateSpritePattern ; branch to move SetSpritePattern
                            	   217: 	if	_SPRITE_COLLISION_
                            	   218: 	; block the sprite's initial map positon
                            	   219: 	move.l	a3,a6	; setup call to FlipSpriteMapPosition
                            	   220: 	; note - a3, d5, d6, and d7 are modified by this call
                            	   221: 	bsr.w	FlipSpriteMapPosition	; block the sprite's initial position
                            	   222: 	endif
00:00001E26 2C4C            	   223: 	move.l	a4,a6	; workaround caused by my lack of planning
                            	   224: ExitLoadNPC:
00:00001E28 5242            	   225: 	addq	#$1,d2	; increment sprite ID
00:00001E2A 5279FFFF0148    	   226: 	addq	#$1,(MEM_ACTIVE_NPC_COUNT)	; increment active scene NPC count
00:00001E30 4E75            	   227: 	rts
                            	   228: 

Source: "inc_Subroutines.X68"
                            	    51: 
                            	    52: 	include 'sub_DrawScene.X68'

Source: "sub_DrawScene.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; DrawScene
                            	     3: ; loads tiles and palettes then draws the scene 
                            	     4: ; Parameters
                            	     5: ; a6 = starting address of scene to load
                            	     6: ; other registers used
                            	     7: ; a0 & a1 are used to call other subroutines
                            	     8: ; assume that d0-d7 are used either by this subroutine or others it calls
                            	     9: ;-------------------------------------------------------------------------------
                            	    10: DrawScene:
                            	    11: ;-------------------------------------------------------------------------------
                            	    12: ; fade out current palette
                            	    13: ;-------------------------------------------------------------------------------
00:00001E32 61000EBE        	    14: 	bsr.w	FadeOut
                            	    15: 
                            	    16: ;-------------------------------------------------------------------------------
                            	    17: ; clear VDP
                            	    18: ;-------------------------------------------------------------------------------
00:00001E36 6100EAB4        	    19: 	bsr.w	WaitVBlank	; wait for vblank to end
                            	    20: 
00:00001E3A 46FC2700        	    21: 	move.w	#$2700,sr		; disable interrupts
                            	    22: 
                            	    23: ;	bsr.w	WaitVBlankEnd	; if currently in VBlank, wait
                            	    24: ;	bsr.w	WaitVBlankStart	; wait to clear screen until VBlank starts
00:00001E3E 6100EBAA        	    25: 	bsr.w	ClearVRAM	; clear VRAM
                            	    26: 
                            	    27: ;-------------------------------------------------------------------------------
                            	    28: ; load tiles
                            	    29: ;-------------------------------------------------------------------------------
00:00001E42 3E1E            	    30: 	move.w	(a6)+,d7	; number of tilesets to load
00:00001E44 0C47FFFF        	    31: 	cmpi.w	#$FFFF,d7	; is there any tiles to load?
00:00001E48 6726            	    32: 	beq.s	LoadFontTiles	; if no tiles then move to next section
00:00001E4A 323C0000        	    33: 	move.w	#SCENE_VDP,d1	; use d1 to track write location
00:00001E4E 4282            	    34: 	clr.l	d2	; use d2 to increment write location
                            	    35: 
                            	    36: LoadSceneLoadTilesLoop:
                            	    37: ;	bsr.w	WaitVBlank	; wait for vblank to end
                            	    38: ;	bsr.w	WaitVBlankEnd	; if currently in VBlank, wait
                            	    39: ;	bsr.w	WaitVBlankStart	; wait to clear screen until VBlank starts
00:00001E50 61000CF2        	    40: 	bsr.w	BuildVRAMWriteAddress
00:00001E54 261E            	    41: 	move.l	(a6)+,d3	; start address of tileset
00:00001E56 201E            	    42: 	move.l	(a6)+,d0	; end address of tileset
00:00001E58 9083            	    43: 	sub.l	d3,d0	; subtract the start address to get length
00:00001E5A D480            	    44: 	add.l	d0,d2	; copy original value to increment write location later
00:00001E5C 80FC0004        	    45: 	divu.w	#$0004,d0	; divide by 4 to setup call to LoadTiles
00:00001E60 2043            	    46: 	movea.l	d3,a0	; set address of first tile to load
00:00001E62 6100EB44        	    47: 	bsr.w	LoadTiles	; branch to LoadTiles subroutine
                            	    48: 	; increment write location for next tileset
00:00001E66 323C0000        	    49: 	move.w	#SCENE_VDP,d1	; d1 was modified by BuildVRAMWriteAddress
00:00001E6A D242            	    50: 	add.w	d2,d1	; add to d1 to increment write location
00:00001E6C 51CFFFE2        	    51: 	dbra d7,LoadSceneLoadTilesLoop	; loop until all data is loaded
                            	    52: 
                            	    53: ;-------------------------------------------------------------------------------
                            	    54: ; load the font tiles
                            	    55: ;-------------------------------------------------------------------------------
                            	    56: LoadFontTiles:
                            	    57: ;	bsr.w	WaitVBlank	; wait for vblank to end
                            	    58: ;	bsr.w	WaitVBlankEnd	; if currently in VBlank, wait
                            	    59: ;	bsr.w	WaitVBlankStart	; wait to clear screen until VBlank starts
00:00001E70 323C1200        	    60: 	move.w	#FONT_VDP,d1	; setup call to BuildVRAMWriteAddress
00:00001E74 61000CCE        	    61: 	bsr.w	BuildVRAMWriteAddress	; build the VRAM write address
00:00001E78 243C00143EBC    	    62: 	move.l	#FontTilesStart,d2	; start address of tileset
00:00001E7E 203C00144C1C    	    63: 	move.l	#FontTilesEnd,d0	; end address of tileset
00:00001E84 9082            	    64: 	sub.l	d2,d0	; subtract the start address to get length
00:00001E86 80FC0004        	    65: 	divu.w	#$0004,d0	; divide by 4 to setup call to LoadTiles
00:00001E8A 2042            	    66: 	movea.l	d2,a0	; set address of first tile to load
00:00001E8C 6100EB1A        	    67: 	bsr.w	LoadTiles	; branch to LoadTiles subroutine
                            	    68: 
                            	    69: ;-------------------------------------------------------------------------------
                            	    70: ; load palettes
                            	    71: ;-------------------------------------------------------------------------------
00:00001E90 301E            	    72: 	move.w	(a6)+,d0	; number of palettes to load
00:00001E92 205E            	    73: 	movea.l	(a6)+,a0	; start address of palettes
00:00001E94 43F9FFFF01A2    	    74: 	lea	MEM_SCENE_PALETTE,a1	; point a1 to scene palette address
00:00001E9A C0FC0010        	    75: 	mulu.w	#$10,d0	; multiply number of palettes by 16
00:00001E9E 5340            	    76: 	subq.w	#$01,d0	; subtract 1 since the loop counts to 0
                            	    77: StorePalettesLoop:
00:00001EA0 32D8            	    78: 	move.w	(a0)+,(a1)+	; write the palette data
00:00001EA2 51C8FFFC        	    79: 	dbf	d0,StorePalettesLoop		; decrement value of d0 and loop if not 0
                            	    80: 
                            	    81: ;-------------------------------------------------------------------------------
                            	    82: ; draw the scenery
                            	    83: ;-------------------------------------------------------------------------------
                            	    84: ;	bsr.w	WaitVBlank	; wait for vblank to end
                            	    85: ;	bsr.w	WaitVBlankEnd	; if currently in VBlank, wait
                            	    86: ;	bsr.w	WaitVBlankStart	; wait to clear screen until VBlank starts
00:00001EA6 3E1E            	    87: 	move.w	(a6)+,d7	; number of scenery items to draw
00:00001EA8 0C47FFFF        	    88: 	cmpi.w	#$FFFF,d7	; is there any sceney to draw?
00:00001EAC 6710            	    89: 	beq.s	LoadSceneDrawText	; if no scenery then move to next section
                            	    90: LoadSceneDrawSceneryLoop:
00:00001EAE 205E            	    91: 	movea.l	(a6)+,a0	; start address of pattern
00:00001EB0 301E            	    92: 	move.w	(a6)+,d0	; base pattern
00:00001EB2 321E            	    93: 	move.w	(a6)+,d1	; repeat
00:00001EB4 225E            	    94: 	movea.l	(a6)+,a1	; initial drawing location
00:00001EB6 6100EB04        	    95: 	bsr.w	DrawTileset		; branch to DrawTileset subroutine
00:00001EBA 51CFFFF2        	    96: 	dbra d7,LoadSceneDrawSceneryLoop	; loop until all data is loaded
                            	    97: 
                            	    98: ;-------------------------------------------------------------------------------
                            	    99: ; draw the text
                            	   100: ;-------------------------------------------------------------------------------
                            	   101: LoadSceneDrawText:	
00:00001EBE 3E1E            	   102: 	move.w	(a6)+,d7	; number of scenery items to draw
00:00001EC0 0C47FFFF        	   103: 	cmpi.w	#$FFFF,d7	; are there any items to draw?
00:00001EC4 6734            	   104: 	beq.s	ExitDrawScene	; if no items then move to next section
                            	   105: LoadSceneDrawTextLoop:
00:00001EC6 205E            	   106: 	movea.l	(a6)+,a0	; start address of text
00:00001EC8 301E            	   107: 	move.w	(a6)+,d0	; base pattern
00:00001ECA 225E            	   108: 	movea.l	(a6)+,a1	; initial drawing location
                            	   109: 	; read & draw the string character by character until ETX is reached
                            	   110: LoadSceneDrawTextNextCharacter:
00:00001ECC 4246            	   111: 	clr	d6	; clear out d6
00:00001ECE 1C10            	   112: 	move.b	(a0),d6	; copy current character to d6
00:00001ED0 0C060003        	   113: 	cmpi.b	#ETX,d6	; is this the end of the text?
00:00001ED4 6720            	   114: 	beq.s	LoadSceneDrawTextLoopEnd	; end of this string, move to next one
00:00001ED6 9C7C0020        	   115: 	sub.w	#$20,d6	; subtract 32 to get the character index
                            	   116: 	; draw the character
00:00001EDA DC40            	   117: 	add.w	d0,d6	; add the base tile
00:00001EDC 23C900C00004    	   118: 	move.l	a1,(VDP_CONTROL)	; set VDP address
00:00001EE2 33C600C00000    	   119: 	move.w  d6,(VDP_DATA)	; copy the character to VPD
                            	   120: 	; increment for next character
00:00001EE8 D1FC00000001    	   121: 	adda.l	#$00000001,a0	; move to next character in the string
00:00001EEE D3FC00020000    	   122: 	add.l	#$00020000,a1	; move to the next column
00:00001EF4 60D6            	   123: 	bra.s	LoadSceneDrawTextNextCharacter	; repeat until ETX is reached
                            	   124: LoadSceneDrawTextLoopEnd:
00:00001EF6 51CFFFCE        	   125: 	dbra d7,LoadSceneDrawTextLoop	; loop until all data is loaded
                            	   126: 
                            	   127: ExitDrawScene:
00:00001EFA 46FC2000        	   128: 	move.w	#$2000,sr		; re-enable interrupts
00:00001EFE 4E75            	   129: 	rts
                            	   130: 
                            	   131: 

Source: "inc_Subroutines.X68"
                            	    53: 
                            	    54: 	include 'sub_ReloadCurrentScene.X68'

Source: "sub_ReloadCurrentScene.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; Reloads the current scene while preserving sprite x,y
                            	     3: ; This is needed in two cases:
                            	     4: ; 1) Loading a save game where the sprites are not in default x,y
                            	     5: ; 2) Returning from status screen when sprites have left the scene
                            	     6: ;    (addressing a bug that happens during some scripted event transition)
                            	     7: ;*******************************************************************************
                            	     8: ReloadCurrentScene:
00:00001F00 46FC2700        	     9: 	move.w	#$2700,sr		; disable interrupts
                            	    10: 	;---------------------------------------------------------------------------
                            	    11: 	; reloading the scene sets all the sprite positions back to default
                            	    12: 	;---------------------------------------------------------------------------
00:00001F04 4DF9FFFF0248    	    13: 	lea	MEM_TEMP_SPACE,a6	; point a6 to a temporary space
00:00001F0A 3CF9FFFF00D8    	    14: 	move.w	(MEM_NPC0_SPRITE_X),(a6)+
00:00001F10 3CF9FFFF00DA    	    15: 	move.w	(MEM_NPC0_SPRITE_Y),(a6)+
00:00001F16 3CF9FFFF00DE    	    16: 	move.w	(MEM_NPC0_SPRITE_DIRECTION),(a6)+
00:00001F1C 3CF9FFFF00EE    	    17: 	move.w	(MEM_NPC0_MOVE_INDEX),(a6)+
00:00001F22 3CF9FFFF00E0    	    18: 	move.w	(MEM_NPC0_SPRITE_FRAME),(a6)+
00:00001F28 3CF9FFFF00E2    	    19: 	move.w	(MEM_NPC0_SPRITE_STEP_COUNTER),(a6)+
00:00001F2E 3CF9FFFF00E4    	    20: 	move.w	(MEM_NPC0_MOVEMENT_COUNTER),(a6)+
00:00001F34 3CF9FFFF00EE    	    21: 	move.w	(MEM_NPC0_MOVE_INDEX),(a6)+
00:00001F3A 3CF9FFFF00F2    	    22: 	move.w	(MEM_NPC1_SPRITE_X),(a6)+
00:00001F40 3CF9FFFF00F4    	    23: 	move.w	(MEM_NPC1_SPRITE_Y),(a6)+
00:00001F46 3CF9FFFF00F8    	    24: 	move.w	(MEM_NPC1_SPRITE_DIRECTION),(a6)+
00:00001F4C 3CF9FFFF0108    	    25: 	move.w	(MEM_NPC1_MOVE_INDEX),(a6)+
00:00001F52 3CF9FFFF00FA    	    26: 	move.w	(MEM_NPC1_SPRITE_FRAME),(a6)+
00:00001F58 3CF9FFFF00FC    	    27: 	move.w	(MEM_NPC1_SPRITE_STEP_COUNTER),(a6)+
00:00001F5E 3CF9FFFF00FE    	    28: 	move.w	(MEM_NPC1_MOVEMENT_COUNTER),(a6)+
00:00001F64 3CF9FFFF0108    	    29: 	move.w	(MEM_NPC1_MOVE_INDEX),(a6)+
00:00001F6A 3CF9FFFF010C    	    30: 	move.w	(MEM_NPC2_SPRITE_X),(a6)+
00:00001F70 3CF9FFFF010E    	    31: 	move.w	(MEM_NPC2_SPRITE_Y),(a6)+
00:00001F76 3CF9FFFF0112    	    32: 	move.w	(MEM_NPC2_SPRITE_DIRECTION),(a6)+
00:00001F7C 3CF9FFFF0122    	    33: 	move.w	(MEM_NPC2_MOVE_INDEX),(a6)+
