00:0000005C 00000940        	    29: 	dc.l	TrapException	; Reserved
00:00000060 00000940        	    30: 	dc.l	TrapException	; Spurious exception
00:00000064 00000940        	    31: 	dc.l	TrapException	; Interrupt request level 1 (lowest priority)
00:00000068 00000900        	    32: 	dc.l	ExtInt			; Interrupt request level 2 (external interrupt)
00:0000006C 00000940        	    33: 	dc.l	TrapException	; Interrupt request level 3
00:00000070 00000902        	    34: 	dc.l	HBlank			; Interrupt request level 4 (VDP interrupt/HBlank)
00:00000074 00000940        	    35: 	dc.l	TrapException	; Interrupt request level 5
00:00000078 00000904        	    36: 	dc.l	VBlank			; Interrupt request level 6 (VDP interrupt/VBlank)
00:0000007C 00000940        	    37: 	dc.l	TrapException	; Interrupt request level 7 (highest priority)
00:00000080 00000940        	    38: 	dc.l	TrapException	; TRAP #00 exception
