00:000005F6 6C06            	   190: 	bge.s	.1	; not at the end of the array
00:000005F8 3B7C00000018    	   191: 	move.w	#$0000,(STRUCT_SPRITE_MOVE_INDEX,a5)	; reset to zero
                            	   192: .1
00:000005FE 2C6D0012        	   193: 	move.l	(STRUCT_SPRITE_MOVE_PATTERN,a5),a6
00:00000602 DCED0018        	   194: 	adda	(STRUCT_SPRITE_MOVE_INDEX,a5),a6
00:00000606 3B560008        	   195: 	move.w	(a6),(STRUCT_SPRITE_DIRECTION,a5)
