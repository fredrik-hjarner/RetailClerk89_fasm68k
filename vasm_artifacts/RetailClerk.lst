                            	    74: 	include	'sub_MainGameLoop.X68'

Source: "sub_MainGameLoop.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; main game loop
                            	     3: ;*******************************************************************************
                            	     4: MainGameLoop:
00:000003CE 6100051C        	     5: 	bsr.w	WaitVBlank ; wait for vblank to complete
00:000003D2 5279FFFF001C    	     6: 	addq	#$1,(MEM_MAINLOOP_COUNTER) ; increment counter
00:000003D8 2E39FFFF0028    	     7: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
                            	     8: 	if _DEBUG_
                            	     9: 	btst.l	#STATE_FLAG_DEBUG_MENU,d7 ; test game state
                            	    10: 	bne.w	ProcessDebugScreen
                            	    11: 	endif
                            	    12: 	; test if load screen is showing
00:000003DE 0807000C        	    13: 	btst.l	#STATE_FLAG_LOAD_MENU,d7 ; test game state
00:000003E2 6600075E        	    14: 	bne.w	ProcessLoadScreen
                            	    15: 	; test if exploring	
00:000003E6 08070002        	    16: 	btst.l	#STATE_FLAG_EXPLORING,d7 ; test game state
00:000003EA 67000254        	    17: 	beq.w	TestTitleScreen	; not exploring, branch
                            	    18: ;-------------------------------------------------------------------------------
                            	    19: ; pause/unpause
                            	    20: ;-------------------------------------------------------------------------------
                            	    21: TestPauseToggle:
00:000003EE 2E39FFFF0028    	    22: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:000003F4 1C39FFFF0024    	    23: 	move.b	(MEM_CONTROL_PRESSED),d6	; copy pressed buttons to d6
00:000003FA 02060080        	    24: 	andi.b	#BUTTON_START_PRESSED,d6	; test if the start button was pressed
00:000003FE 6770            	    25: 	beq.s	TestPause	; start button is not pressed test if still paused
                            	    26: 	; clear MEM_CONTROL_PRESSED to prevent pause state from flipping in loop
00:00000400 33FC0000FFFF0024	    27: 	move.w	#$0000,(MEM_CONTROL_PRESSED)
00:00000408 08070001        	    28: 	btst.l	#STATE_FLAG_PAUSED,d7	; is the paused bit set?
