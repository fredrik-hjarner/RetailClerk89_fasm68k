Source: "sub_ProcessScriptedEvent.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; process scripted events from the main loop
                            	     3: ;-------------------------------------------------------------------------------
                            	     4: ProcessScriptedEvent:
                            	     5: 	;---------------------------------------------------------------------------
                            	     6: 	; dialog is not displaying, test if it is time to start a new action
                            	     7: 	;---------------------------------------------------------------------------
00:0000116C 0C790000FFFF0242	     8: 	cmpi.w	#$0000,(MEM_SCRIPTED_EVENT_STEPS)	; test if 0
00:00001174 6700002A        	     9: 	beq.w	NextScriptedEventAction	; if 0 then start next action
                            	    10: 	;---------------------------------------------------------------------------
                            	    11: 	; continue moving the sprite
                            	    12: 	;---------------------------------------------------------------------------
00:00001178 0C790001FFFF001E	    13: 	cmpi.w	#SPRITE_MOVE_FREQUENCY,(MEM_FRAME_COUNTER); is it time to move?
00:00001180 6D000236        	    14: 	blt.w	ExitProcessScriptedEvent	; exit if it's not time to move
00:00001184 33FC0000FFFF001E	    15: 	move.w	#$0000,(MEM_FRAME_COUNTER)	; reset counter to 0
                            	    16: ScriptedEventMoveSprite:
00:0000118C 5379FFFF0242    	    17: 	subq	#$1,(MEM_SCRIPTED_EVENT_STEPS)	; decrement step counter
00:00001192 2C79FFFF0244    	    18: 	move.l	(MEM_SCRIPTED_SPRITE_ADDR),a6	; point a6 to sprite to move
00:00001198 610004F8        	    19: 	bsr.w	MoveSprite	; branch to MoveSprite
00:0000119C 6000021A        	    20: 	bra.w	ExitProcessScriptedEvent	; exit
                            	    21: NextScriptedEventAction:
00:000011A0 2C79FFFF0244    	    22: 	move.l	(MEM_SCRIPTED_SPRITE_ADDR),a6	; point a6 to sprite
00:000011A6 610007DC        	    23: 	bsr.w	StopSprite	; stop moving the sprite
00:000011AA 2C79FFFF023C    	    24: 	move.l	(MEM_SCRIPTED_EVENT_ADDR),a6	; point a6 to next step
00:000011B0 3E39FFFF0240    	    25: 	move.w	(MEM_SCRIPTED_EVENT_ACTION),d7	; copy action to d7
00:000011B6 0C47FFFF        	    26: 	cmpi.w	#SCRIPTED_EVENT_END,d7	; are we at the end?
00:000011BA 677E            	    27: 	beq.s	ScriptedEventEnd	; if so branch
00:000011BC 0C47EEEE        	    28: 	cmpi.w	#SCRIPTED_EVENT_DIALOG,d7	; display a dialog?
00:000011C0 6700008C        	    29: 	beq.w	ScriptedEventDialog	; if so branch
00:000011C4 0C47DDDD        	    30: 	cmpi.w	#SCRIPTED_EVENT_CHANGE_SPRITE,d7	; changing the sprite?
00:000011C8 670000CA        	    31: 	beq.w	ScriptedEventChangeSprite	; if so branch
00:000011CC 0C47CCCC        	    32: 	cmpi.w	#SCRIPTED_EVENT_CHANGE_SCENE,d7	; change scene?
00:000011D0 670000D0        	    33: 	beq.w	ScriptedEventChangeScene	; if so branch
00:000011D4 0C476666        	    34: 	cmpi.w	#SCRIPTED_EVENT_DRAW_SCENE,d7	; draw scene?
00:000011D8 670000F6        	    35: 	beq.w	ScriptedEventDrawScene	; if so branch
00:000011DC 0C47BBBB        	    36: 	cmpi.w	#SCRIPTED_EVENT_CHANGE_PLAYER_SPRITE,d7	; change player sprite?
00:000011E0 67000128        	    37: 	beq.w	ScriptedEventChangePlayerSprite	; if so branch
00:000011E4 0C47AAAA        	    38: 	cmpi.w	#SCRIPTED_EVENT_SET_PLAYER_SPRITE_X,d7	; change player X?
00:000011E8 67000136        	    39: 	beq.w	ScriptedEventSetPlayerSpriteX	; if so branch
00:000011EC 0C479999        	    40: 	cmpi.w	#SCRIPTED_EVENT_SET_PLAYER_SPRITE_Y,d7	; change player Y?
00:000011F0 67000144        	    41: 	beq.w	ScriptedEventSetPlayerSpriteY	; if so branch
00:000011F4 0C478888        	    42: 	cmpi.w	#SCRIPTED_EVENT_SET_PLAYER_SPRITE_DIRECTION,d7	; change direction?
00:000011F8 67000152        	    43: 	beq.w	ScriptedEventSetPlayerSpriteDirection	; if so branch
00:000011FC 0C477777        	    44: 	cmpi.w	#SCRIPTED_EVENT_FADE_BLACK,d7	; fade out?
00:00001200 67000160        	    45: 	beq.w	ScriptedEventFadeBlack	; if so branch
00:00001204 0C475555        	    46: 	cmpi.w	#SCRIPTED_EVENT_TIMER,d7	; timer?
00:00001208 6700017E        	    47: 	beq.w	ScriptedEventTimer	; if so branch
00:0000120C 0C474444        	    48: 	cmpi.w	#SCRIPTED_EVENT_ENDGAME,d7	; end game?
00:00001210 67000192        	    49: 	beq.w	ScriptedEventEndGame	; if so branch
                            	    50: 	;---------------------------------------------------------------------------
                            	    51: 	; start moving the sprite
                            	    52: 	;---------------------------------------------------------------------------
00:00001214 2A79FFFF0244    	    53: 	move.l	(MEM_SCRIPTED_SPRITE_ADDR),a5	; point a5 to sprite to update
                            	    54: 	; copy direction to sprite direction 
00:0000121A DAFC0008        	    55: 	adda.w	#STRUCT_SPRITE_DIRECTION,a5	; move to direction
00:0000121E 3AB9FFFF0240    	    56: 	move.w	(MEM_SCRIPTED_EVENT_ACTION),(a5)	; copy action to direction
00:00001224 33DEFFFF0242    	    57: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_STEPS)	; copy steps in action
                            	    58: 	; save state of scripted event and loop back to main
00:0000122A 33DEFFFF0240    	    59: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:00001230 23CEFFFF023C    	    60: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:00001236 60000180        	    61: 	bra.w	ExitProcessScriptedEvent	; exit
                            	    62: ScriptedEventEnd:
00:0000123A 2E39FFFF0028    	    63: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:00001240 08870005        	    64: 	bclr.l	#STATE_FLAG_SCRIPTED_EVENT,d7	; clear the scripted event flag
00:00001244 23C7FFFF0028    	    65: 	move.l	d7,(MEM_GAME_STATE)	; save it back
00:0000124A 6000016C        	    66: 	bra.w	ExitProcessScriptedEvent	; exit
                            	    67: ScriptedEventDialog:
00:0000124E 23DEFFFF022E    	    68: 	move.l	(a6)+,(MEM_DIALOG_TEXT)	; copy value at a6 to MEM_DIALOG_TEXT
00:00001254 33DEFFFF0240    	    69: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:0000125A 23CEFFFF023C    	    70: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:00001260 33FC0000FFFF0242	    71: 	move.w	#$0000,(MEM_SCRIPTED_EVENT_STEPS)	; reset step counter
                            	    72: 	; set dialog flags to display the dialog
00:00001268 2E39FFFF0226    	    73: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy current dialog state to d7
00:0000126E 08C7001A        	    74: 	bset.l	#DIALOG_FLAG_TEXT_OPENING,d7	; change state to opening
00:00001272 08C70018        	    75: 	bset.l	#DIALOG_FLAG_STYLE_SIMPLE_TEXT,d7	; set style to overworld menu
00:00001276 08C70013        	    76: 	bset.l	#DIALOG_FLAG_STYLE_TITLED,d7	; set style to titled
00:0000127A 23C7FFFF0226    	    77: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save changes made to the game state
00:00001280 2E39FFFF0028    	    78: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:00001286 08C70003        	    79: 	bset.l	#STATE_FLAG_DIALOG,d7	; set the dialog bit
00:0000128A 23C7FFFF0028    	    80: 	move.l	d7,(MEM_GAME_STATE) ; copy game state back to d7
00:00001290 60000126        	    81: 	bra.w	ExitProcessScriptedEvent	; exit
                            	    82: ScriptedEventChangeSprite:
00:00001294 2C79FFFF023C    	    83: 	move.l	(MEM_SCRIPTED_EVENT_ADDR),a6	; point a6 to next step
00:0000129A 61001C62        	    84: 	bsr.w	QueueScriptedEvent	; this will reset all variables
00:0000129E 60000118        	    85: 	bra.w	ExitProcessScriptedEvent	; exit
                            	    86: ScriptedEventChangeScene:
00:000012A2 3E1E            	    87: 	move.w	(a6)+,d7	; copy scene ID to load to d7
00:000012A4 33DEFFFF0240    	    88: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:000012AA 23CEFFFF023C    	    89: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:000012B0 CEFC0004        	    90: 	mulu.w	#$4,d7	; multiply by 4 to get offset in scene definition table
00:000012B4 4DF90001C71E    	    91: 	lea	SceneDefinitionTable,a6	; point a6 to the scene definition table
00:000012BA DDC7            	    92: 	adda.l	d7,a6	; add offset
00:000012BC 2C56            	    93: 	move.l	(a6),a6	; have a6 point to the value at a6
00:000012BE 6100098A        	    94: 	bsr.w	LoadScene	; branch to LoadScene subroutine
00:000012C2 61000796        	    95: 	bsr.w	LoadPlayerSprite	; load the player sprite
00:000012C6 610004C0        	    96: 	bsr.w	FixSprites	; move player sprite and reset sprite links
00:000012CA 3E3C0009        	    97: 	move.w	#EVENT_FRAME_DELAY,d7	; copy delay to d7
00:000012CE 602A            	    98: 	bra.s	ScriptedEventFadeInDelayLoop
                            	    99: ScriptedEventDrawScene:
00:000012D0 3E1E            	   100: 	move.w	(a6)+,d7	; copy scene ID to load to d7
00:000012D2 33DEFFFF0240    	   101: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:000012D8 23CEFFFF023C    	   102: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:000012DE CEFC0004        	   103: 	mulu.w	#$4,d7	; multiply by 4 to get offset in scene definition table
00:000012E2 4DF90001C71E    	   104: 	lea	SceneDefinitionTable,a6	; point a6 to the scene definition table
00:000012E8 DDC7            	   105: 	adda.l	d7,a6	; add offset
00:000012EA 2C56            	   106: 	move.l	(a6),a6	; have a6 point to the value at a6
00:000012EC 3C1E            	   107: 	move.w	(a6)+,d6	; discard first word
00:000012EE 61000B42        	   108: 	bsr.w	DrawScene	; branch to LoadScene subroutine
00:000012F2 610004F6        	   109: 	bsr.w	ReloadSpriteTiles	; reload sprite tiles
00:000012F6 3E3C0009        	   110: 	move.w	#EVENT_FRAME_DELAY,d7	; copy delay to d7
                            	   111: ScriptedEventFadeInDelayLoop:
00:000012FA 6100F5F0        	   112: 	bsr.w	WaitVBlank
00:000012FE 51CFFFFA        	   113: 	dbf	d7,ScriptedEventFadeInDelayLoop	; loop until counter is zero
00:00001302 610019B2        	   114: 	bsr.w	FadeIn	; fade in to the new scene
00:00001306 600000B0        	   115: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   116: ScriptedEventChangePlayerSprite:
00:0000130A 33DEFFFF009C    	   117: 	move.w	(a6)+,(MEM_PLAYER_SPRITE)	; update sprite
00:00001310 33DEFFFF0240    	   118: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:00001316 23CEFFFF023C    	   119: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:0000131C 6000009A        	   120: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   121: ScriptedEventSetPlayerSpriteX:
00:00001320 33DEFFFF00BE    	   122: 	move.w	(a6)+,(MEM_PLAYER_SPRITE_X)	; update sprite
00:00001326 33DEFFFF0240    	   123: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:0000132C 23CEFFFF023C    	   124: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:00001332 60000084        	   125: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   126: ScriptedEventSetPlayerSpriteY:
00:00001336 33DEFFFF00C0    	   127: 	move.w	(a6)+,(MEM_PLAYER_SPRITE_Y)	; update sprite
00:0000133C 33DEFFFF0240    	   128: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:00001342 23CEFFFF023C    	   129: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:00001348 6000006E        	   130: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   131: ScriptedEventSetPlayerSpriteDirection:
00:0000134C 33DEFFFF00C4    	   132: 	move.w	(a6)+,(MEM_PLAYER_SPRITE_DIRECTION)	; update sprite
00:00001352 33DEFFFF0240    	   133: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:00001358 23CEFFFF023C    	   134: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:0000135E 60000058        	   135: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   136: ScriptedEventFadeBlack:
00:00001362 33DEFFFF0240    	   137: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:00001368 23CEFFFF023C    	   138: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
00:0000136E 61001982        	   139: 	bsr.w	FadeOut	; fade out
                            	   140: 	; blackout the palette
00:00001372 43F9FFFF01A2    	   141: 	lea	MEM_SCENE_PALETTE,a1	; point a1 to scene palette address
00:00001378 3E3C003F        	   142: 	move.w	#$003F,d7	; 64-1 palette entries
                            	   143: ScriptedEventFadeBlackLoop:
00:0000137C 32FC0000        	   144: 	move.w	#$0000,(a1)+	; write the palette data
00:00001380 51CFFFFA        	   145: 	dbf	d7,ScriptedEventFadeBlackLoop	; decrement d7 and loop if not 0
00:00001384 60000032        	   146: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   147: ScriptedEventTimer:
00:00001388 3E1E            	   148: 	move.w	(a6)+,d7	; copy timer to d7
00:0000138A 33DEFFFF0240    	   149: 	move.w	(a6)+,(MEM_SCRIPTED_EVENT_ACTION)	; save next action
00:00001390 23CEFFFF023C    	   150: 	move.l	a6,(MEM_SCRIPTED_EVENT_ADDR)	; save address of next step
                            	   151: ScriptedEventTimerLoop:
00:00001396 4EB9000008EC    	   152: 	jsr	WaitVBlank	; wait for vblank
00:0000139C 51CFFFF8        	   153: 	dbf	d7,ScriptedEventTimerLoop	; loop
00:000013A0 60000016        	   154: 	bra.w	ExitProcessScriptedEvent	; exit
                            	   155: ScriptedEventEndGame:
00:000013A4 2E39FFFF0028    	   156: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:000013AA 08870005        	   157: 	bclr.l	#STATE_FLAG_SCRIPTED_EVENT,d7	; clear the scripted event flag
00:000013AE 23C7FFFF0028    	   158: 	move.l	d7,(MEM_GAME_STATE)	; save it back
00:000013B4 60001BB6        	   159: 	bra.w	EndGame
                            	   160: ExitProcessScriptedEvent:
00:000013B8 4E75            	   161: 	rts
                            	   162: 

Source: "inc_Subroutines.X68"
                            	    23: 
                            	    24: 	include	'sub_SetSpritePattern.X68'

Source: "sub_SetSpritePattern.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; SetSpritePattern
                            	     3: ; sets the pattern for a sprite based on its direction and frame
                            	     4: ; a6 = address of sprite info start
                            	     5: ; d5 is used to store the sprite id and compute the address table value
                            	     6: ; d6 is used to compute the sprite pattern 
                            	     7: ; d7 is used for various operations
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: SetSpritePattern:
                            	    10: 	; test if it's time to update the animation frame and if so update it
00:000013BA 526E000C        	    11: 	addq	#$1,(STRUCT_SPRITE_STEP_COUNTER,a6)	; increment counter
00:000013BE 0C6E0008000C    	    12: 	cmpi.w	#SPRITE_ANIMATION_STEPS,(STRUCT_SPRITE_STEP_COUNTER,a6) ; test
00:000013C4 6F50            	    13: 	ble.s	ExitSetSpritePattern	; animation hasn't changed, draw the sprite 
                            	    14: IncrementSpriteFrame:
00:000013C6 3D7C0000000C    	    15: 	move.w	#$0000,(STRUCT_SPRITE_STEP_COUNTER,a6)	; reset SPRITE_STEP_COUNTER
00:000013CC 526E000A        	    16: 	addq	#$1,(STRUCT_SPRITE_FRAME,a6)	; increment SPRITE_FRAME counter
                            	    17: UpdateSpritePattern:
00:000013D0 3A16            	    18: 	move.w	(a6),d5	; copy sprite id to d5
00:000013D2 CAFC0008        	    19: 	mulu.w	#$08,d5	; multiply sprite ID by 8 to get sprite array offset
                            	    20: 	; change the sprite pattern
00:000013D6 5845            	    21: 	addq	#STRUCT_SPRITEDEF_PATTERN,d5	; move to palette and pattern
00:000013D8 4845            	    22: 	swap	d5		; move to upper word
00:000013DA DABC78000002    	    23: 	add.l	#VDP_VRAM_WRITE_SPRITE,d5	; add to sprite table address
                            	    24: 	; set the pattern, pattern=(base pattern number)+(direction*24)+(frame*8)
00:000013E0 3C2E0006        	    25: 	move.w	(STRUCT_SPRITE_BASE_PATTERN,a6),d6	; start with base pattern in d6
00:000013E4 3E2E0008        	    26: 	move.w	(STRUCT_SPRITE_DIRECTION,a6),d7 ; copy direction to d7
00:000013E8 CEFC0018        	    27: 	mulu.w	#$18,d7	; multiply direction * 24
00:000013EC DC47            	    28: 	add.w	d7,d6 	; add result to d1
00:000013EE 3E2E000A        	    29: 	move.w	(STRUCT_SPRITE_FRAME,a6),d7	; copy frame to d7
                            	    30: 	;---------------------------------------------------------------------------
                            	    31: 	; cycle between the frames	
                            	    32: 	; frame 0 = animation 0
                            	    33: 	; frame 1 = animation 1
                            	    34: 	; frame 2 = animation 0
                            	    35: 	; frame 3 = animation 2
                            	    36: 	;---------------------------------------------------------------------------
00:000013F2 08070000        	    37: 	btst.l	#$0,d7	; test if the frame is even (0 or 2)
00:000013F6 6604            	    38: 	bne.s	.1
                            	    39: 	; 0 or 2 logic
00:000013F8 7E00            	    40: 	moveq	#$0,d7	; zero out if 2, unnecessary 50% of the time of course
00:000013FA 600C            	    41: 	bra.s	.3	; move to add step
                            	    42: .1: ; 1 or 3 logic	
00:000013FC 08070001        	    43: 	btst.l	#$1,d7	; test if the frame is 1 or 3
00:00001400 6604            	    44: 	bne.s	.2	; frame number is 3 
                            	    45: 	; 3 logic
00:00001402 7E08            	    46: 	moveq	#$8,d7	; set animation frame to 1*8
00:00001404 6002            	    47: 	bra.s	.3	; move to add step
                            	    48: .2	; 3 logic
00:00001406 7E10            	    49: 	moveq	#$0010,d7	; set animation frame to 2*8
                            	    50: .3: ; add (frame*8) to pattern
00:00001408 DC47            	    51: 	add.w	d7,d6 	; add result to d6
                            	    52: DrawSprite:
00:0000140A 23C500C00004    	    53: 	move.l	d5,(VDP_CONTROL)	; set write location in VDP
00:00001410 33C600C00000    	    54: 	move.w	d6,(VDP_DATA)		; write the new pattern
                            	    55: ExitSetSpritePattern:
00:00001416 4E75            	    56: 	rts
                            	    57: 
                            	    58: 

Source: "inc_Subroutines.X68"
                            	    25: 
                            	    26: 	include	'sub_TestSpriteCollision.X68'

Source: "sub_TestSpriteCollision.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; TestSpriteCollision
                            	     3: ; tests sprite collision based on its direction
                            	     4: ; there is room to optimize and shorten this method a bit
                            	     5: ; a6 = address of sprite info start
                            	     6: ; a6 is not modified in this subroutine
                            	     7: ; a4 is modified instead of a6 to avoid issues in MoveSprite
                            	     8: ; a3 is used to load map data
                            	     9: ; d3 is used for multiple operations
                            	    10: ; d5 is used to store sprite y collision coordinate
                            	    11: ; d6 is used to store sprite x collision coordinate
                            	    12: ; d7 is used to test sprite direction and position against the map
                            	    13: ;-------------------------------------------------------------------------------
                            	    14: TestSpriteCollision:
                            	    15: 	;---------------------------------------------------------------------------
                            	    16: 	; a6 = SPRITE_ID
                            	    17: 	; a6 + 2 = SPRITE_X
                            	    18: 	; a6 + 4 = SPRITE_Y
                            	    19: 	; a6 + 6 = SPRITE_PATTERN_INDEX
                            	    20: 	; a6 + 8 = SPRITE_DIRECTION
                            	    21: 	; a6 + A = SPRITE_FRAME
                            	    22: 	; a6 + C = SPRITE_STEP_COUNTER
                            	    23: 	;---------------------------------------------------------------------------
                            	    24: TestSpriteCollisionSetup:
                            	    25: 	;---------------------------------------------------------------------------
                            	    26: 	; the setup section performs the following:
                            	    27: 	; -clears the result from the previous subroutine call
                            	    28: 	; -copies the sprite x position to d6, adjusts for scroll
                            	    29: 	; -copies the sprite y position to d5, adjusts for scroll & collision point 
                            	    30: 	; -copies the sprite direction to d7
                            	    31: 	;---------------------------------------------------------------------------
00:00001418 33FC0000FFFF0298	    32: 	move.w	#$0000,(MEM_COLLISION_RESULT)	; clear result
                            	    33: 	; copy sprite x postion to d6, and adjust for scroll
00:00001420 284E            	    34: 	movea.l	a6,a4			; store address in a4 because it is manipulated
00:00001422 D9FC00000002    	    35: 	adda.l	#$2,a4			; move to a4+2 -> SPRITE_X
00:00001428 3C14            	    36: 	move.w	(a4),d6			; store sprite x in d6
                            	    37: 	; copy sprite y postion to d5, and adjust for scroll & collision point
00:0000142A D9FC00000002    	    38: 	adda.l	#$2,a4			; move to a4+4 -> SPRITE_Y
00:00001430 3A14            	    39: 	move.w	(a4),d5			; copy the sprite's y-position to d5
00:00001432 DA7C0010        	    40: 	add.w	#SPRITE_COLLISION_Y,d5	; test against collision box
                            	    41: 	; copy sprite direction to d7
00:00001436 D9FC00000004    	    42: 	adda.l	#$4,a4			; move to a4+8 -> SPRITE_DIRECTION
00:0000143C 3E14            	    43: 	move.w	(a4),d7			; store direction in d7
                            	    44: TestSpriteVCollision:
                            	    45: TestUpCollision:
00:0000143E 0C470001        	    46: 	cmpi.w	#DIRECTION_UP,d7	; test if sprite is moving up
00:00001442 6600009E        	    47: 	bne.w	TestDownCollision 	; branch if not
                            	    48: TestUpCollisionLeftEdgeSetup:
00:00001446 3605            	    49: 	move.w	d5,d3	; copy y position to d3 because it is manipulated
00:00001448 967C0001        	    50: 	sub.w	#SPRITE_COLLISION_UP,d3	; test up from sprite
00:0000144C 020300F8        	    51: 	andi.b	#%11111000,d3	; clear bits 0-2 to round to nearest power of 8
00:00001450 0C460100        	    52: 	cmpi.w	#MAP_MID_X,d6	; is sprite on the left or right side of the screen?
00:00001454 6D02            	    53: 	blt.s	TestUpCollisionLeftEdge	; check if crossing the boundary
00:00001456 5843            	    54: 	addq	#$0004,d3		; on the right side, use 2nd lword for the column
                            	    55: TestUpCollisionLeftEdge:
00:00001458 47F9FFFF029A    	    56: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:0000145E D6C3            	    57: 	adda.w	d3,a3					; move to row
00:00001460 23D3FFFF0294    	    58: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
00:00001466 3606            	    59: 	move.w	d6,d3	; copy the sprite's x-position to d3 
00:00001468 C67C00FF        	    60: 	and.w	#$00FF,d3 ; remove all bits over 255
00:0000146C 86FC0008        	    61: 	divu.w	#$08,d3 ; divide by 8 to get index in map data
                            	    62: 	; clear remainder from high word (easy68k.com/paulrsm/doc/trick68k.htm)
00:00001470 4843            	    63: 	swap d3		; swap upper and lower words
00:00001472 4243            	    64: 	clr.w d3	; clear the upper word
00:00001474 4843            	    65: 	swap d3		; swap back
00:00001476 2E39FFFF0294    	    66: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:0000147C 0707            	    67: 	btst.l	d3,d7							; test for collision
00:0000147E 6700000E        	    68: 	beq.w	TestUpCollisionRightEdgeSetup	; no collision, test other side
00:00001482 33FCFFFFFFFF0298	    69: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:0000148A 60000204        	    70: 	bra.w	ExitTestSpriteCollision			; exit
                            	    71: TestUpCollisionRightEdgeSetup:
00:0000148E 3605            	    72: 	move.w	d5,d3	; copy y position to d3 because it is manipulated
00:00001490 967C0001        	    73: 	sub.w	#SPRITE_COLLISION_UP,d3	; test up from sprite
00:00001494 020300F8        	    74: 	andi.b	#%11111000,d3	; clear bits 0-2 to round to nearest power of 8
00:00001498 DC7C0010        	    75: 	add.w	#DEFAULT_SPRITE_WIDTH,d6	; move to right edge of sprite
00:0000149C 0C460100        	    76: 	cmpi.w	#MAP_MID_X,d6	; is right half on right side of the screen?
00:000014A0 6D02            	    77: 	blt.s	TestUpCollisionRightEdge	; check if crossing the boundary
00:000014A2 5843            	    78: 	addq	#$0004,d3		; on the right side, use 2nd lword for the column
                            	    79: TestUpCollisionRightEdge:
00:000014A4 47F9FFFF029A    	    80: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:000014AA D6C3            	    81: 	adda.w	d3,a3					; move to row
00:000014AC 23D3FFFF0294    	    82: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
00:000014B2 3606            	    83: 	move.w	d6,d3	; copy the sprite's x-position to d3
00:000014B4 C67C00FF        	    84: 	and.w	#$00FF,d3 ; remove all bits over 255
00:000014B8 86FC0008        	    85: 	divu.w	#$08,d3 ; divide by 8 to get index in map data
                            	    86: 	; clear remainder from high word (easy68k.com/paulrsm/doc/trick68k.htm)
00:000014BC 4843            	    87: 	swap d3		; swap upper and lower words
00:000014BE 4243            	    88: 	clr.w d3   	; clear the upper word
00:000014C0 4843            	    89: 	swap d3		; swap back
00:000014C2 33FC0000FFFF0298	    90: 	move.w	#$0000,(MEM_COLLISION_RESULT)	; clear result
00:000014CA 2E39FFFF0294    	    91: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:000014D0 0707            	    92: 	btst.l	d3,d7							; test for collision
00:000014D2 670001BC        	    93: 	beq.w	ExitTestSpriteCollision			; no collision, exit
00:000014D6 33FCFFFFFFFF0298	    94: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:000014DE 600001B0        	    95: 	bra.w	ExitTestSpriteCollision			; exit
                            	    96: TestDownCollision:
00:000014E2 0C470000        	    97: 	cmpi.w	#DIRECTION_DOWN,d7 		; test if sprite is moving down
00:000014E6 660000A0        	    98: 	bne.w	TestSpriteHCollision	; branch if not
                            	    99: TestDownCollisionLeftEdgeSetup:
00:000014EA 3605            	   100: 	move.w	d5,d3	; copy y position to d3 because it is manipulated
00:000014EC D67C0011        	   101: 	add.w	#SPRITE_COLLISION_DOWN,d3	; test down from sprite
00:000014F0 020300F8        	   102: 	andi.b	#%11111000,d3	; clear bits 0-2 to round to nearest power of 8
00:000014F4 0C460100        	   103: 	cmpi.w	#MAP_MID_X,d6	; is sprite on the left or right side of the screen?
00:000014F8 6D04            	   104: 	blt.s	TestDownCollisionLeftEdge	; check if crossing the boundary
00:000014FA D67C0004        	   105: 	add.w	#$0004,d3		; on the right side, use 2nd lword for the column
                            	   106: TestDownCollisionLeftEdge:
00:000014FE 47F9FFFF029A    	   107: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:00001504 D6C3            	   108: 	adda.w	d3,a3					; move to row
00:00001506 23D3FFFF0294    	   109: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
00:0000150C 3606            	   110: 	move.w	d6,d3	; copy the sprite's x-position to d3 
00:0000150E C67C00FF        	   111: 	and.w	#$00FF,d3 ; remove all bits over 255
00:00001512 86FC0008        	   112: 	divu.w	#$08,d3 ; divide by 8 to get index in map data
                            	   113: 	; clear remainder from high word (easy68k.com/paulrsm/doc/trick68k.htm)
00:00001516 4843            	   114: 	swap d3		; swap upper and lower words
00:00001518 4243            	   115: 	clr.w d3   	; clear the upper word
00:0000151A 4843            	   116: 	swap d3		; swap back
00:0000151C 2E39FFFF0294    	   117: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:00001522 0707            	   118: 	btst.l	d3,d7							; test for collision
00:00001524 6700000E        	   119: 	beq.w	TestDownCollisionRightEdgeSetup	; no collision, test other side
00:00001528 33FCFFFFFFFF0298	   120: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:00001530 6000015E        	   121: 	bra.w	ExitTestSpriteCollision			; exit
                            	   122: TestDownCollisionRightEdgeSetup:
00:00001534 3605            	   123: 	move.w	d5,d3	; copy y position to d3 because it is manipulated
00:00001536 D67C0011        	   124: 	add.w	#SPRITE_COLLISION_DOWN,d3	; test down from sprite
00:0000153A 020300F8        	   125: 	andi.b	#%11111000,d3	; clear bits 0-2 to round to nearest power of 8
00:0000153E DC7C0010        	   126: 	add.w	#DEFAULT_SPRITE_WIDTH,d6	; move to right edge of sprite
00:00001542 0C460100        	   127: 	cmpi.w	#MAP_MID_X,d6	; is sprite on the left or right side of the screen?
00:00001546 6D02            	   128: 	blt.s	TestDownCollisionRightEdge	; check if crossing the boundary
00:00001548 5843            	   129: 	addq	#$0004,d3		; on the right side, use 2nd lword for the column
                            	   130: TestDownCollisionRightEdge:
00:0000154A 47F9FFFF029A    	   131: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:00001550 D6C3            	   132: 	adda.w	d3,a3					; move to row
00:00001552 23D3FFFF0294    	   133: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
00:00001558 3606            	   134: 	move.w	d6,d3	; copy the sprite's x-position to d3
00:0000155A C67C00FF        	   135: 	and.w	#$00FF,d3 ; remove all bits over 255
00:0000155E 86FC0008        	   136: 	divu.w	#$08,d3 ; divide by 8 to get index in map data
                            	   137: 	; clear remainder from high word (easy68k.com/paulrsm/doc/trick68k.htm)
00:00001562 4843            	   138: 	swap d3		; swap upper and lower words
00:00001564 4243            	   139: 	clr.w d3   	; clear the upper word
00:00001566 4843            	   140: 	swap d3		; swap back
00:00001568 33FC0000FFFF0298	   141: 	move.w	#$0000,(MEM_COLLISION_RESULT)	; clear result
00:00001570 2E39FFFF0294    	   142: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:00001576 0707            	   143: 	btst.l	d3,d7							; test for collision
00:00001578 67000116        	   144: 	beq.w	ExitTestSpriteCollision			; no collision, exit
00:0000157C 33FCFFFFFFFF0298	   145: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:00001584 6000010A        	   146: 	bra.w	ExitTestSpriteCollision			; exit
                            	   147: TestSpriteHCollision:
                            	   148: TestRightCollision:
00:00001588 0C470003        	   149: 	cmpi.w	#DIRECTION_RIGHT,d7	; test if sprite is moving right
00:0000158C 66000080        	   150: 	bne.w	TestLeftCollision ; branch if not
                            	   151: TestRightSetup:
                            	   152: 	; d5 will have bottom edge, d3 will have bottom edge
00:00001590 3605            	   153: 	move.w	d5,d3	; copy y position to d3 to store bottom edge
00:00001592 D67C0010        	   154: 	add.w	#(DEFAULT_SPRITE_HEIGHT/2),d3	; move d3 to the bottom edge
00:00001596 020500F8        	   155: 	andi.b	#%11111000,d5	; clear bits 0-2 to round to nearest power of 8
00:0000159A 020300F8        	   156: 	andi.b	#%11111000,d3	; clear bits 0-2 to round to nearest power of 8
00:0000159E DC7C0011        	   157: 	add.w	#SPRITE_COLLISION_RIGHT,d6	; test right from sprite
00:000015A2 0C460100        	   158: 	cmpi.w	#MAP_MID_X,d6	; is collision on left or right side of the screen?
00:000015A6 6D04            	   159: 	blt.s	TestRightCollisionTopEdge ; left side, go directly to collision test
00:000015A8 5843            	   160: 	addq	#$0004,d3		; on the right side, use 2nd lword for the column
00:000015AA 5845            	   161: 	addq	#$0004,d5		; on the right side, use 2nd lword for the column
                            	   162: TestRightCollisionTopEdge:
00:000015AC 47F9FFFF029A    	   163: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:000015B2 D6C5            	   164: 	adda.w	d5,a3	; move to row & col of top edge
00:000015B4 23D3FFFF0294    	   165: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
                            	   166: 	;move.w	d7,d3	; copy the sprite's x-position to d3
00:000015BA CC7C00FF        	   167: 	and.w	#$00FF,d6 ; remove all bits over 255
00:000015BE 8CFC0008        	   168: 	divu.w	#$08,d6 ; divide by 8 to get index in map data
                            	   169: 	; clear remainder from high word
                            	   170: 	; credit to http://www.easy68k.com/paulrsm/doc/trick68k.htm for this trick
00:000015C2 4846            	   171: 	swap d6		; swap upper and lower words
00:000015C4 4246            	   172: 	clr.w d6   	; clear the upper word
00:000015C6 4846            	   173: 	swap d6		; swap back
00:000015C8 33FC0000FFFF0298	   174: 	move.w	#$0000,(MEM_COLLISION_RESULT)	; clear result
00:000015D0 2E39FFFF0294    	   175: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:000015D6 0D07            	   176: 	btst.l	d6,d7							; test for collision
00:000015D8 6700000E        	   177: 	beq.w	TestRightCollisionBottomEdge	; no collision, check lower half
00:000015DC 33FCFFFFFFFF0298	   178: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:000015E4 600000AA        	   179: 	bra.w	ExitTestSpriteCollision			; exit
                            	   180: TestRightCollisionBottomEdge:
00:000015E8 47F9FFFF029A    	   181: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:000015EE D6C3            	   182: 	adda.w	d3,a3	; move to row & col of bottom edge
00:000015F0 23D3FFFF0294    	   183: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
00:000015F6 2E39FFFF0294    	   184: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:000015FC 0D07            	   185: 	btst.l	d6,d7							; test for collision
00:000015FE 67000090        	   186: 	beq.w	ExitTestSpriteCollision 		; no collision, exit
00:00001602 33FCFFFFFFFF0298	   187: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:0000160A 60000084        	   188: 	bra.w	ExitTestSpriteCollision			; exit
                            	   189: TestLeftCollision:
00:0000160E 0C470002        	   190: 	cmpi.w	#DIRECTION_LEFT,d7	; test if sprite is moving Left
00:00001612 6600007C        	   191: 	bne.w	ExitTestSpriteCollision ; branch if not
                            	   192: TestLeftCollisionSetup:
                            	   193: 	; d5 will have top edge, d3 will have bottom edge
00:00001616 3605            	   194: 	move.w	d5,d3	; copy y position to d3 to store bottom edge
00:00001618 D67C0010        	   195: 	add.w	#(DEFAULT_SPRITE_HEIGHT/2),d3	; move d3 to the bottom edge
00:0000161C 020500F8        	   196: 	andi.b	#%11111000,d5	; clear bits 0-2 to round to nearest power of 8
00:00001620 020300F8        	   197: 	andi.b	#%11111000,d3	; clear bits 0-2 to round to nearest power of 8
00:00001624 9C7C0001        	   198: 	sub.w	#SPRITE_COLLISION_LEFT,d6	; test left from sprite
00:00001628 0C460100        	   199: 	cmpi.w	#MAP_MID_X,d6	; is collision on left or right side of the screen?
00:0000162C 6D04            	   200: 	blt.s	TestLeftCollisionTopEdge ; left side, go directly to collision test
00:0000162E 5843            	   201: 	addq	#$0004,d3		; on the right side, use 2nd lword for the column
00:00001630 5845            	   202: 	addq	#$0004,d5		; on the right side, use 2nd lword for the column
                            	   203: TestLeftCollisionTopEdge:
00:00001632 47F9FFFF029A    	   204: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:00001638 D6C5            	   205: 	adda.w	d5,a3	; move to row & col of top edge
00:0000163A 23D3FFFF0294    	   206: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
                            	   207: 	;move.w	d7,d3	; copy the sprite's x-position to d3
00:00001640 CC7C00FF        	   208: 	and.w	#$00FF,d6 ; remove all bits over 255
00:00001644 8CFC0008        	   209: 	divu.w	#$08,d6 ; divide by 8 to get index in map data
                            	   210: 	; clear remainder from high word
                            	   211: 	; credit to http://www.easy68k.com/paulrsm/doc/trick68k.htm for this trick
00:00001648 4846            	   212: 	swap d6		; swap upper and lower words
00:0000164A 4246            	   213: 	clr.w d6   	; clear the upper word
00:0000164C 4846            	   214: 	swap d6		; swap back
00:0000164E 33FC0000FFFF0298	   215: 	move.w	#$0000,(MEM_COLLISION_RESULT)	; clear result
00:00001656 2E39FFFF0294    	   216: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:0000165C 0D07            	   217: 	btst.l	d6,d7							; test for collision
00:0000165E 6700000E        	   218: 	beq.w	TestLeftCollisionBottomEdge	; no collision, check lower half
00:00001662 33FCFFFFFFFF0298	   219: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
00:0000166A 60000024        	   220: 	bra.w	ExitTestSpriteCollision			; exit
                            	   221: TestLeftCollisionBottomEdge:
00:0000166E 47F9FFFF029A    	   222: 	lea		MEM_COLLISION_DATA,a3	; move address of map data to a3
00:00001674 D6C3            	   223: 	adda.w	d3,a3	; move to row & col of bottom edge
00:00001676 23D3FFFF0294    	   224: 	move.l	(a3),MEM_COLLISION_MAP_ROW	; copy row data to memory
00:0000167C 2E39FFFF0294    	   225: 	move.l	MEM_COLLISION_MAP_ROW,d7		; move map data to d7
00:00001682 0D07            	   226: 	btst.l	d6,d7							; test for collision
00:00001684 6700000A        	   227: 	beq.w	ExitTestSpriteCollision 		; no collision, exit
00:00001688 33FCFFFFFFFF0298	   228: 	move.w	#$FFFF,(MEM_COLLISION_RESULT)	; collision is true, set result
                            	   229: ExitTestSpriteCollision:
00:00001690 4E75            	   230: 	rts
                            	   231: 
                            	   232: 
                            	   233: 

Source: "inc_Subroutines.X68"
                            	    27: 
                            	    28: 	include	'sub_MoveSprite.X68'

Source: "sub_MoveSprite.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; MoveSprite
                            	     3: ; move the sprite around based on the sprite direction and step counter
                            	     4: ; a6 = address of sprite info start
                            	     5: ; d7 is used for various operations
                            	     6: ;
                            	     7: ; this method was originally based on an example at:
                            	     8: ; 	http://bigevilcorporation.co.uk/2012/04/24/
                            	     9: ;	sega-megadrive-6-scary-monsters-and-nice-sprites/
                            	    10: ;	after adding animation and edge detection this code is a bit different
                            	    11: ;	but I still want to give credit to the site that helpful in getting started
                            	    12: ;-------------------------------------------------------------------------------
                            	    13: MoveSprite:
                            	    14: 	; collision detection
                            	    15: 	if	_SPRITE_COLLISION_
                            	    16: 	bsr.w	FlipSpriteMapPosition		; clear map data for current position
                            	    17: 	endif
00:00001692 6100FD84        	    18: 	bsr.w	TestSpriteCollision			; branch to test sprite collision
00:00001696 4A79FFFF0298    	    19: 	tst.w	(MEM_COLLISION_RESULT)		; 0 = no collision
00:0000169C 6708            	    20: 	beq.s	NoCollision					; no collision, continue moving
00:0000169E 610002E4        	    21: 	bsr.w	StopSprite					; collision, stop moving
00:000016A2 600000E2        	    22: 	bra.w	ExitMoveSprite				; collision, exit
                            	    23: NoCollision:
00:000016A6 3E2E0008        	    24: 	move.w	(STRUCT_SPRITE_DIRECTION,a6),d7	; store direction in d7
                            	    25: TestUp:
00:000016AA 0C470001        	    26: 	cmpi.w	#DIRECTION_UP,d7			; test for up
00:000016AE 6600003A        	    27: 	bne.w	TestDown					; branch if not
00:000016B2 33FCFFFFFFFF00BA	    28: 	move.w	#$FFFF,(MEM_SPRITE_Y_ORDER_CHANGED)	; flag that Y order changed
                            	    29: 	; update the sprite's Y position
00:000016BA 536E0004        	    30: 	subq	#SPRITE_STEP_PIXELS,(STRUCT_SPRITE_Y,a6)	; decrement SPRITE_Y
                            	    31: 	; update the sprite sort table
00:000016BE 342E0000        	    32: 	move.w	(STRUCT_SPRITE_ID,a6),d2	; copy ID to d2
00:000016C2 362E0004        	    33: 	move.w	(STRUCT_SPRITE_Y,a6),d3	; copy new Y value to d3
00:000016C6 610012F2        	    34: 	bsr.w	UpdateSpriteSortTable	; update the sprite table
                            	    35: 	; update the sprite in the sprite table
00:000016CA 3E16            	    36: 	move.w	(a6),d7						; copy sprite ID to d7
00:000016CC CEFC0008        	    37: 	mulu.w	#$08,d7						; mult by 8 to get sprite array offset
00:000016D0 4847            	    38: 	swap	d7                          ; move to upper word
00:000016D2 DEBC78000002    	    39: 	add.l	#VDP_VRAM_WRITE_SPRITE,d7	; add to sprite table address
00:000016D8 23C700C00004    	    40: 	move.l	d7,(VDP_CONTROL)			; set write location in VDP
00:000016DE 33EE000400C00000	    41: 	move.w	(STRUCT_SPRITE_Y,a6),(VDP_DATA)			; copy the new y-coordinate
00:000016E6 6000009A        	    42: 	bra.w	MoveSpriteSetPattern		; update the sprite pattern	and exit
                            	    43: TestDown:
00:000016EA 0C470000        	    44: 	cmpi.w	#DIRECTION_DOWN,d7			; test for down
00:000016EE 6600003A        	    45: 	bne.w	TestRight					; branch if not
00:000016F2 33FCFFFFFFFF00BA	    46: 	move.w	#$FFFF,(MEM_SPRITE_Y_ORDER_CHANGED)	; flag that Y order changed
                            	    47: 	; update the sprite's Y position
00:000016FA 526E0004        	    48: 	addq	#SPRITE_STEP_PIXELS,(STRUCT_SPRITE_Y,a6)	; increment SPRITE_Y
                            	    49: 	; update the sprite sort table
00:000016FE 342E0000        	    50: 	move.w	(STRUCT_SPRITE_ID,a6),d2	; copy ID to d2
00:00001702 362E0004        	    51: 	move.w	(STRUCT_SPRITE_Y,a6),d3	; copy new Y value to d3
00:00001706 610012B2        	    52: 	bsr.w	UpdateSpriteSortTable	; update the sprite table
00:0000170A 3E16            	    53: 	move.w	(a6),d7						; copy sprite ID to d7
00:0000170C CEFC0008        	    54:    	mulu.w	#$08,d7						; mult by 8 to get sprite array offset
00:00001710 4847            	    55: 	swap	d7                          ; move to upper word
00:00001712 DEBC78000002    	    56: 	add.l	#VDP_VRAM_WRITE_SPRITE,d7	; add to sprite table address
00:00001718 23C700C00004    	    57: 	move.l	d7,(VDP_CONTROL)			; set write location in VDP
00:0000171E 33EE000400C00000	    58: 	move.w	(STRUCT_SPRITE_Y,a6),(VDP_DATA)			; copy the new y-coordinate
00:00001726 6000005A        	    59: 	bra.w	MoveSpriteSetPattern		; update the sprite pattern	and exit
                            	    60: TestRight:
00:0000172A 0C470003        	    61: 	cmpi.w	#DIRECTION_RIGHT,d7			; test for right
00:0000172E 66000028        	    62: 	bne.w	TestLeft					; branch if not
                            	    63: 	; update the sprite's X position
00:00001732 526E0002        	    64: 	addq	#SPRITE_STEP_PIXELS,(STRUCT_SPRITE_X,a6)	; increment SPRITE_X
                            	    65: 	; update the sprite in the sprite table
00:00001736 3E16            	    66: 	move.w	(a6),d7						; copy sprite ID to d7
00:00001738 CEFC0008        	    67:    	mulu.w	#$08,d7						; mult by 8 to get sprite array offset
00:0000173C 5C47            	    68:    	addq	#STRUCT_SPRITEDEF_X,d7		; move to x-coordinate
00:0000173E 4847            	    69:    	swap	d7                          ; move to upper word
00:00001740 DEBC78000002    	    70: 	add.l	#VDP_VRAM_WRITE_SPRITE,d7	; add to sprite table address
00:00001746 23C700C00004    	    71: 	move.l	d7,(VDP_CONTROL)			; set write location in VDP
00:0000174C 33EE000200C00000	    72: 	move.w	(STRUCT_SPRITE_X,a6),(VDP_DATA)			; copy the new x-coordinate
00:00001754 6000002C        	    73: 	bra.w	MoveSpriteSetPattern		; update the sprite pattern	and exit
                            	    74: TestLeft:
00:00001758 0C470002        	    75: 	cmpi.w	#DIRECTION_LEFT,d7			; test for left
00:0000175C 66000028        	    76: 	bne.w	ExitMoveSprite				; branch if not
                            	    77: 	; update the sprite's X position
00:00001760 536E0002        	    78: 	subq	#SPRITE_STEP_PIXELS,(STRUCT_SPRITE_X,a6)	; decrement SPRITE_X
                            	    79: 	; update the sprite in the sprite table
00:00001764 3E16            	    80: 	move.w	(a6),d7						; copy sprite ID to d7
00:00001766 CEFC0008        	    81:    	mulu.w	#$08,d7						; mult by 8 to get sprite array offset
00:0000176A 5C47            	    82:    	addq	#STRUCT_SPRITEDEF_X,d7		; move to x-coordinate
00:0000176C 4847            	    83:    	swap	d7                          ; move to upper word
00:0000176E DEBC78000002    	    84: 	add.l	#VDP_VRAM_WRITE_SPRITE,d7	; add to sprite table address
00:00001774 23C700C00004    	    85: 	move.l	d7,(VDP_CONTROL)			; set write location in VDP
00:0000177A 33EE000200C00000	    86: 	move.w	(STRUCT_SPRITE_X,a6),(VDP_DATA)			; copy the new x-coordinate
                            	    87: MoveSpriteSetPattern:
                            	    88: 	; update the sprite animation	
00:00001782 6100FC36        	    89: 	bsr.w	SetSpritePattern		; set the new pattern for the sprite
                            	    90: ExitMoveSprite:
                            	    91: 	if	_SPRITE_COLLISION_
                            	    92: 	bsr.w	FlipSpriteMapPosition	; set map data for the sprites' new position
                            	    93: 	endif	
00:00001786 4E75            	    94: 	rts
                            	    95: 

Source: "inc_Subroutines.X68"
                            	    29: 
                            	    30: 	include	'sub_FixSprites.X68'

Source: "sub_FixSprites.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; Used to fix sprites when the scene is changed
                            	     3: ; 1) Moves the player sprite into the right place
                            	     4: ; 2) Resets sprite links since everything breaks them
                            	     5: ;-------------------------------------------------------------------------------
                            	     6: FixSprites:
                            	     7: 	; setting SPRITE_STEP_COUNTER to SPRITE_ANIMATION_STEPS forces movement
                            	     8: 	; animation to trigger the next time the sprite moves
00:00001788 33FC0008FFFF00C8	     9: 	move.w	#SPRITE_ANIMATION_STEPS,(MEM_PLAYER_SPRITE_STEP_COUNTER)
                            	    10: 	if	_SPRITE_COLLISION_
                            	    11: 	lea	(MEM_PLAYER_SPRITE_ID),a6	; setup call to FlipSpriteMapPosition	
                            	    12: 	bsr.w	FlipSpriteMapPosition	; block the sprite's initial position
                            	    13: 	endif
                            	    14: 	; update x & y values in the sprite table
00:00001790 2E3C78000002    	    15: 	move.l	#VDP_VRAM_WRITE_SPRITE,d7	; copy VDP VRAM write address to d7
00:00001796 DEBC00080000    	    16: 	add.l	#$00080000,d7	; add $00080000 to point to Y of 2nd sprite (player)
00:0000179C 23C700C00004    	    17: 	move.l	d7,(VDP_CONTROL)	; set VDP write address
00:000017A2 33F9FFFF00C000C0	    18: 	move.w	(MEM_PLAYER_SPRITE_Y),(VDP_DATA)	; write new Y value
00:000017AA 0000
00:000017AC 2E3C78000002    	    19: 	move.l	#VDP_VRAM_WRITE_SPRITE,d7	; copy VDP VRAM write address to d7
00:000017B2 DEBC000E0000    	    20: 	add.l	#$000E0000,d7	; add $00080000 to point to Y of 2nd sprite (player)
00:000017B8 23C700C00004    	    21: 	move.l	d7,(VDP_CONTROL)	; set VDP write address
00:000017BE 33F9FFFF00BE00C0	    22: 	move.w	(MEM_PLAYER_SPRITE_X),(VDP_DATA)	; write new X value
00:000017C6 0000
                            	    23: 	; update sprite sort table	
00:000017C8 3439FFFF00BC    	    24: 	move.w	(MEM_PLAYER_SPRITE_ID),d2	; copy ID to d2
00:000017CE 3639FFFF00C0    	    25: 	move.w	(MEM_PLAYER_SPRITE_Y),d3	; copy new Y value to d3
00:000017D4 610011E4        	    26: 	bsr.w	UpdateSpriteSortTable	; update the sprite table
00:000017D8 6100114A        	    27: 	bsr.w	OrderSprites	; sort the sprite table
                            	    28: 	; workaround to issue where links aren't set if the table is already sorted	
00:000017DC 46FC2700        	    29: 	move.w	#$2700,sr		; disable interrupts
00:000017E0 610010EE        	    30: 	bsr.w	SetSpriteLinks
00:000017E4 46FC2000        	    31: 	move.w	#$2000,sr		; re-enable interrupts
                            	    32: ExitFixSprites:
00:000017E8 4E75            	    33: 	rts
                            	    34: 

Source: "inc_Subroutines.X68"
                            	    31: 
                            	    32: 	include	'sub_ReloadSpriteTiles.X68'

Source: "sub_ReloadSpriteTiles.X68"
                            	     1: ReloadSpriteTiles:
00:000017EA 610002A2        	     2: 	bsr.w	LoadSpriteZeroTiles
00:000017EE 610002C0        	     3: 	bsr.w	LoadPlayerSpriteTiles
                            	     4: 	; this gets the player tiles back but sprite is in wrong position
00:000017F2 61000266        	     5: 	bsr.w	LoadPlayerSprite
                            	     6: 	; player will be back at default location
                            	     7: 	if	_SPRITE_COLLISION_
                            	     8: 	lea	(MEM_PLAYER_SPRITE_ID),a6	; setup call to FlipSpriteMapPosition
                            	     9: 	bsr.w	FlipSpriteMapPosition	; block the sprite's initial position
                            	    10: 	endif
00:000017F6 23FC7808000200C0	    11: 	move.l	#PLAYER_SPRITE_VDP_Y,(VDP_CONTROL)	; set write location in VDP
00:000017FE 0004
00:00001800 33F9FFFF00C000C0	    12: 	move.w	(MEM_PLAYER_SPRITE_Y),(VDP_DATA)	; copy the new y-coordinate
00:00001808 0000
00:0000180A 23FC780E000200C0	    13: 	move.l	#PLAYER_SPRITE_VDP_X,(VDP_CONTROL)	; set write location in VDP
00:00001812 0004
00:00001814 33F9FFFF00BE00C0	    14: 	move.w	(MEM_PLAYER_SPRITE_X),(VDP_DATA)	; copy the new y-coordinate
00:0000181C 0000
                            	    15: 	if	_SPRITE_COLLISION_
                            	    16: 	lea	(MEM_PLAYER_SPRITE_ID),a6	; setup call to FlipSpriteMapPosition
                            	    17: 	bsr.w	FlipSpriteMapPosition	; block the sprite's initial position
                            	    18: 	endif
                            	    19: 	; this seems to get all the NPC sprites right
00:0000181E 46FC2700        	    20: 	move.w	#$2700,sr		; disable interrupts
00:00001822 610004FE        	    21: 	bsr.w	LoadSceneLoadNPCSprites
                            	    22: 	; needed to get all sprites displaying
00:00001826 610010A8        	    23: 	bsr.w	SetSpriteLinks
00:0000182A 46FC2000        	    24: 	move.w	#$2000,sr		; re-enable interrupts
00:0000182E 4E75            	    25: 	rts
                            	    26: 

Source: "inc_Subroutines.X68"
                            	    33: 
                            	    34: 	include	'sub_SetActiveSpriteMapRowCol.X68'

Source: "sub_SetActiveSpriteMapRowCol.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; SetActiveSpriteMapRowCol
                            	     3: ; sets values for:
                            	     4: ;	MEM_ACTIVE_SPRITE_LEFT_COLUMN
                            	     5: ;	MEM_ACTIVE_SPRITE_RIGHT_COLUMN
                            	     6: ;	MEM_ACTIVE_SPRITE_HIGH_LEFT
                            	     7: ;	MEM_ACTIVE_SPRITE_HIGH_RIGHT
                            	     8: ;	MEM_ACTIVE_SPRITE_LOW_LEFT
                            	     9: ;	MEM_ACTIVE_SPRITE_LOW_RIGHT
                            	    10: ; a6 = address of sprite info start
                            	    11: ; d6 is used to store x values
                            	    12: ; d5 is used to store y values
                            	    13: ; d7 is used for all other operations
                            	    14: ;-------------------------------------------------------------------------------
                            	    15: SetActiveSpriteMapRowCol:
                            	    16: SetActiveSpriteLeftCol:
                            	    17: 	; copy sprite x postion to d7
00:00001830 4287            	    18: 	clr.l	d7
00:00001832 3E2E0002        	    19: 	move.w	(STRUCT_SPRITE_X,a6),d7	; store sprite x in d7
00:00001836 2C07            	    20: 	move.l	d7,d6	; copy to d6 for later use
00:00001838 CE7C00FF        	    21: 	and.w	#$00FF,d7 ; remove all bits over 255
00:0000183C 8EFC0008        	    22: 	divu.w	#$08,d7 ; divide by 8 to get index in map data
                            	    23: 	; clear remainder from high word (easy68k.com/paulrsm/doc/trick68k.htm)
00:00001840 4847            	    24: 	swap d7		; swap upper and lower words
00:00001842 4247            	    25: 	clr.w d7	; clear the upper word
00:00001844 4847            	    26: 	swap d7		; swap back
00:00001846 33C7FFFF0288    	    27: 	move.w	d7,(MEM_ACTIVE_SPRITE_LEFT_COLUMN)	; copy left column value
                            	    28: SetActiveSpriteLeftHighLow:
                            	    29: 	; copy sprite y postion to d7
00:0000184C 3E2E0004        	    30: 	move.w	(STRUCT_SPRITE_Y,a6),d7	; store sprite y in d7
00:00001850 DE7C0018        	    31: 	add.w	#$18,d7	; top edge of lower 1/4
00:00001854 3A07            	    32: 	move.w	d7,d5	; copy the adjusted y value 
00:00001856 5045            	    33: 	addq	#$08,d5	; move d5 to bottom edge of lower 1/4
                            	    34: 	; map the sprite y position to a column
00:00001858 020700F8        	    35: 	andi.b	#%11111000,d7	; clear bits 0-2 to round to nearest power of 8
00:0000185C 020500F8        	    36: 	andi.b	#%11111000,d5	; clear bits 0-2 to round to nearest power of 8
00:00001860 0C460100        	    37: 	cmpi.w	#MAP_MID_X,d6	; is column on the left or right side of the screen?
00:00001864 6D04            	    38: 	blt.s	.2	; branch if on left side
00:00001866 5847            	    39: 	addq	#$0004,d7	; on the right side, use 2nd lword for the column
00:00001868 5845            	    40: 	addq	#$0004,d5	; on the right side, use 2nd lword for the column
                            	    41: .2
00:0000186A 33C7FFFF028A    	    42: 	move.w	d7,(MEM_ACTIVE_SPRITE_HIGH_LEFT)	; copy high left value 
00:00001870 33C5FFFF028C    	    43: 	move.w	d5,(MEM_ACTIVE_SPRITE_LOW_LEFT)	; copy low left value
                            	    44: SetActiveSpriteRightCol:	
00:00001876 DC7C000F        	    45: 	add.w	#$0F,d6	; move d6 to right side of sprite
00:0000187A 3E06            	    46: 	move.w	d6,d7	; store sprite x in d7
00:0000187C CE7C00FF        	    47: 	and.w	#$00FF,d7 ; remove all bits over 255
00:00001880 8EFC0008        	    48: 	divu.w	#$08,d7 ; divide by 8 to get index in map data
                            	    49: 	; clear remainder from high word (easy68k.com/paulrsm/doc/trick68k.htm)
00:00001884 4847            	    50: 	swap d7		; swap upper and lower words
00:00001886 4247            	    51: 	clr.w d7	; clear the upper word
00:00001888 4847            	    52: 	swap d7		; swap back
00:0000188A 33C7FFFF028E    	    53: 	move.w	d7,(MEM_ACTIVE_SPRITE_RIGHT_COLUMN)	; copy left column value
                            	    54: SetActiveSpriteRightHighLow:
                            	    55: 	; copy sprite y postion to d7
00:00001890 3E2E0004        	    56: 	move.w	(STRUCT_SPRITE_Y,a6),d7	; store sprite y in d7
00:00001894 DE7C0018        	    57: 	add.w	#$18,d7	; top edge of lower 1/4
00:00001898 3A07            	    58: 	move.w	d7,d5	; copy the adjusted y value 
00:0000189A 5045            	    59: 	addq	#$08,d5	; move d5 to bottom edge of lower 1/4
                            	    60: 	; map the sprite y position to a column
00:0000189C 020700F8        	    61: 	andi.b	#%11111000,d7	; clear bits 0-2 to round to nearest power of 8
00:000018A0 020500F8        	    62: 	andi.b	#%11111000,d5	; clear bits 0-2 to round to nearest power of 8
00:000018A4 0C460100        	    63: 	cmpi.w	#MAP_MID_X,d6	; is column on the left or right side of the screen?
00:000018A8 6D04            	    64: 	blt.s	.4	; branch if on left side
00:000018AA 5847            	    65: 	addq	#$0004,d7	; on the right side, use 2nd lword for the column
00:000018AC 5845            	    66: 	addq	#$0004,d5	; on the right side, use 2nd lword for the column
                            	    67: .4
00:000018AE 33C7FFFF0290    	    68: 	move.w	d7,(MEM_ACTIVE_SPRITE_HIGH_RIGHT)	; copy high left value
00:000018B4 33C5FFFF0292    	    69: 	move.w	d5,(MEM_ACTIVE_SPRITE_LOW_RIGHT)	; copy low left value
00:000018BA 4E75            	    70: 	rts
