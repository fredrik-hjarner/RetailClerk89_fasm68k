                            	     7: ;-------------------------------------------------------------------------------
                            	     8: ; table to sort the draw order of sprites
                            	     9: ;-------------------------------------------------------------------------------
                            	    10: MEM_SPRITE_SORT_TABLE_SORTED=$FFFF0004	; 0000=sorted
