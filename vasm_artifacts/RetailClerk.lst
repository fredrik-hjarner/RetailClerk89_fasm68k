                            	   451: Day05Scene0EAction01NPCSub:
                            	   452: 	;---------------------------------------------------------------------------
                            	   453: 	; three possible outcomes
                            	   454: 	; MISSION_FLAG_DAY05_READBOOK = 0 -> DialogTextDay05SubDontKnow
                            	   455: 	; MISSION_FLAG_DAY05_FOOD0GET = 0 -> 
                            	   456: 	; DialogTextDay05ScriptedEventSub00D0+ScriptedEventDay05Sub00
                            	   457: 	; MISSION_FLAG_DAY05_FOOD0GET = 1 -> DialogTextScene0EDay05NPCSub00
                            	   458: 	;---------------------------------------------------------------------------
00:00007E3C 2E39FFFF00A6    	   459: 	move.l	(MEM_MISSION_EVENT_FLAGS),d7	; copy event flags to d7
00:00007E42 08070000        	   460: 	btst.l	#MISSION_FLAG_DAY05_READBOOK,d7	; test flag
00:00007E46 660E            	   461: 	bne.s .1	; branch if set
00:00007E48 4DF900106F50    	   462: 	lea	DialogTextDay05SubDontKnow,a6	; load text
00:00007E4E 23CEFFFF022E    	   463: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:00007E54 4E75            	   464: 	rts
                            	   465: .1	; MISSION_FLAG_DAY05_READBOOK = 1
00:00007E56 08070001        	   466: 	btst.l	#MISSION_FLAG_DAY05_FOOD0GET,d7	; test flag
00:00007E5A 662A            	   467: 	bne.s .2	; branch if set
                            	   468: 	; update flags
00:00007E5C 08C70001        	   469: 	bset.l	#MISSION_FLAG_DAY05_FOOD0GET,d7	; set flag
00:00007E60 23C7FFFF00A6    	   470: 	move.l	d7,(MEM_MISSION_EVENT_FLAGS)	; save updated flags
                            	   471: 	; add item to inventory
00:00007E66 3E3C3032        	   472: 	move.w	#OBJ_ITEM_MIXEDNUTS,d7	; copy item id to d7
00:00007E6A 6100AFC2        	   473: 	bsr.w	AddItem	; add item to inventory
                            	   474: 	; queue scripted event
00:00007E6E 4DF90001BC8E    	   475: 	lea ScriptedEventDay05Sub00,a6	; point a6 to event to load
00:00007E74 6100B088        	   476: 	bsr.w QueueScriptedEvent	; queue the event
00:00007E78 4DF900106FC0    	   477: 	lea	DialogTextDay05ScriptedEventSub00D0,a6	; load text
00:00007E7E 23CEFFFF022E    	   478: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
00:00007E84 4E75            	   479: 	rts
                            	   480: .2	; MISSION_FLAG_DAY05_FOOD0GET = 1
00:00007E86 4DF900107064    	   481: 	lea	DialogTextScene0EDay05NPCSub00,a6	; load text
00:00007E8C 23CEFFFF022E    	   482: 	move.l	a6,MEM_DIALOG_TEXT	; copy address to MEM_DIALOG_TEXT
