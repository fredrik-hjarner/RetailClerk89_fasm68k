                            	   181: 
                            	   182: ;*******************************************************************************
                            	   183: ; sprite table definitions
                            	   184: ;*******************************************************************************
                            	   185: 	include 'data_SpriteDefinitions.X68'

Source: "data_SpriteDefinitions.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; sprite definition notes
                            	     3: ; from: http://emu-docs.org/Genesis/Graphics/genvdp.txt
                            	     4: ; -sprite attribute table is 640 bytes in size. 
                            	     5: ; -each entry is 8-bytes in the following format:
                            	     6: ;	index + 0  :   ------yy yyyyyyyy
                            	     7: ;	index + 2  :   ----hhvv
                            	     8: ;	index + 3  :   -lllllll
                            	     9: ;	index + 4  :   pccvhnnn nnnnnnnn
                            	    10: ;	index + 6  :   ------xx xxxxxxxx
                            	    11: ; where 
                            	    12: ;	y = vertical coordinate of sprite
                            	    13: ;	h = horizontal size in cells (00b=1 cell, 11b=4 cells)
                            	    14: ;	v = vertical size in cells (00b=1 cell, 11b=4 cells)
                            	    15: ;	l = link field
                            	    16: ;	p = priority
                            	    17: ;	c = color palette
                            	    18: ;	v = vertical flip
                            	    19: ;	h = horizontal flip
                            	    20: ;	n = sprite pattern start index
                            	    21: ;	x = horizontal coordinate of sprite
                            	    22: ;-------------------------------------------------------------------------------
                            	    23: 
                            	    24: ; low version that exists for status screen
                            	    25: SpriteZeroLowDefinition:
                            	    26: 	;---------------------------------------------------------------------------
                            	    27: 	; index + 0 = vertical coordinate
                            	    28: 	; ---- --yy yyyy yyyy
                            	    29: 	;---------------------------------------------------------------------------
00:0001B172 0000            	    30: 	dc.w 	$0000
                            	    31: 	;---------------------------------------------------------------------------
                            	    32: 	; index + 2 = size (00=8px,01=16px,11=32px)
                            	    33: 	;---------------------------------------------------------------------------
                            	    34: 			;----hhvv
00:0001B174 00              	    35: 	dc.b	%00000000	; width=8,height=8
                            	    36: 	;---------------------------------------------------------------------------
                            	    37: 	; index + 3 = link field
                            	    38: 	;---------------------------------------------------------------------------
                            	    39: 			;-lllllll
00:0001B175 01              	    40: 	dc.b	%00000001	; 1
                            	    41: 	;---------------------------------------------------------------------------
                            	    42: 	; index + 4 = priority, palette, flip, pattern
                            	    43: 	;---------------------------------------------------------------------------
                            	    44: 			;pccvhnnnnnnnnnnn
00:0001B176 0110            	    45: 	dc.w 	%0000000100010000	; pri=1,palette=0,vflip=0,hflip=0,pattern=272
                            	    46:             ;0110000100010000
                            	    47: 
                            	    48: 	;---------------------------------------------------------------------------
                            	    49: 	; index + 6 = horizontal coordinate
                            	    50: 	; ---- --yy yyyy yyyy
                            	    51: 	;---------------------------------------------------------------------------
00:0001B178 0000            	    52: 	dc.w 	$0000
                            	    53: 
                            	    54: ; regular (high) version is for dialogs in the "overworld"
                            	    55: SpriteZeroDefinition:
                            	    56: 	;---------------------------------------------------------------------------
                            	    57: 	; index + 0 = vertical coordinate
                            	    58: 	; ---- --yy yyyy yyyy
                            	    59: 	;---------------------------------------------------------------------------
00:0001B17A 0000            	    60: 	dc.w 	$0000
                            	    61: 	;---------------------------------------------------------------------------
                            	    62: 	; index + 2 = size (00=8px,01=16px,11=32px)
                            	    63: 	;---------------------------------------------------------------------------
                            	    64: 			;----hhvv
00:0001B17C 00              	    65: 	dc.b	%00000000	; width=8,height=8
                            	    66: 	;---------------------------------------------------------------------------
                            	    67: 	; index + 3 = link field
                            	    68: 	;---------------------------------------------------------------------------
                            	    69: 			;-lllllll
00:0001B17D 01              	    70: 	dc.b	%00000001	; 1
                            	    71: 	;---------------------------------------------------------------------------
                            	    72: 	; index + 4 = priority, palette, flip, pattern
                            	    73: 	;---------------------------------------------------------------------------
                            	    74: 			;pccvhnnnnnnnnnnn
00:0001B17E 8110            	    75: 	dc.w 	%1000000100010000	; pri=1,palette=0,vflip=0,hflip=0,pattern=272
                            	    76:             ;0110000100010000
                            	    77: 
                            	    78: 	;---------------------------------------------------------------------------
                            	    79: 	; index + 6 = horizontal coordinate
                            	    80: 	; ---- --yy yyyy yyyy
                            	    81: 	;---------------------------------------------------------------------------
00:0001B180 0000            	    82: 	dc.w 	$0000
                            	    83: 
                            	    84: PlayerSpriteDefinition:
                            	    85: 	;---------------------------------------------------------------------------
                            	    86: 	; index + 0 = vertical coordinate
                            	    87: 	; ---- --yy yyyy yyyy
                            	    88: 	;---------------------------------------------------------------------------
00:0001B182 0100            	    89: 	dc.w 	SPRITE_PLAYER_INIT_Y
                            	    90: 	;---------------------------------------------------------------------------
                            	    91: 	; index + 2 = size (00=8px,01=16px,11=32px)
                            	    92: 	;---------------------------------------------------------------------------
                            	    93: 			;----hhvv
00:0001B184 07              	    94: 	dc.b	%00000111	; width=16,height=32
                            	    95: 	;---------------------------------------------------------------------------
                            	    96: 	; index + 3 = link field
                            	    97: 	;---------------------------------------------------------------------------
                            	    98: 			;-lllllll
00:0001B185 02              	    99: 	dc.b	%00000010	; 2
                            	   100: 	;---------------------------------------------------------------------------
                            	   101: 	; index + 4 = priority, palette, flip, pattern
                            	   102: 	;---------------------------------------------------------------------------
                            	   103: 			;pccvhnnnnnnnnnnn
00:0001B186 6000            	   104: 	dc.w 	%0110000000000000	; pri=0,palette=2,vflip=0,hflip=0,pattern=0
                            	   105: 
                            	   106: 	;---------------------------------------------------------------------------
                            	   107: 	; index + 6 = horizontal coordinate
                            	   108: 	; ---- --yy yyyy yyyy
                            	   109: 	;---------------------------------------------------------------------------
00:0001B188 0100            	   110: 	dc.w 	SPRITE_PLAYER_INIT_X
                            	   111: 
                            	   112: 

