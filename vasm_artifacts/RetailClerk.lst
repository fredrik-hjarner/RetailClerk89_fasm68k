                            	    89: MEM_NPC0_MOVE_INDEX=$FFFF00EE	; where the sprite is the movement pattern
                            	    90: MEM_NPC1_SPRITE_ID=$FFFF00F0	; sprite table id of NPC1 sprite
                            	    91: MEM_NPC1_SPRITE_X=$FFFF00F2	; virtual x position of NPC1 sprite
                            	    92: MEM_NPC1_SPRITE_Y=$FFFF00F4	; virtual y position of NPC1 sprite
