Source: "sub_EndDemo.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; setup end screen
                            	     3: ;-------------------------------------------------------------------------------
                            	     4: EndDemo:
                            	     5: 	; set the end game flag
00:00002BFC 2E39FFFF0028    	     6: 	move.l	(MEM_GAME_STATE),d7	; copy game state to d7
00:00002C02 CEBC00000000    	     7: 	and.l	#$0000,d7	; clear all other flags
00:00002C08 08C70008        	     8: 	bset.l	#STATE_FLAG_END_SCREEN,d7 ; set end screen state flag	
00:00002C0C 23C7FFFF0028    	     9: 	move.l	d7,(MEM_GAME_STATE)	; save updated game state
                            	    10: 	; load end scene
00:00002C12 4DF90001430C    	    11: 	lea	SceneEnd,a6	; address of the scene for the title screen
00:00002C18 6100F030        	    12: 	bsr.w	LoadScene	; branch to LoadScene subroutine
00:00002C1C 4E75            	    13: 	rts
                            	    14: 

