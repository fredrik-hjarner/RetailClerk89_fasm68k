Source: "sub_ResetDialog.X68"
                            	     1: ; resets the dialog so new text can be drawn without closing & reopening
                            	     2: ResetDialog:
                            	     3: 	; reset the drawing location for the dialog title
00:00002A90 23FC49940003FFFF	     4: 	move.l	#(VDP_VRAM_WRITE_A+DIALOG_TITLE_ROWCOL),(MEM_DIALOG_VDP)
00:00002A98 0232
00:00002A9A 23FC4A920003FFFF	     5: 	move.l	#(VDP_VRAM_WRITE_A+DIALOG_TEXT_ROWCOL),(MEM_DIALOG_VDP)
00:00002AA2 0232
                            	     6: 	; clear out text in the dialog	
00:00002AA4 61000040        	     7: 	bsr.w	ClearDialog
                            	     8: 	; reset flags to force text to start re-drawing
00:00002AA8 08C7001C        	     9: 	bset.l	#DIALOG_FLAG_TEXT_DRAWING,d7	; set text drawing flag
00:00002AAC 0887001D        	    10: 	bclr.l	#DIALOG_FLAG_TEXT_OPEN,d7	; clear open flag
00:00002AB0 0887001E        	    11: 	bclr.l	#DIALOG_FLAG_TEXT_NEW_PAGE,d7	; clear new page flag
00:00002AB4 08870017        	    12: 	bclr.l	#DIALOG_FLAG_STYLE_TEXT_2CHOICE,d7	; clear menu style choice flags
00:00002AB8 08870016        	    13: 	bclr.l	#DIALOG_FLAG_STYLE_TEXT_4CHOICE,d7	; clear menu style choice flag
00:00002ABC 08870015        	    14: 	bclr.l	#DIALOG_FLAG_STYLE_MENU,d7	; clear menu style flag
00:00002AC0 08870014        	    15: 	bclr.l	#DIALOG_FLAG_STYLE_ITEM_MENU,d7	; clear menu style flag
00:00002AC4 08C70018        	    16: 	bset.l	#DIALOG_FLAG_STYLE_SIMPLE_TEXT,d7	; set simple text style flag
00:00002AC8 08870019        	    17: 	bclr.l	#DIALOG_FLAG_SELECTION_WAIT,d7	; clear waiting for selection flag
00:00002ACC 23C7FFFF0226    	    18: 	move.l	d7,(MEM_DIALOG_FLAGS) ; copy game state back to d7
                            	    19: 	; test for option to persist the selector
00:00002AD2 08070012        	    20: 	btst.l	#DIALOG_FLAG_OPTION_PERSIST_SELECTOR,d7	; test option
00:00002AD6 660C            	    21: 	bne.s	ExitResetDialog	; exit if flag is set
00:00002AD8 33FCFFFFFFFF0222	    22: 	move.w	#DIALOG_NO_RESPONSE,(MEM_MENU_SELECTION)	; reset menu selection
00:00002AE0 6100FC88        	    23: 	bsr.w	HideSelectorSprite	; hide the selection icon
                            	    24: ExitResetDialog:
00:00002AE4 4E75            	    25: 	rts
                            	    26: 

Source: "inc_Subroutines.X68"
                            	    73: 
                            	    74: 	include	'sub_ClearDialog.X68'

Source: "sub_ClearDialog.X68"
                            	     1: ;*******************************************************************************
                            	     2: ; clears all text in the dialog and redraws the frame
                            	     3: ; d0,d1,d7 are modified
                            	     4: ; a0,a1 are modified 
                            	     5: ; anything DrawTileset modifies is also modified
                            	     6: ;*******************************************************************************
                            	     7: ClearDialog:
00:00002AE6 2E39FFFF0226    	     8: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy current dialog state to d7
00:00002AEC 08070013        	     9: 	btst.l	#DIALOG_FLAG_STYLE_TITLED,d7	; is the titled flag set?
00:00002AF0 6712            	    10: 	beq.s	ClearDialogDefault	; not set, branch
                            	    11: ClearDialogTitled:
                            	    12: 	; reset the drawing location for the dialog text
00:00002AF2 23FC49940003FFFF	    13: 	move.l	#(VDP_VRAM_WRITE_A+DIALOG_TITLE_ROWCOL),(MEM_DIALOG_VDP)
00:00002AFA 0232
                            	    14: 	; clear out the dialog
00:00002AFC 207C0000DFEA    	    15: 	movea.l	#PatternDialogTitledFull,a0	; point a0 to start of dialog patterns
00:00002B02 6010            	    16: 	bra.s	ClearDialogDrawTileset	; branch
                            	    17: ClearDialogDefault:
                            	    18: 	; reset the drawing location for the dialog text
00:00002B04 23FC4A920003FFFF	    19: 	move.l	#(VDP_VRAM_WRITE_A+DIALOG_TEXT_ROWCOL),(MEM_DIALOG_VDP)
00:00002B0C 0232
                            	    20: 	; clear out the dialog
00:00002B0E 207C0000D1D6    	    21: 	movea.l	#PatternDialogFull,a0	; point a0 to start of dialog patterns
                            	    22: ClearDialogDrawTileset:
00:00002B14 303C8090        	    23: 	move.w	#DIALOG_BASE_TILE,d0	; base pattern
00:00002B18 7200            	    24: 	moveq	#$0000,d1	; repeat
00:00002B1A 227C49100003    	    25: 	movea.l	#(VDP_VRAM_WRITE_A+DIALOG_ROWCOL),a1	; initial drawing location
00:00002B20 6100DE9A        	    26: 	bsr.w	DrawTileset		; branch to DrawTileset subroutine
                            	    27: ExitClearDialog:
00:00002B24 4E75            	    28: 	rts
                            	    29: 
                            	    30: ;*******************************************************************************
                            	    31: ; clears all text in the dialog but doesn't update the frame
                            	    32: ; d0 is modified
                            	    33: ; a0,a1 are modified 
                            	    34: ; anything DrawTileset modifies is also modified
                            	    35: ;*******************************************************************************
                            	    36: ClearDialogTextArea:
                            	    37: 	; clear out the dialog text
00:00002B26 41F90000D2FA    	    38: 	lea PatternDialogClearTextArea,a0	; point a0 to pattern for clear text
00:00002B2C 303C8090        	    39: 	move.w	#DIALOG_BASE_TILE,d0	; base pattern
00:00002B30 7200            	    40: 	moveq	#$0000,d1	; repeat
00:00002B32 43F940000003    	    41: 	lea	VDP_VRAM_WRITE_A,a1	; initial drawing location
00:00002B38 D3FC0A900000    	    42: 	adda.l	#DIALOG_TEXT_AREA_ROWCOL,a1	; move to row & column
00:00002B3E 6100DE7C        	    43: 	bsr.w	DrawTileset		; branch to DrawTileset subroutine
00:00002B42 4E75            	    44: 	rts
                            	    45: 

Source: "inc_Subroutines.X68"
                            	    75: 
                            	    76: 	include	'sub_BuildVRAMWriteAddress.X68'

Source: "sub_BuildVRAMWriteAddress.X68"
                            	     1: ;-------------------------------------------------------------------------------
                            	     2: ; BuildVRAMWriteAddress
                            	     3: ; builds the VRAM write address based on a relative address
                            	     4: ; i.e. - passing $2200 should return $62000000
                            	     5: ; d1 = relative VDP write address, final result is also stored in d1
                            	     6: ; d0 is modified in this routine
                            	     7: ;-------------------------------------------------------------------------------
                            	     8: BuildVRAMWriteAddress:
                            	     9: 	; the two highest bits in d1 need to be the lowest bits in the final result
00:00002B44 3001            	    10: 	move.w	d1,d0 ; start by copying d1 to d0	
00:00002B46 EE48            	    11: 	lsr.w	#$07,d0	; shift bits 7 to the right
00:00002B48 EE48            	    12: 	lsr.w	#$07,d0	; shift bits 7 more to the right
00:00002B4A C0BC00000003    	    13: 	and.l	#%00000000000000000000000000000011,d0	; clear all but lowest two
                            	    14: 	; the two highest bits from d1 are now in d0
00:00002B50 4841            	    15: 	swap	d1	; move the value in d1 to the high word
00:00002B52 C2BC3FFF0000    	    16: 	and.l	#%00111111111111110000000000000000,d1	; clear all but the magic 14
00:00002B58 D280            	    17: 	add.l	d0,d1	; add the value in d0
00:00002B5A D2BC40000000    	    18: 	add.l	#VDP_VRAM_WRITE,d1	; add the base VRAM write address
00:00002B60 4E75            	    19: 	rts
                            	    20: 

Source: "inc_Subroutines.X68"
                            	    77: 
                            	    78: 	include	'sub_ShowSelectionDialog.X68'

Source: "sub_ShowSelectionDialog.X68"
                            	     1: ShowSelectionDialog:
00:00002B62 3E39FFFF002E    	     2: 	move.w	(MEM_ACTION_TARGET_OBJID),d7	; move target object ID to d7
00:00002B68 02470FFF        	     3: 	andi.w	#$0FFF,d7	; clear the base value
00:00002B6C CEFC0004        	     4: 	mulu.w	#$4,d7	; multiply by 4 to get the offset
00:00002B70 3C39FFFF002E    	     5: 	move.w	(MEM_ACTION_TARGET_OBJID),d6	; copy action target to d6
00:00002B76 02461000        	     6: 	andi.w	#OBJ_SCENE_BASE,d6	; and against OBJ_SCENE_BASE
00:00002B7A 6708            	     7: 	beq.s	ShowSelectionDialogNPC	; if result is zero then this is not scenery
00:00002B7C 4DF90001C93E    	     8: 	lea	ObjectNameTable,a6	; point to default object text table
00:00002B82 6006            	     9: 	bra.s	ShowSelectionDialogScenery	; branch to next step
                            	    10: ShowSelectionDialogNPC:	; target object is an NPC
00:00002B84 4DF90001CA22    	    11: 	lea	NPCNameTable,a6	; point to default npc text table
                            	    12: ShowSelectionDialogScenery:
00:00002B8A DDC7            	    13: 	adda.l	d7,a6	; add offset
00:00002B8C 23D6FFFF022E    	    14: 	move.l	(a6),(MEM_DIALOG_TEXT)	; copy value at a6 to MEM_DIALOG_TEXT
                            	    15: 	; set dialog flags to display the dialog
00:00002B92 2E39FFFF0226    	    16: 	move.l	(MEM_DIALOG_FLAGS),d7	; copy current dialog state to d7
00:00002B98 08C7001A        	    17: 	bset.l	#DIALOG_FLAG_TEXT_OPENING,d7	; change state to opening
00:00002B9C 08C70015        	    18: 	bset.l	#DIALOG_FLAG_STYLE_MENU,d7	; set style to overworld menu
00:00002BA0 08C70019        	    19: 	bset.l	#DIALOG_FLAG_SELECTION_WAIT,d7	; set flag to wait for selection
00:00002BA4 23C7FFFF0226    	    20: 	move.l	d7,(MEM_DIALOG_FLAGS)	; save changes made to the game state
00:00002BAA 2E39FFFF0028    	    21: 	move.l	(MEM_GAME_STATE),d7	; copy current game state to d7
00:00002BB0 08C70003        	    22: 	bset.l	#STATE_FLAG_DIALOG,d7	; set the dialog bit
00:00002BB4 23C7FFFF0028    	    23: 	move.l	d7,(MEM_GAME_STATE) ; copy game state back to d7
00:00002BBA 33FC0000FFFF0222	    24: 	move.w	#$0000,(MEM_MENU_SELECTION)	; default to first menu selection
                            	    25: 	;---------------------------------------------------------------------------
                            	    26: 	; have the NPC face the player
                            	    27: 	;---------------------------------------------------------------------------
00:00002BC2 3E39FFFF0030    	    28: 	move.w (MEM_ACTION_TARGET_NPCID),d7	; copy NPC target ID to d7
00:00002BC8 0C47FFFF        	    29: 	cmpi.w	#$FFFF,d7	; test if it is -1
00:00002BCC 672C            	    30: 	beq.s	ExitShowSelectionDialog	; exit if -1
00:00002BCE 4DF9FFFF00D6    	    31: 	lea	MEM_NPC0_SPRITE_ID,a6	; point a6 to the first NPC sprite
00:00002BD4 3C39FFFF0030    	    32: 	move.w	(MEM_ACTION_TARGET_NPCID),d6	; copy target NPC id to d6
00:00002BDA CCFC001A        	    33: 	mulu.w	#NPC_RECORD_SIZE,d6	; multiply by NPC_RECORD_SIZE to get offset
00:00002BDE DDC6            	    34: 	adda.l	d6,a6	; move to target NPC sprite
                            	    35: 	; save current NPC direction
00:00002BE0 33EE0008FFFF0032	    36: 	move.w	(STRUCT_SPRITE_DIRECTION,a6),(MEM_ACTION_TARGET_NPC_DIRECTION)
                            	    37: 	; copy player direction to NPC direction
00:00002BE8 3D79FFFF00C40008	    38: 	move.w	(MEM_PLAYER_SPRITE_DIRECTION),(STRUCT_SPRITE_DIRECTION,a6)
                            	    39: 	; flip the last bit to reverse direction
00:00002BF0 0A6E00010008    	    40: 	eor.w	#$0001,(STRUCT_SPRITE_DIRECTION,a6)
00:00002BF6 6100ED8C        	    41: 	bsr.w	StopSprite	; stop moving the sprite
                            	    42: ExitShowSelectionDialog:
00:00002BFA 4E75            	    43: 	rts
                            	    44: 
                            	    45: 

Source: "inc_Subroutines.X68"
